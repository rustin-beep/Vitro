// gen_course —— 课程叙述层生成器（#120 课程内容管线，2026-10-15；#273 批二 .mts 化）。
//
// **【2026-10-15 退役标注】lessons.ts 渲染角色退役（#125 批 A 形态修正）**：
// 「资产链自举」判据（下游不装额外工具链能否再生资产）驳回 Go 进资产链
// ——本生成器原为 Go、且 HTML 预渲染进资产，两者均被判据排除。保留本体
// 作为**失败回退预案**（content.json 静态发射形态，宿主运行时方案
// （parser.c + demo 运行时喂引擎解析）失败时可用）；CI/pages 接线已摘。
// course_catalog（防线）不受影响继续在役。
//
// 真源 = course/<chap>/<id>/lesson.md（frontmatter + 正文，教师手写面）；
// 产物 = demo/src/data/lessons.ts（类型化 ESM，demo 侧按 id 与 cases.js /
// algorithms.js 课目集 join——本生成器不消费代码链，代码真源仍为
// cases.js 与 templates/*/source.c，「代码两份」病结构性排除）。
//
// 用法：
//
//	node scripts/gen_course/main.mts            // 再生 demo/src/data/lessons.ts
//	node scripts/gen_course/main.mts -check     // 只比对不落盘（不一致 exit 1）
//
// 契约（照 gen_diag 形态）：输出文件 @generated 首行；幂等（遍历字典序 +
// 确定性序列化，双次运行字节一致）；-check 不留副作用。
import fs from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";
import { fragment } from "../docs_preview/render.mts";

const rootDir = path.resolve(import.meta.dirname, "../..");
const courseDir = path.join(rootDir, "course");
const outPath = path.join(rootDir, "demo", "src", "data", "lessons.ts");

const headerNote = `// @generated by scripts/gen_course — 勿手改；真源 course/**/*.md，再生 node scripts/gen_course/main.mts
// 教学叙述层（#120 课程内容管线）：id = 课目键（cases 用例 id / 族 id / variant 模板名 / xlab id），
// demo 侧按 (kind,id) 与 cases.js + algorithms.js join；html = lesson.md 正文的构建期预渲染片段。
export interface LessonNote {
  id: string;
  kind: "case" | "algo" | "variant" | "xlab";
  chap: string;
  order: number;
  famId?: string;
  stdin?: string;
  html: string;
}
export const LESSON_NOTES: LessonNote[] = [
`;
const footerNote = "];\n";

interface Lesson {
  id: string;
  kind: string;
  chap: string;
  order: number;
  famId: string;
  stdin: string;
  html: string;
  dir: string;
}

function die(msg: string): never {
  console.error("[gen_course] " + msg);
  process.exit(1);
}

// parseFrontmatter 解析 --- 围栏内的 key: value 行（轻量形态，不支持嵌套结构）。
function parseFrontmatter(src: string): { fm: Map<string, string>; body: string } {
  const fm = new Map<string, string>();
  const s = src.replaceAll("\r\n", "\n");
  if (!s.startsWith("---\n")) throw new Error("缺 frontmatter 开栏（文件须以 --- 行开始）");
  const body = s.slice(4);
  const end = body.indexOf("\n---");
  if (end < 0) throw new Error("缺 frontmatter 收栏 ---");
  const lines = body.slice(0, end).split("\n");
  for (let i = 0; i < lines.length; i++) {
    const line = (lines[i] ?? "").trim();
    if (line === "" || line.startsWith("#")) continue;
    const cut = line.indexOf(":");
    if (cut < 0) throw new Error(`frontmatter 第 ${i + 1} 行非 key: value 形态: ${JSON.stringify(line)}`);
    const k = line.slice(0, cut).trim();
    let v = line.slice(cut + 1).trim();
    v = v.replace(/^['"]|['"]$/g, "");
    fm.set(k, v);
  }
  return { fm, body: body.slice(end + 4) };
}

function collect(): Lesson[] {
  const out: Lesson[] = [];
  const chaps = fs
    .readdirSync(courseDir, { withFileTypes: true })
    .filter((e) => e.isDirectory() && !e.name.startsWith("."))
    .map((e) => e.name)
    .sort();
  for (const chap of chaps) {
    const chapDir = path.join(courseDir, chap);
    const lessons = fs
      .readdirSync(chapDir, { withFileTypes: true })
      .filter((e) => e.isDirectory())
      .map((e) => e.name)
      .sort();
    for (const name of lessons) {
      const dir = path.join(chapDir, name);
      const mdPath = path.join(dir, "lesson.md");
      if (!fs.existsSync(mdPath)) continue; // 目录无 lesson.md 非错误（允许草稿目录）
      const src = fs.readFileSync(mdPath, "utf8");
      let parsed: { fm: Map<string, string>; body: string };
      try {
        parsed = parseFrontmatter(src);
      } catch (e) {
        throw new Error(`${mdPath}: ${e instanceof Error ? e.message : String(e)}`);
      }
      const les: Lesson = { id: "", kind: "", chap, order: 0, famId: "", stdin: "", html: fragment(parsed.body), dir };
      for (const [k, v] of parsed.fm) {
        switch (k) {
          case "id":
            les.id = v;
            break;
          case "kind":
            les.kind = v;
            break;
          case "order":
            les.order = Number.parseInt(v, 10) || 0;
            break;
          case "famId":
            les.famId = v;
            break;
          case "stdin":
            les.stdin = v;
            break;
          case "title":
            // 标题进叙述正文由 <h?> 承载；frontmatter title 仅作文档习惯保留
            break;
          default:
            throw new Error(`${mdPath}: 未知 frontmatter 字段 ${JSON.stringify(k)}（schema 见 gen_course 头注）`);
        }
      }
      if (les.id === "" || les.kind === "") throw new Error(`${mdPath}: id/kind 必填`);
      switch (les.kind) {
        case "case":
        case "algo":
        case "variant":
        case "xlab":
          break;
        default:
          throw new Error(`${mdPath}: kind ${JSON.stringify(les.kind)} 不在 case|algo|variant|xlab`);
      }
      if (les.kind === "variant" && les.famId === "") throw new Error(`${mdPath}: kind=variant 须带 famId`);
      if (les.order === 0) les.order = 999; // 缺省排章尾
      out.push(les);
    }
  }
  out.sort((a, b) => {
    if (a.chap !== b.chap) return a.chap < b.chap ? -1 : 1;
    if (a.order !== b.order) return a.order - b.order;
    return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
  });
  return out;
}

// goJSONString 复刻 Go json.Marshal 的字符串形态（HTML 三字符与 U+2028/U+2029
// 转义）——产物与旧 Go 生成器保持同一编码口径。
function goJSONString(s: string): string {
  return JSON.stringify(s).replace(/[<>&\u2028\u2029]/g, (c) => {
    switch (c) {
      case "<":
        return "\\u003c";
      case ">":
        return "\\u003e";
      case "&":
        return "\\u0026";
      case "\u2028":
        return "\\u2028";
      default:
        return "\\u2029";
    }
  });
}

function emit(lessons: Lesson[]): string {
  let out = headerNote;
  lessons.forEach((l, i) => {
    out += "  {\n";
    out += `    id: ${goJSONString(l.id)},\n`;
    out += `    kind: ${goJSONString(l.kind)},\n`;
    out += `    chap: ${goJSONString(l.chap)},\n`;
    out += `    order: ${l.order},\n`;
    if (l.famId !== "") out += `    famId: ${goJSONString(l.famId)},\n`;
    if (l.stdin !== "") out += `    stdin: ${goJSONString(l.stdin)},\n`;
    out += `    html: ${goJSONString(l.html)},\n`;
    out += "  }";
    if (i < lessons.length - 1) out += ",";
    out += "\n";
  });
  out += footerNote;
  return out;
}

export { collect, emit, parseFrontmatter };

function main(check: boolean): void {
  let lessons: Lesson[];
  try {
    lessons = collect();
  } catch (e) {
    die(e instanceof Error ? e.message : String(e));
  }
  const out = emit(lessons);

  if (check) {
    let existing: string;
    try {
      existing = fs.readFileSync(outPath, "utf8");
    } catch (e) {
      die(`-check: 生成物不可读（先跑一次再生）: ${String(e)}`);
    }
    if (existing !== out) {
      die("-check: demo/src/data/lessons.ts 与现算不一致（真源已改未再生）——跑 node scripts/gen_course/main.mts 再生后提交");
    }
    console.log(`[gen_course] -check OK：${lessons.length} 课叙述与生成物一致`);
    return;
  }
  fs.mkdirSync(path.dirname(outPath), { recursive: true });
  fs.writeFileSync(outPath, out);
  console.log(`[gen_course] 生成 ${outPath}（${lessons.length} 课叙述）`);
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) main(process.argv.slice(2).includes("-check"));
