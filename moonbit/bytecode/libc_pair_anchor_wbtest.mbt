///|
/// **Rust 源硬编码对拍锚**（P1-4 审阅修复：原断言 `index(all[i]) == 1000+i`
/// 由同一数组派生——同义反复，变异实测（memcpy/memmove 换位）不红。
/// 本锚把 Rust `bytecode_libc_index.rs` 的全部 88 个 (name, idx) 显式
/// 对硬编码：MoonBit 侧数组/派生规则任一漂移即红。源头：
/// native/crates/vitro_runtime/src/bytecode_libc_index.rs（源变须同步再生成）。
test "libc index: hardcoded 88 pairs from Rust source" {
  let pairs : Array[(String, Int)] = [
    ("isdigit", 1000),
    ("isalpha", 1001),
    ("islower", 1002),
    ("isupper", 1003),
    ("tolower", 1004),
    ("toupper", 1005),
    ("isspace", 1006),
    ("isalnum", 1007),
    ("isprint", 1008),
    ("iscntrl", 1009),
    ("isxdigit", 1010),
    ("abs", 1011),
    ("atoi", 1012),
    ("srand", 1013),
    ("rand", 1014),
    ("strlen", 1015),
    ("strcmp", 1016),
    ("strcpy", 1017),
    ("strcat", 1018),
    ("strncpy", 1019),
    ("memcpy", 1020),
    ("memmove", 1021),
    ("__vitro_force_instantiate_vitro_sort_int", 1022),
    ("__ctor__vitro_list_int", 1023),
    ("vitro_list_int__push_back", 1024),
    ("vitro_list_int__push_front", 1025),
    ("vitro_list_int__pop_back", 1026),
    ("vitro_list_int__size", 1027),
    ("vitro_list_int__front", 1028),
    ("vitro_list_int__back", 1029),
    ("vitro_list_int__pop_front", 1030),
    ("vitro_list_int__get", 1031),
    ("vitro_list_int__clear", 1032),
    ("__dtor__vitro_list_int", 1033),
    ("__ctor__vitro_string", 1034),
    ("vitro_string__push_back", 1035),
    ("vitro_string__pop_back", 1036),
    ("vitro_string__size", 1037),
    ("vitro_string__capacity", 1038),
    ("vitro_string__get", 1039),
    ("vitro_string__c_str", 1040),
    ("vitro_string__front", 1041),
    ("vitro_string__back", 1042),
    ("vitro_string__pop_front", 1043),
    ("vitro_string__clear", 1044),
    ("__dtor__vitro_string", 1045),
    ("__ctor__vitro_vec_int", 1046),
    ("vitro_vec_int__push_back", 1047),
    ("vitro_vec_int__pop_back", 1048),
    ("vitro_vec_int__size", 1049),
    ("vitro_vec_int__capacity", 1050),
    ("vitro_vec_int__front", 1051),
    ("vitro_vec_int__back", 1052),
    ("vitro_vec_int__pop_front", 1053),
    ("vitro_vec_int__get", 1054),
    ("vitro_vec_int__clear", 1055),
    ("__dtor__vitro_vec_int", 1056),
    ("__ctor__vitro_vec_float", 1057),
    ("vitro_vec_float__push_back", 1058),
    ("vitro_vec_float__pop_back", 1059),
    ("vitro_vec_float__size", 1060),
    ("vitro_vec_float__capacity", 1061),
    ("vitro_vec_float__front", 1062),
    ("vitro_vec_float__back", 1063),
    ("vitro_vec_float__pop_front", 1064),
    ("vitro_vec_float__get", 1065),
    ("vitro_vec_float__clear", 1066),
    ("__dtor__vitro_vec_float", 1067),
    ("__ctor__vitro_vec_char", 1068),
    ("vitro_vec_char__push_back", 1069),
    ("vitro_vec_char__pop_back", 1070),
    ("vitro_vec_char__size", 1071),
    ("vitro_vec_char__capacity", 1072),
    ("vitro_vec_char__front", 1073),
    ("vitro_vec_char__back", 1074),
    ("vitro_vec_char__pop_front", 1075),
    ("vitro_vec_char__get", 1076),
    ("vitro_vec_char__clear", 1077),
    ("__dtor__vitro_vec_char", 1078),
    ("__ctor__vitro_list_int__move", 1079),
    ("__ctor__vitro_list_node__int__move", 1080),
    ("__ctor__vitro_string__move", 1081),
    ("__ctor__vitro_vec_char__move", 1082),
    ("__ctor__vitro_vec_float__move", 1083),
    ("__ctor__vitro_vec_int__move", 1084),
    ("vitro_sort_int__int", 1085),
    ("vitro_sort_int_qsort__int", 1086),
    ("vitro_sort_int_swap__int", 1087),
  ]
  assert_eq(pairs.length(), 88)
  for pair in pairs {
    let got = bytecode_libc_index(pair.0)
    assert_eq(got, Some(pair.1))
  }
}
