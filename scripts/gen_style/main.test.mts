#!/usr/bin/env node
// gen_style 单测（四件套之一：node:test）。覆盖转义、确定性、产物等价与判红。
import { test } from "node:test";
import assert from "node:assert/strict";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { cssBody, digestOf, mbtStr, render, renderGolden, tupleLine, verify } from "./main.mts";
import { load } from "../gen_demo_tokens/main.mts";
import { projectRoot } from "../internal/capi.mts";

const MAIN = path.join(import.meta.dirname, "main.mts");

function run(args: string[]): { status: number | null; out: string } {
  const r = spawnSync(process.execPath, [MAIN, ...args], { encoding: "utf8" });
  return { status: r.status, out: `${r.stdout ?? ""}${r.stderr ?? ""}` };
}

function tmpDir(): string {
  return fs.mkdtempSync(path.join(os.tmpdir(), "gen-style-"));
}

test("mbtStr：引号 / 反斜杠 / 换行 / 控制字符按 MoonBit 字面量转义", () => {
  assert.equal(mbtStr("plain"), '"plain"');
  assert.equal(mbtStr('a"b'), '"a\\"b"');
  assert.equal(mbtStr("a\\b"), '"a\\\\b"');
  assert.equal(mbtStr("a\nb"), '"a\\nb"');
  assert.equal(mbtStr("\u0001"), '"\\u{1}"');
  assert.equal(mbtStr("中文"), '"中文"');
});

test("tupleLine：与 moon fmt 的 80 列阈值对齐（≤80 单行 / >80 折行）", () => {
  // 单行宽 = `  (` 3 + `"x"` 3 + `, ` 2 + `"` 1 + v + `"` 1 + `),` 2 = 12 + len(v)
  assert.equal(tupleLine("x", "a".repeat(68), "  ").includes("\n"), false);
  const folded = tupleLine("x", "a".repeat(69), "  ");
  assert.equal(folded.includes("\n"), true);
  assert.match(folded, /^ {2}\(\n {4}"x", "a/);
  assert.match(folded, /\n {2}\),$/);
});

test("render：确定性 + 结构锚（五包 / 基座 / 字号档 / digest）", () => {  const root = projectRoot();
  const src = path.join(root, "moonbit/style/tokens.json");
  const doc = load(src);
  const digest = digestOf(src);
  const a = render(doc, digest);
  const b = render(doc, digest);
  assert.equal(a, b, "同输入两次生成必须逐字节一致");
  assert.match(a, /@generated by scripts\/gen_style/);
  assert.match(a, new RegExp(`digest sha256:${digest}`));
  assert.match(a, /pub\(all\) struct StylePack \{/);
  for (const id of doc.themeOrder) {
    assert.ok(a.includes(`id: "${id}"`), `缺主题 ${id}`);
  }
  assert.match(a, /pub fn style_digest\(\) -> String \{/);
});

test("cssBody/renderGolden：正文去头部 + golden 确定性 + J9 篡改必红", () => {
  const root = projectRoot();
  const src = path.join(root, "moonbit/style/tokens.json");
  const doc = load(src);
  const digest = digestOf(src);
  const body = cssBody(doc);
  assert.match(body, /^:root \{/, "正文须从 base 块起（头部两行注释+空行已去掉）");
  assert.ok(!body.includes("@generated"), "正文不得含生成头");
  assert.equal(cssBody(doc), body, "同输入两次 cssBody 逐字节一致");
  const g1 = renderGolden(doc, digest);
  const g2 = renderGolden(doc, digest);
  assert.equal(g1, g2, "golden 确定性");
  assert.match(g1, /test "css_text_equals_tokens_css_body"/);
  assert.ok(g1.includes(`digest sha256:${digest}`));
  // J9：golden 里 CSS 值篡改必须被 verify 判红（判定面与自证面同一）
  const tampered = g1.replace("--vr-fs: 14px;", "--vr-fs: 99px;");
  assert.notEqual(tampered, g1, "注入点须存在");
  assert.notEqual(verify("golden", g1, tampered), null, "篡改 golden 必须判红");
});

test("真实真源：render ≡ 入库 style_gen.mbt（逐字节）", () => {
  const root = projectRoot();
  const src = path.join(root, "moonbit/style/tokens.json");
  const doc = load(src);
  const want = render(doc, digestOf(src));
  const got = fs.readFileSync(path.join(root, "moonbit/style/style_gen.mbt"), "utf8");
  assert.equal(want, got.replace(/\r\n/g, "\n"));
});

test("digest：绑定真源字节（内容变则 digest 变）", () => {
  const d = tmpDir();
  const a = path.join(d, "a.json");
  const b = path.join(d, "b.json");
  fs.writeFileSync(a, "{\"x\":1}\n");
  fs.writeFileSync(b, "{\"x\":2}\n");
  assert.equal(digestOf(a), digestOf(a));
  assert.notEqual(digestOf(a), digestOf(b));
});

test("verify：CRLF 假绿消除", () => {
  const want = "a\nb\n";
  assert.equal(verify("x", want, "a\r\nb\r\n"), null);
  assert.ok(verify("x", want, "a\nc\n") !== null);
});

test("-check：绿 → 篡改后红且不写盘", () => {
  const d = tmpDir();
  const src = path.join(d, "tokens.json");
  fs.copyFileSync(path.join(projectRoot(), "moonbit/style/tokens.json"), src);
  const out = path.join(d, "style_gen.mbt");
  const gen = run(["-src", src, "-mbt-out", out]);
  assert.equal(gen.status, 0, gen.out);
  const first = fs.readFileSync(out, "utf8");
  const ok = run(["-src", src, "-mbt-out", out, "-check"]);
  assert.equal(ok.status, 0, ok.out);
  fs.writeFileSync(out, first + "// tampered\n");
  const bad = run(["-src", src, "-mbt-out", out, "-check"]);
  assert.equal(bad.status, 1);
  assert.match(bad.out, /产物漂移/);
  assert.ok(fs.readFileSync(out, "utf8").includes("tampered"), "-check 不得写盘");
});

test("真实仓库：-check 绿 + -selftest 绿；未知参数 exit 2", () => {
  const ok = run(["-check"]);
  assert.equal(ok.status, 0, ok.out);
  const self = run(["-selftest"]);
  assert.equal(self.status, 0, self.out);
  assert.match(self.out, /篡改 --vr-fs → 两产物 verify 均判红且定位可见/);
  const bad = run(["--nope"]);
  assert.equal(bad.status, 2);
});
