#!/usr/bin/env node
// gen_view_projectors：ViewDoc v0.1.1 投影器词表双产物发射器
// （2026-11-14 批 D，refs #470 v0.1.1 / #517）。
//
// 真源：moonbit/view/projectors.json（引擎侧单源；序列条数 / 维度约束 /
// 已知选项键 / 默认投影器）。宿主只实现绘制，不各自定义语义 —— 这正是
// 「下沉视图、不下沉绘制」的落点：demo 与 MCP 消费同一张词表，避免
// 课程声明 `series re im -> polar` 在两端被理解成不同形状。
//
// 产物（均为 @generated，禁手改）：
//   moonbit/view/projectors_gen.mbt  —— 引擎侧 MoonBit 数据面（L0 零依赖）
//   demo/src/lib/projectors.ts       —— demo 侧 TS 词表（纯数据 + 查询）
//
// 与 scripts/gen_style 的分工：风格资源（StylePack）走 tokens.json →
// style_gen.mbt；投影器语义走本表 → 双产物。两者同样 -check / -selftest /
// digest 绑定 / CRLF 归一 / -check 零副作用。mbtStr 与 digestOf 直接复用
// gen_style，保证 MoonBit 字面量转义口径不分叉。
//
// 用法（仓库根）：
//   node scripts/gen_view_projectors/main.mts             # 生成两个产物
//   node scripts/gen_view_projectors/main.mts -check      # 比对（CI 形态）
//   node scripts/gen_view_projectors/main.mts -selftest   # J9 篡改证红
import fs from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../internal/capi.mts";
import { diffHint } from "../gen_demo_tokens/main.mts";
import { mbtStr, digestOf } from "../gen_style/main.mts";

export const GEN_PATH = "scripts/gen_view_projectors";
export const SRC_PATH = "moonbit/view/projectors.json";
export const MBT_PATH = "moonbit/view/projectors_gen.mbt";
export const TS_PATH = "demo/src/lib/projectors.ts";

const HEADER_MBT = `// @generated by ${GEN_PATH} —— 禁手改（真源 = ${SRC_PATH}）。`;
const HEADER_TS = `// @generated by ${GEN_PATH} —— 禁手改（真源 = ${SRC_PATH}）。`;

export interface ProjectorSpec {
  id: string;
  seriesMin: number;
  seriesMax: number;
  minDims: number;
  opts: string[];
  note: string;
}

export interface ProjectorsDoc {
  version: number;
  default: string;
  projectors: ProjectorSpec[];
}

function die(msg: string): never {
  process.stderr.write(`${GEN_PATH}: ${msg}\n`);
  process.exit(1);
}

const ID_RE = /^[a-z][a-z0-9_]*$/;
const TOP_KEYS = new Set(["version", "_comment", "default", "projectors"]);
const ITEM_KEYS = new Set(["id", "seriesMin", "seriesMax", "minDims", "opts", "note"]);

function isRecord(v: unknown): v is Record<string, unknown> {
  return typeof v === "object" && v !== null && !Array.isArray(v);
}

/** 校验失败一律抛（纯函数，负例可在测试进程内断言）；CLI 侧由 load 转成 die。 */
function bad(msg: string): never {
  throw new Error(`${GEN_PATH}: ${msg}`);
}

/** 真源完备性断言：未知字段直接红（防「加了字段但生成器没发射」的静默漂移）。
 *  纯函数：不读盘、不 exit——main.test.mts 直接喂对象断言负例。 */
export function parseDoc(raw: unknown): ProjectorsDoc {
  if (!isRecord(raw)) bad("真源顶层须为对象");
  for (const k of Object.keys(raw)) if (!TOP_KEYS.has(k)) bad(`真源未知顶层字段 ${JSON.stringify(k)}`);
  if (raw.version !== 1) bad(`真源版本须为 1，实得 ${JSON.stringify(raw.version)}`);
  const defaultId = typeof raw.default === "string" ? raw.default : "";
  if (!ID_RE.test(defaultId)) bad("真源 default 须为合法投影器 id");
  if (!Array.isArray(raw.projectors) || raw.projectors.length === 0) bad("真源 projectors 须为非空数组");

  const seen = new Set<string>();
  const out: ProjectorSpec[] = [];
  for (const [i, item] of raw.projectors.entries()) {
    if (!isRecord(item)) bad(`projectors[${i}] 须为对象`);
    for (const k of Object.keys(item)) if (!ITEM_KEYS.has(k)) bad(`projectors[${i}] 未知字段 ${JSON.stringify(k)}`);
    const id = item.id;
    if (typeof id !== "string" || !ID_RE.test(id)) bad(`projectors[${i}].id 非法: ${JSON.stringify(id)}`);
    if (seen.has(id)) bad(`投影器 id 重复: ${id}`);
    seen.add(id);
    const num = (k: string): number => {
      const v = item[k];
      if (typeof v !== "number" || !Number.isInteger(v)) bad(`${id}.${k} 须为整数`);
      return v;
    };
    const min = num("seriesMin");
    const max = num("seriesMax");
    const dims = num("minDims");
    if (min < 1) bad(`${id}.seriesMin 须 ≥1`);
    if (max !== -1 && (max < 1 || max < min)) bad(`${id}.seriesMax 须为 -1（不限）或 ≥seriesMin`);
    if (dims < 0) bad(`${id}.minDims 须 ≥0`);
    if (!Array.isArray(item.opts)) bad(`${id}.opts 须为数组`);
    const opts: string[] = [];
    for (const x of item.opts) {
      if (typeof x !== "string" || !ID_RE.test(x)) bad(`${id}.opts 键须为合法键名`);
      opts.push(x);
    }
    if (new Set(opts).size !== opts.length) bad(`${id}.opts 键重复`);
    const note = item.note;
    if (typeof note !== "string" || note.trim() === "") bad(`${id}.note 须非空`);
    out.push({ id, seriesMin: min, seriesMax: max, minDims: dims, opts, note });
  }
  if (!seen.has(defaultId)) bad(`真源 default=${JSON.stringify(defaultId)} 不在词表内`);
  out.sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
  return { version: 1, default: defaultId, projectors: out };
}

export function load(absSrc: string): ProjectorsDoc {
  let raw: unknown;
  try {
    raw = JSON.parse(fs.readFileSync(absSrc, "utf8"));
  } catch (e) {
    die(`读真源失败 ${absSrc}: ${e instanceof Error ? e.message : String(e)}`);
  }
  try {
    return parseDoc(raw);
  } catch (e) {
    die(e instanceof Error ? e.message : String(e));
  }
}

const tsStr = (s: string): string => JSON.stringify(s);

/** MoonBit 产物（moon fmt 稳定形态：结构字面量逐字段一行）。 */
export function renderMoonBit(doc: ProjectorsDoc, digest: string): string {
  const b: string[] = [];
  b.push(HEADER_MBT + "\n");
  b.push("// 投影器语义表：序列条数 / 维度约束 / 已知选项键；宿主只实现绘制。\n");
  b.push(`// digest sha256:${digest}\n\n`);
  b.push("///|\n");
  b.push("/// 投影器规格。series_max = -1 表示序列条数不限；min_dims > 1\n");
  b.push("/// 表示需要多维维度表（array_snapshots.dims，批 B additive 字段）。\n");
  b.push("/// 整数字段写 Int32（非 Int）：moon fmt 会把 Int 规范化为 Int32，\n");
  b.push("/// 生成器若写 Int，每轮 fmt 都会把 -check 打红（批 D 实测）。\n");
  b.push("pub(all) struct Projector {\n");
  b.push("  id : String\n");
  b.push("  series_min : Int32\n");
  b.push("  series_max : Int32\n");
  b.push("  min_dims : Int32\n");
  b.push("  opts : Array[String]\n");
  b.push("  note : String\n");
  b.push("}\n\n");
  b.push("///|\n");
  b.push("/// 全族（按 id 字节序）。\n");
  b.push("let projector_table : Array[Projector] = [\n");
  for (const p of doc.projectors) {
    b.push("  {\n");
    b.push(`    id: ${mbtStr(p.id)},\n`);
    b.push(`    series_min: ${p.seriesMin},\n`);
    b.push(`    series_max: ${p.seriesMax},\n`);
    b.push(`    min_dims: ${p.minDims},\n`);
    b.push(`    opts: [${p.opts.map(mbtStr).join(", ")}],\n`);
    b.push(`    note: ${mbtStr(p.note)},\n`);
    b.push("  },\n");
  }
  b.push("]\n\n");
  b.push("///|\n");
  b.push("/// 全族（只读；调用方不得改表）。\n");
  b.push("pub fn projectors() -> Array[Projector] {\n  projector_table\n}\n\n");
  b.push("///|\n");
  b.push("/// 课程未声明 viz 时宿主回退的投影器。\n");
  b.push(`pub fn default_projector() -> String {\n  ${mbtStr(doc.default)}\n}\n\n`);
  b.push("///|\n");
  b.push("/// 真源 digest（projectors.json 字节的 sha256；两产物同源凭证）。\n");
  b.push(`pub fn projector_digest() -> String {\n  "sha256:${digest}"\n}\n`);
  return b.join("");
}

/** TS 产物（纯数据 + 查询；校验逻辑在手写面 viewProjection.ts）。 */
export function renderTs(doc: ProjectorsDoc, digest: string): string {
  const b: string[] = [];
  b.push(HEADER_TS + "\n");
  b.push("// 与 moonbit/view/projectors_gen.mbt 同源同值；宿主按 id 实现绘制。\n");
  b.push(`// digest sha256:${digest}\n\n`);
  b.push("export interface ProjectorSpec {\n");
  b.push("  readonly id: string;\n");
  b.push("  readonly seriesMin: number;\n");
  b.push("  /** -1 = 序列条数不限。 */\n");
  b.push("  readonly seriesMax: number;\n");
  b.push("  /** >1 表示需要 array_snapshots.dims 维度表。 */\n");
  b.push("  readonly minDims: number;\n");
  b.push("  readonly opts: readonly string[];\n");
  b.push("  readonly note: string;\n");
  b.push("}\n\n");
  b.push(`export type ProjectorId = ${doc.projectors.map((p) => tsStr(p.id)).join(" | ")};\n\n`);
  b.push(`export const PROJECTOR_DIGEST = ${tsStr(`sha256:${digest}`)} as const;\n`);
  b.push(`export const DEFAULT_PROJECTOR: ProjectorId = ${tsStr(doc.default)};\n\n`);
  b.push("export const PROJECTORS: readonly ProjectorSpec[] = [\n");
  for (const p of doc.projectors) {
    b.push("  {\n");
    b.push(`    id: ${tsStr(p.id)},\n`);
    b.push(`    seriesMin: ${p.seriesMin},\n`);
    b.push(`    seriesMax: ${p.seriesMax},\n`);
    b.push(`    minDims: ${p.minDims},\n`);
    b.push(`    opts: [${p.opts.map(tsStr).join(", ")}],\n`);
    b.push(`    note: ${tsStr(p.note)},\n`);
    b.push("  },\n");
  }
  b.push("] as const;\n\n");
  b.push("export function projectorSpec(id: string): ProjectorSpec | undefined {\n");
  b.push("  return PROJECTORS.find((p) => p.id === id);\n");
  b.push("}\n");
  return b.join("");
}

/** -check 的唯一判定点；-selftest 直接调用它证红。 */
export function verify(out: string, want: string, got: string): Error | null {
  const norm = got.replace(/\r\n/g, "\n");
  if (norm === want) return null;
  return new Error(`${GEN_PATH}: 产物漂移 ${out} ← 真源 ${SRC_PATH}\n${diffHint(want, norm)}`);
}

export function check(doc: ProjectorsDoc, digest: string, mbtOut: string, tsOut: string): void {
  for (const [out, want] of [
    [mbtOut, renderMoonBit(doc, digest)],
    [tsOut, renderTs(doc, digest)],
  ] as const) {
    // 同 gen_demo_tokens / gen_style：spawn 从任意 cwd 调用时产物按项目根解析。
    const absOut = path.isAbsolute(out) ? out : path.join(projectRoot(), out);
    let raw: string;
    try {
      raw = fs.readFileSync(absOut, "utf8");
    } catch (e) {
      die(`-check 读产物失败 ${out}: ${e instanceof Error ? e.message : String(e)}（先跑一次生成）`);
    }
    const err = verify(out, want, raw);
    if (err) die(err.message);
    if (!raw.includes(`digest sha256:${digest}`)) {
      die(`-check digest 不符：真源已变但产物未重生成（${out}）`);
    }
  }
  process.stdout.write(`${GEN_PATH}: -check 通过（mbt + ts 双产物 ≡ ${SRC_PATH}）\n`);
}

/** J9：两个产物各注入一处篡改，必须双双判红（判定面与自证面同一）。 */
export function selftest(doc: ProjectorsDoc, digest: string, mbtOut: string, tsOut: string): void {
  const samples: [string, string, string][] = [
    [mbtOut, renderMoonBit(doc, digest), '    series_min: 1,'],
    [tsOut, renderTs(doc, digest), "    seriesMin: 1,"],
  ];
  for (const [out, want, needle] of samples) {
    if (verify(out, want, want) !== null) die(`-selftest 同集应绿却判红: ${out}`);
    const tampered = want.replace(needle, needle.replace("1", "9"));
    if (tampered === want) die(`-selftest 注入点失效: ${out} / ${needle}`);
    const err = verify(out, want, tampered);
    if (err === null) die(`-selftest 篡改应红却判绿: ${out}`);
  }
  process.stdout.write(`${GEN_PATH}: -selftest 通过（mbt + ts 同集绿 / 篡改 seriesMin 双双判红）\n`);
}

export function main(argv: string[]): number {
  let checkMode = false;
  let selftestMode = false;
  let src = SRC_PATH;
  let mbtOut = MBT_PATH;
  let tsOut = TS_PATH;
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i] ?? "";
    const eq = a.indexOf("=");
    const flag = eq >= 0 ? a.slice(0, eq) : a;
    const val = (): string => {
      const v = eq >= 0 ? a.slice(eq + 1) : argv[++i];
      if (v === undefined) {
        process.stderr.write(`${GEN_PATH}: ${flag} 缺值\n`);
        process.exit(2);
      }
      return v;
    };
    if (flag === "-check" || flag === "--check") {
      if (eq >= 0) return 2;
      checkMode = true;
    } else if (flag === "-selftest" || flag === "--selftest") {
      if (eq >= 0) return 2;
      selftestMode = true;
    } else if (flag === "-src" || flag === "--src") src = val();
    else if (flag === "-mbt-out" || flag === "--mbt-out") mbtOut = val();
    else if (flag === "-ts-out" || flag === "--ts-out") tsOut = val();
    else {
      process.stderr.write(`${GEN_PATH}: 未知参数 ${JSON.stringify(a)}\n`);
      return 2;
    }
  }
  const root = projectRoot();
  const absSrc = path.isAbsolute(src) ? src : path.join(root, src);
  const absMbtOut = path.isAbsolute(mbtOut) ? mbtOut : path.join(root, mbtOut);
  const absTsOut = path.isAbsolute(tsOut) ? tsOut : path.join(root, tsOut);
  const doc = load(absSrc);
  const digest = digestOf(absSrc);
  if (selftestMode) {
    selftest(doc, digest, mbtOut, tsOut);
    return 0;
  }
  if (checkMode) {
    check(doc, digest, mbtOut, tsOut);
    return 0;
  }
  fs.writeFileSync(absMbtOut, renderMoonBit(doc, digest));
  fs.writeFileSync(absTsOut, renderTs(doc, digest));
  process.stdout.write(
    `${GEN_PATH}: 已生成 ${mbtOut} + ${tsOut}（${doc.projectors.length} 投影器 / 默认 ${doc.default}）\n`,
  );
  return 0;
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  process.exit(main(process.argv.slice(2)));
}
