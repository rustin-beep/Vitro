#!/usr/bin/env node
// gen_diagnostics.mts —— 生成 vitro/engine/diagnostics 包的数据层四件
//（A3 fix 载荷 / A4+A5 概念图 / A6 误区模式 / A7 学习路径）。
// #273 存量 Go 重写批；原 scripts/moonbit/gen_diagnostics/gen_diagnostics.go。
//
// #39 真值源迁移（2026-10-05）：输入已从 Rust 冻结区 .rs 翻转为
// scripts/moonbit/diagnostics_data/ 四 JSON 单源。
//
// **不迁范围（约 850 行，2026-10-23 裁定）**：原 Go 版的 legacy 对账臂
//（legacyReconcile + 11 个结构签名函数）与 20 个 .rs 解析器
//（parseGenerateFix / balancedBlock / splitArms / parseFixTuple / litString /
// scanRustString / parseKnowledgeGraph / parseMisconception / parseLearningPath /
// intVecField / rustFrom* / mustIntField 等）全部依赖
// `../native/src/diagnostics/*.rs`——该区已于 2026-10-05 工序④物理删除，Go 版
// 每次运行只走到「legacy 四源全不存在 → 豁免」。CI 只看退出码，无断言依赖该行
// 输出（与 gen_diag 同批裁定，证据 = gen_diagnostics.go:196 三态判据 + CI 调用面）。
//
// 契约（同 gen_diag）：
//   - fail loud：装载失配 / 基线计数漂移立即 exit 1，禁静默 default；
//   - 幂等：四 JSON（行尾归一）联合 sha256 前 8 位随产物落款——JSON 变则产物变；
//   - 数据/机制分列（勘察 §2.0 A3 判据）：generate_fix 的**动态五码**
//     （1004/3035/3041/3050/3069）不入表，由机制层 fix_gen.mbt 手写照搬；JSON 侧
//     动态码集合与白名单双向对账——增删动态码立即红。
//
// 产物（moonbit 相对）：diagnostics/{fix_payloads,concepts,patterns,paths}_gen.mbt
//
// 用法：node scripts/moonbit/gen_diagnostics/main.mts [-check] [-json D] [-out D]
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../../internal/capi.mts";
import { emitWithMoonFmt, makeFail, parseFlags } from "../../internal/genio.mts";
import { goFormatFloat, goIntSlice } from "../../internal/gofmt.mts";

// ---- 基线（对源实测 2026-10-02；源冻结期漂移即红，人工核对后更新并登记） ----
const EXPECTED_STATIC_CODES = 26; // 静态载荷码数（3060|3061 双码展开计 2；#96 +3073）
const EXPECTED_NODES = 25;
const EXPECTED_EDGES = 25;
const EXPECTED_MAP_ENTRIES = 29; // 病 19 连坐（#61）
const EXPECTED_PATTERNS = 6;
const EXPECTED_PATHS = 6;

/** 动态码白名单（机制层 fix_gen.mbt 手写照搬——集合漂移即红）。 */
const DYNAMIC_CODE_WHITELIST = new Set([1004, 3035, 3041, 3050, 3069]);

interface FixEntry {
  code: number;
  suggestion: string;
  fix_kind: number;
  anchor: string;
  text: string;
}
interface NodeEntry {
  id: string;
  domain: string;
  title: string;
  description: string;
  difficulty: number;
  related_card_ids: string[];
}
interface EdgeEntry {
  from: string;
  to: string;
  relation: string;
  strength: number;
}
interface MapEntry {
  code: number;
  concepts: string[];
}
interface PatternEntry {
  id: string;
  name: string;
  description: string;
  error_codes: number[];
  min_occurrences: number;
  time_window: number;
}
interface StepEntry {
  step_type: string;
  title: string;
  detail: string;
  target_id: string;
  highlight_lines: number[];
}
interface PathEntry {
  id: string;
  estimated_time_minutes: number;
  steps: StepEntry[];
}

const fatal = makeFail("gen_diagnostics: FAIL: ", 1);

/** 行尾归一（latin1 往返，字节保真）。 */
function toLF(b: Buffer): Buffer {
  return Buffer.from(b.toString("latin1").replace(/\r\n/g, "\n"), "latin1");
}

function unmarshalDoc<T>(raw: Buffer, what: string): T {
  try {
    return JSON.parse(raw.toString("utf8")) as T;
  } catch (e) {
    return fatal(`${what} 解析失败: ${(e as Error).message}`);
  }
}

interface FixDoc {
  source_sha: string;
  entries: FixEntry[];
  dynamic_codes: number[];
}
interface ConceptsDoc {
  source_sha: string;
  nodes: NodeEntry[];
  edges: EdgeEntry[];
  error_concept_map: MapEntry[];
}
interface PatternsDoc {
  source_sha: string;
  patterns: PatternEntry[];
}
interface PathsDoc {
  source_sha: string;
  paths: PathEntry[];
}

function loadFixDoc(raw: Buffer): { fixes: FixEntry[]; dynamic: Set<number> } {
  const d = unmarshalDoc<FixDoc>(raw, "fix_payloads.json");
  return { fixes: d.entries ?? [], dynamic: new Set(d.dynamic_codes ?? []) };
}

function loadConceptsDoc(raw: Buffer): {
  nodes: NodeEntry[];
  edges: EdgeEntry[];
  conceptMap: MapEntry[];
} {
  const d = unmarshalDoc<ConceptsDoc>(raw, "concepts.json");
  return { nodes: d.nodes ?? [], edges: d.edges ?? [], conceptMap: d.error_concept_map ?? [] };
}

/** 按 MoonBit 字符串字面量规则转义。 */
export function escapeMbt(s: string): string {
  let out = "";
  for (const ch of s) {
    if (ch === "\\") out += "\\\\";
    else if (ch === '"') out += '\\"';
    else if (ch === "\n") out += "\\n";
    else if (ch === "\t") out += "\\t";
    else if (ch === "\r") out += "\\r";
    else out += ch;
  }
  return out;
}

const GEN_BANNER =
  "// @generated by scripts/moonbit/gen_diagnostics —— 禁手改（git/diff 工具链按 @generated 识别；再生成：cd 仓库根 && go run ./scripts/moonbit/gen_diagnostics）。\n" +
  "// 源：scripts/moonbit/diagnostics_data/ 四 JSON 真源（#39 迁出冻结区 2026-10-05；联合 sha256/%s，行尾归一）。\n" +
  "// legacy：Rust oracle 四 .rs 结构对账至工序④删区（值级文案为修复批合法演化面，不比）。\n";

function banner(srcHash: string): string {
  return GEN_BANNER.replace("%s", srcHash);
}

export function renderFixPayloads(
  fixes: FixEntry[],
  dynamic: Set<number>,
  srcHash: string,
): string {
  let b = banner(srcHash);
  const dyn = [...dynamic].sort((x, y) => x - y);
  b += `// 基线：静态载荷 ${fixes.length} 码（漂移时本脚本 fail loud）；动态码 ${goIntSlice(dyn)} 不入表（机制层 fix_gen.mbt 照搬——勘察 A3 拆分）。\n\n`;
  b +=
    "///|\n/// 静态修复载荷表查询（generate_fix 的纯静态码子集；无下划线外的\n" +
    "/// 兜底——未知码 None，机制层随后查动态五码）。\n" +
    "pub fn fix_payload(code : Int) -> FixPayload? {\n  match code {\n";
  for (const e of fixes) {
    const anchor = e.anchor === "LineEnd" ? "LineEnd" : "Manual";
    b +=
      `    ${e.code} =>\n` +
      "      Some(\n" +
      "        FixPayload::{\n" +
      `          suggestion: "${escapeMbt(e.suggestion)}",\n` +
      `          fix_kind: ${e.fix_kind},\n` +
      `          anchor: ${anchor},\n` +
      `          text: "${escapeMbt(e.text)}",\n` +
      "        },\n" +
      "      )\n";
  }
  b += "    _ => None\n  }\n}\n";
  return b;
}

export function renderConcepts(
  nodes: NodeEntry[],
  edges: EdgeEntry[],
  conceptMap: MapEntry[],
  srcHash: string,
): string {
  let b = banner(srcHash);
  b += `// 基线：节点 ${nodes.length} / 边 ${edges.length} / 错误码映射 ${conceptMap.length}（漂移时本脚本 fail loud）。\n`;
  b +=
    "// 分叉登记：3020→Recursion 系 oracle 存量语义错（勘察 ⑥-5），照搬不修——\n" +
    "// 修复走差异台账两侧同修批。\n\n";

  b += "///|\n/// 概念节点全集（源声明序）。\npub fn concept_nodes() -> Array[ConceptNode] {\n  [\n";
  for (const n of nodes) {
    const cards = (n.related_card_ids ?? []).map((c) => `"${escapeMbt(c)}"`).join(", ");
    b +=
      "    ConceptNode::{\n" +
      `      id: "${escapeMbt(n.id)}",\n` +
      `      domain: "${escapeMbt(n.domain)}",\n` +
      `      title: "${escapeMbt(n.title)}",\n` +
      `      description: "${escapeMbt(n.description)}",\n` +
      `      difficulty: ${n.difficulty},\n` +
      `      related_card_ids: [${cards}],\n` +
      "    },\n";
  }
  b += "  ]\n}\n\n";

  b += "///|\n/// 概念边全集（源声明序——DFS 前置路径的遍历序依赖此序）。\npub fn concept_edges() -> Array[ConceptEdge] {\n  [\n";
  for (const e of edges) {
    b +=
      "    ConceptEdge::{\n" +
      `      from_id: "${escapeMbt(e.from)}",\n` +
      `      to_id: "${escapeMbt(e.to)}",\n` +
      `      relation: "${escapeMbt(e.relation)}",\n` +
      `      strength: ${goFormatFloat(e.strength)},\n` +
      "    },\n";
  }
  b += "  ]\n}\n\n";

  b += "///|\n/// 错误码 → 概念 id 列表（源 insert 序；LinkedHashMap 语义同源）。\npub fn error_concept_map() -> Map[Int, Array[String]] {\n  let m : Map[Int, Array[String]] = Map([])\n";
  for (const me of conceptMap) {
    const cs = (me.concepts ?? []).map((c) => `"${escapeMbt(c)}"`).join(", ");
    b += `  m.set(${me.code}, [${cs}])\n`;
  }
  b += "  m\n}\n";
  return b;
}

export function renderPatterns(patterns: PatternEntry[], srcHash: string): string {
  let b = banner(srcHash);
  b += `// 基线：误区模式 ${patterns.length} 条（漂移时本脚本 fail loud）。M05 的 trap 关键词\n// 匹配是机制（misconception.mbt），表内 error_codes 为空即其标记。\n\n`;
  b +=
    "///|\n/// 预置误区模式全集（源声明序）。\npub fn default_patterns() -> Array[MisconceptionPattern] {\n  [\n";
  for (const p of patterns) {
    const codes = (p.error_codes ?? []).map((c) => String(c)).join(", ");
    b +=
      "    MisconceptionPattern::{\n" +
      `      id: "${escapeMbt(p.id)}",\n` +
      `      name: "${escapeMbt(p.name)}",\n` +
      `      description: "${escapeMbt(p.description)}",\n` +
      `      error_codes: [${codes}],\n` +
      `      min_occurrences: ${p.min_occurrences},\n` +
      `      time_window: ${p.time_window},\n` +
      "    },\n";
  }
  b += "  ]\n}\n";
  return b;
}

export function renderPaths(paths: PathEntry[], srcHash: string): string {
  let b = banner(srcHash);
  b += `// 基线：学习路径 ${paths.length} 条（漂移时本脚本 fail loud）。target_misconception_\n// id/name 运行时由检出误区带过（Rust d.pattern_id.clone() 同义），不冗余入表。\n// 分叉登记：target_id 悬空引用（勘察 ③-D5）照搬不修。\n\n`;
  b +=
    "///|\n/// 预置学习路径表（key = 误区模式 id，M01..M06）。\npub fn default_paths() -> Map[String, LearningPath] {\n  let m : Map[String, LearningPath] = Map([])\n";
  for (const p of paths) {
    b +=
      "  m.set(\n" +
      `    "${escapeMbt(p.id)}",\n` +
      "    LearningPath::{\n" +
      `      target_misconception_id: "${escapeMbt(p.id)}",\n` +
      '      target_misconception_name: "",\n' +
      `      estimated_time_minutes: ${p.estimated_time_minutes},\n` +
      "      steps: [\n";
    for (const s of p.steps ?? []) {
      const hl = (s.highlight_lines ?? []).map((v) => String(v)).join(", ");
      b +=
        "        PathStep::{\n" +
        `          step_type: "${escapeMbt(s.step_type)}",\n` +
        `          title: "${escapeMbt(s.title)}",\n` +
        `          detail: "${escapeMbt(s.detail)}",\n` +
        `          target_id: "${escapeMbt(s.target_id)}",\n` +
        `          highlight_lines: [${hl}],\n` +
        "        },\n";
    }
    b += "      ],\n    },\n  )\n";
  }
  b += "  m\n}\n";
  return b;
}

function main(): void {
  const root = projectRoot();
  const moonbit = path.join(root, "moonbit");

  const args = parseFlags(
    process.argv.slice(2),
    { bool: ["-check", "--check"], value: ["-json", "-out"] },
    fatal,
  );
  if (args.rest.length > 0) fatal(`未知参数 ${args.rest[0] ?? ""}`);
  const check = args.has("-check", "--check");

  let jsonDir = path.join(root, "scripts/moonbit/diagnostics_data");
  const jsonArg = args.value("-json");
  if (jsonArg !== undefined) jsonDir = path.resolve(moonbit, jsonArg);

  let outDir = path.join(moonbit, "diagnostics");
  const outArg = args.value("-out");
  if (outArg !== undefined) outDir = path.resolve(moonbit, outArg);

  // ---- ① 装载 JSON 真源（固定顺序参与联合 sha——顺序变更即产物落款变更） ----
  const jsonFiles = ["fix_payloads.json", "concepts.json", "patterns.json", "paths.json"];
  const h = crypto.createHash("sha256");
  const jsonRaws: Buffer[] = [];
  for (const f of jsonFiles) {
    let b: Buffer;
    try {
      b = fs.readFileSync(path.join(jsonDir, f));
    } catch (e) {
      return fatal(`读 JSON 真源失败 ${f}: ${(e as Error).message}`);
    }
    b = toLF(b);
    jsonRaws.push(b);
    h.update(b);
  }
  const srcHash = h.digest("hex").slice(0, 8);

  const { fixes, dynamic } = loadFixDoc(jsonRaws[0] as Buffer);
  const { nodes, edges, conceptMap } = loadConceptsDoc(jsonRaws[1] as Buffer);
  const patterns = unmarshalDoc<PatternsDoc>(jsonRaws[2] as Buffer, "patterns.json").patterns ?? [];
  const paths = unmarshalDoc<PathsDoc>(jsonRaws[3] as Buffer, "paths.json").paths ?? [];

  // ---- ② 基线校验（数据面守恒——JSON 侧同受基线闸约束） ----
  if (fixes.length !== EXPECTED_STATIC_CODES) {
    fatal(
      `静态载荷码数 ${fixes.length} ≠ 基线 ${EXPECTED_STATIC_CODES}——JSON 真源已变更，请人工核对后更新 EXPECTED_STATIC_CODES 并登记差异`,
    );
  }
  if (dynamic.size !== DYNAMIC_CODE_WHITELIST.size) {
    fatal(
      `动态码集合 ${goIntSlice([...dynamic].sort((a, b) => a - b))} 与白名单基数 ${DYNAMIC_CODE_WHITELIST.size} 不符——JSON 真源新增/减少了机制码`,
    );
  }
  for (const c of dynamic) {
    if (!DYNAMIC_CODE_WHITELIST.has(c)) {
      fatal(`码 ${c} 不在动态白名单 {1004,3035,3041,3050,3069}——新形态臂出现，请先裁定其数据/机制归属`);
    }
  }
  if (
    nodes.length !== EXPECTED_NODES ||
    edges.length !== EXPECTED_EDGES ||
    conceptMap.length !== EXPECTED_MAP_ENTRIES
  ) {
    fatal(
      `概念图基线漂移：nodes ${nodes.length}/${EXPECTED_NODES} edges ${edges.length}/${EXPECTED_EDGES} map ${conceptMap.length}/${EXPECTED_MAP_ENTRIES}`,
    );
  }
  if (patterns.length !== EXPECTED_PATTERNS) {
    fatal(`误区模式数 ${patterns.length} ≠ 基线 ${EXPECTED_PATTERNS}`);
  }
  if (paths.length !== EXPECTED_PATHS) {
    fatal(`学习路径数 ${paths.length} ≠ 基线 ${EXPECTED_PATHS}`);
  }

  // ---- ③ 渲染 .mbt 产物 + 幂等校验 ----
  emitWithMoonFmt({
    root,
    check,
    fail: fatal,
    driftHint: "源已变更未再生成（cd 仓库根 && node scripts/moonbit/gen_diagnostics/main.mts）",
    products: [
      { rel: path.relative(moonbit, path.join(outDir, "fix_payloads_gen.mbt")), content: renderFixPayloads(fixes, dynamic, srcHash) },
      { rel: path.relative(moonbit, path.join(outDir, "concepts_gen.mbt")), content: renderConcepts(nodes, edges, conceptMap, srcHash) },
      { rel: path.relative(moonbit, path.join(outDir, "patterns_gen.mbt")), content: renderPatterns(patterns, srcHash) },
      { rel: path.relative(moonbit, path.join(outDir, "paths_gen.mbt")), content: renderPaths(paths, srcHash) },
    ],
  });

  if (check) {
    process.stdout.write("gen_diagnostics: check OK（.mbt 4 件未漂移）\n");
  } else {
    process.stdout.write("gen_diagnostics: 生成完成（.mbt 4）\n");
  }
}

// 入口守卫：被 node:test import 时只取纯函数，不落盘
if (
  process.argv[1] !== undefined &&
  pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url
) {
  main();
}
