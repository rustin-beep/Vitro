///|
/// Bytecode Libc 固定索引（S5）——Rust `vitro_runtime::bytecode_libc_index`
/// （AUTO-GENERATED by scripts/precompile_bytecode_libc）的照搬。
///
/// **索引派生规则（本包单源表述）**：Rust 侧是 88 条显式 match 臂，臂序与
/// `BYTECODE_LIBC_ALL_FUNCS` 数组序一致、索引自 1000 连续递增无空洞
/// （isdigit=1000 … vitro_sort_int_swap__int=1087）。本包以数组为唯一
/// 数据源，索引 = `BASE_INDEX + 数组下标` 派生。
///
/// **锚的诚实声明（2026-09-21 审阅变异测试勘误）**：本文件内的全表断言
/// `index(all[i]) == 1000 + i` 由同一数组派生——**同义反复，换位不红**
/// （变异实测）。真锚有二：① `libc_pair_anchor_wbtest.mbt` 的 **Rust 源
/// 88 对硬编码对账**（数组/派生规则漂移即红）；② codegen_diff A 级对拍
/// （预注册索引进 func_index 产物面）。
///
/// **索引值不是稳定 ABI**（勘察 §8.2 三冻第三条）：目录更名曾致整体 +1
/// 漂移；对拍比对建议按"名字→索引"映射而非裸数值。strcpy/strcat 在
/// codegen 侧的分发例外（回 Host 路径带 E3070 栈缓冲区检测）见
/// `codegen` 包 `with_mode`。

/// 预编译产物指令条数（`bytecode_libc_data.json` code 段长度）——S6 libc
/// 自举消费（加载产物校验 code 段长度），当前包内无读点属预期。
const BYTECODE_LIBC_CODE_LEN : Int = 3485

/// 固定索引段基址。
pub const BYTECODE_LIBC_BASE_INDEX : Int = 1000

/// 用户侧全局区预留（用户全局变量自此之后分配；library mode 自 0 起算）。
pub const BYTECODE_LIBC_GLOBALS_RESERVED : UInt = 1024

/// 函数总数。
pub const BYTECODE_LIBC_FUNC_COUNT : Int = 88

/// Bytecode Libc 全部函数名（序 = 固定索引序）。并非所有函数都默认走
/// Bytecode 路径（strcpy/strcat 分发回 Host——E3070 检测），实际路径由
/// 执行侧控制。
pub let bytecode_libc_all_funcs : Array[String] = [
  "isdigit",
  "isalpha",
  "islower",
  "isupper",
  "tolower",
  "toupper",
  "isspace",
  "isalnum",
  "isprint",
