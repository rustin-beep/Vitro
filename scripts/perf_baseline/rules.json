{
  "schema": 1,
  "corpus_root": "native/tests/cases",
  "corpora": ["baseline", "knr", "leetcode", "gap"],
  "rounds": 5,
  "timeout_sec": 180,
  "moon_cmd_root": "moonbit/_build/native/release/build/cmd",
  "moon_source_root": "moonbit",
  "rust_cli": "native/target/release/vitro_cli.exe",
  "dump_tools": [
    { "id": "dump_tokens", "extra_args": ["both"] },
    { "id": "dump_ast", "extra_args": [] },
    { "id": "dump_typeck", "extra_args": [] },
    { "id": "dump_compile", "extra_args": [] }
  ],
  "out_root": "tmp/perf_baseline",
  "report_path": "reports/perf_baseline.md",
  "launch_reps": 12,
  "compare": {
    "corpus": "baseline",
    "moon_tool": "dump_compile",
    "rust_verb": "dump-compile"
  },
  "ab": {
    "corpus": "baseline",
    "rounds": 5,
    "tools": ["dump_tokens", "dump_ast", "dump_typeck", "dump_compile"]
  }
}
