    "abs" => Some(HOST_ABS)
    "isdigit" => Some(HOST_ISDIGIT)
    "isalpha" => Some(HOST_ISALPHA)
    "islower" => Some(HOST_ISLOWER)
    "isupper" => Some(HOST_ISUPPER)
    "tolower" => Some(HOST_TOLOWER)
    "toupper" => Some(HOST_TOUPPER)
    "isspace" => Some(HOST_ISSPACE)
    "isalnum" => Some(HOST_ISALNUM)
    "isprint" => Some(HOST_ISPRINT)
    "iscntrl" => Some(HOST_ISCNTRL)
