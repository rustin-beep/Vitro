// cmd/lib/cli：CLI 子命令逻辑单包（#37 批②③——`vitro <cmd>` 总入口与
// 各薄壳共享的库层；**函数名 = 命令名 = 协议方法名**三对齐：cli.run /
// cli.compile / cli.step）。单包而非三包的理由：①薄壳目录与 lib 包默认
// 别名撞名（moon.pkg 无 as 语法——surface 闸实锤）；②escape_json 等
// 共享函数单源（三包形态需三份复制连坐）。main 包 import warning 态的
// 下沉纪律见各薄壳注释。
import {
  "vitro/engine/bytecode",
  "vitro/engine/codegen",
  "vitro/engine/fs",
  "vitro/engine/gateway",
  "vitro/engine/host",
  "vitro/engine/lexer",
  "vitro/engine/lexer/token",
  "vitro/engine/parser",
  "vitro/engine/typeck",
  "vitro/engine/vm",
}

supported_targets = "native"
