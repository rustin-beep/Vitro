// S7 批五号：cmd/serve = native stdio 壳（协议层在 vitro/engine/gateway；
// cmd 层 pkg_deps 豁免方向）。帧语义/方法表/豁免面见 gateway 与
// scripts/serve_smoke/moonbit_exemptions.json。
import {
  "moonbitlang/core/encoding/utf8",
  "vitro/engine/gateway",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
  "native-stub": [ "serve_stdio.c" ],
)
