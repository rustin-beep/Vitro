#!/usr/bin/env node
// gen_host_route：S6 host 路由表生成器（#273 存量 Go 重写批）。
//
// 产物（bytecode 包）：host_func_id_gen.mbt（N 常量 + PURE 表 + by_user_name
// 逐对）+ host_route_anchor_wbtest.mbt（硬编码对拍锚）。源 = 本目录
// host_func_id.snapshot.rs（删区迁出快照）；基线外置 baselines.json；
// 生成后 moon fmt 定形；-check 全产物比对后统一还原再红（不留副作用）。
//
//   node scripts/moonbit/gen_host_route/main.mts [-check] [-src P] [-out D] [-baselines P]
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { spawnSync } from "node:child_process";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../../internal/capi.mts";

export interface Baselines {
  expected_consts: number;
  expected_pairs: number;
  expected_pure: number;
}

export interface Parsed {
  consts: Array<[string, string]>;
  pairs: Array<[string, string]>;
  pure: string[];
  constVals: Map<string, string>;
}

const CONST_RE = /pub const ([A-Z][A-Z0-9_]+): u32 = (\d+);/g;
const ARM_RE = /((?:"[a-zA-Z_][a-zA-Z0-9_]*"(?:\s*\|\s*)?)+)\s*=>\s*Some\(([A-Z][A-Z0-9_]+)\)/g;
const NAME_RE = /"([a-zA-Z_][a-zA-Z0-9_]*)"/g;
const PURE_BLOCK_RE = /BYTECODE_LIBC_PURE_FUNCS[^=]*=\s*&\[([^\]]+)\]/;

const toLF = (b: Buffer): Buffer => Buffer.from(b.toString("latin1").replace(/\r\n/g, "\n"), "latin1");

function fatal(msg: string): never {
  process.stderr.write("gen_host_route: " + msg + "\n");
  process.exit(2);
}

export function loadBaselines(p: string): Baselines {
  let raw: Buffer;
  try {
    raw = fs.readFileSync(p);
  } catch (e) {
    throw new Error(`读基线 JSON 失败 ${p}: ${e instanceof Error ? e.message : String(e)}（基线已外置，勿在代码内重新硬编码）`);
  }
  let b: Baselines;
  try {
    b = JSON.parse(toLF(raw).toString("utf8")) as Baselines;
  } catch (e) {
    throw new Error(`基线 JSON 非法 ${p}: ${e instanceof Error ? e.message : String(e)}`);
  }
  if (!(b.expected_consts > 0) || !(b.expected_pairs > 0) || !(b.expected_pure > 0)) {
    throw new Error(`基线 JSON 字段缺失/非正 ${p}（expected_consts/expected_pairs/expected_pure）`);
  }
  return b;
}

export function parseSource(text: string, base: Baselines): Parsed {
  const consts: Array<[string, string]> = [];
  const constVals = new Map<string, string>();
  for (const m of text.matchAll(CONST_RE)) consts.push([m[1] ?? "", m[2] ?? ""]);
  for (const c of consts) constVals.set(c[0], c[1]);
  if (consts.length !== base.expected_consts) {
    throw new Error(`常量数 ${consts.length} ≠ 基线 ${base.expected_consts}——源已变更，请人工核对后更新 baselines.json 的 expected_consts 并登记差异`);
  }

  const pairs: Array<[string, string]> = [];
  for (const m of text.matchAll(ARM_RE)) {
    for (const n of (m[1] ?? "").matchAll(NAME_RE)) pairs.push([n[1] ?? "", m[2] ?? ""]);
  }
  if (pairs.length !== base.expected_pairs) {
    throw new Error(`名→常量对数 ${pairs.length} ≠ 基线 ${base.expected_pairs}——源已变更，请人工核对后更新 baselines.json 的 expected_pairs 并登记差异`);
  }
  for (const p of pairs) {
    if (!constVals.has(p[1])) throw new Error(`match 臂引用未定义常量 ${p[1]}`);
  }

  const pb = PURE_BLOCK_RE.exec(text);
  if (!pb) throw new Error("PURE 表未找到");
  const pure = [...(pb[1] ?? "").matchAll(NAME_RE)].map((m) => m[1] ?? "");
  if (pure.length !== base.expected_pure) {
    throw new Error(`PURE 名数 ${pure.length} ≠ 基线 ${base.expected_pure}——源已变更，请人工核对后更新 baselines.json 的 expected_pure 并登记差异`);
  }
  return { consts, pairs, pure, constVals };
}

export function renderImpl(p: Parsed, srcHash: string): string {
  const lines: string[] = [];
  const w = (s: string): void => {
    lines.push(s);
  };
  w("// @generated by scripts/moonbit/gen_host_route —— 禁手改（git/diff 工具链按 @generated 识别；再生成：仓库根 go run ./scripts/moonbit/gen_host_route）。");
  w("// 源：scripts/moonbit/gen_host_route/host_func_id.snapshot.rs（删区迁出快照）（sha256/" + srcHash + "，行尾归一）");
  w("// 再生成：cd 仓库根 && go run ./scripts/moonbit/gen_host_route（-check 幂等校验）");
  w("//");
  w("// Host 函数路由（S5 扩展批·gen_call_ptr 依赖）——Rust");
  w(`// \`vitro_runtime::host_func_id\` 的照搬：${p.consts.length} 常量 + PURE 表 +`);
  w("// by_user_name 逐对。语义：Bytecode Libc 已覆盖的纯计算函数返回");
  w("// None（生成固定索引 Call 而非 CallHost）；诊断敏感函数（printf/");
  w("// malloc/strcpy 等）返回 host id 走 CallHost。");
  w("//");
  w("// **S6 上提已落实**（2026-09-23）：本表已落在 L6 `vitro/engine/bytecode`");
  w("// 包（与 `libc_index.mbt` 的 88 名单源同域）；消费者是 codegen 的 CallPtr");
  w("// 臂（编译期选调用形态）与 host 的执行期分发。落点裁定见生成器头注。");
  w("");
  w("///|");
  for (const c of p.consts) w("const HOST_" + c[0] + " : Int = " + c[1]);
  w("");
  w("///|");
  w(`/// ${p.pairs.length} 名 → host id **全表**（序 = Rust 源匹配臂序；含别名——如`);
  w("/// `print_int`/`__vitro_output` 同指 OUTPUT、`labs` 同指 ABS）。");
  w("///");
  w("/// **为什么不复用下面的 `host_func_id_by_user_name` 做成员判定**：那个");
  w("/// 函数照搬 Rust 语义，对 14 个 PURE 名**短路返回 None**（`by_user_name`");
  w("/// 的第一条分支），因此无法回答\"这个名字在不在 host 表里\"。路由派生");
  w("/// （`route.mbt`）要的是原始成员关系，故另出本表。");
  w("let host_func_pairs : Array[(String, Int)] = [");
  for (const pair of p.pairs) w(`    ("${pair[0]}", HOST_${pair[1]}),`);
  w("]");
  w("");
  w("///|");
  w("/// Bytecode Libc 已覆盖的纯计算函数（返回 None 走固定索引 Call）。");
  w("let bytecode_libc_pure_funcs : Array[String] = [");
  w("    " + p.pure.map((n) => `"${n}"`).join(", "));
  w("]");
  w("");
  w("///|");
  w("fn is_bytecode_libc_pure(name : String) -> Bool {");
  w("    bytecode_libc_pure_funcs.contains(name)");
  w("}");
  w("");
  w("///|");
  w("/// 用户函数名 → host id（Rust `by_user_name` 逐对照搬；PURE 短路在");
  w("/// match 之前——PURE 名的 Some 臂不可达，由锚的 None 断言覆盖）。");
  w("pub fn host_func_id_by_user_name(name : String) -> Int? {");
  w("    if is_bytecode_libc_pure(name) {");
  w("        return None");
  w("    }");
  w("    match name {");
  for (const pair of p.pairs) w(`        "${pair[0]}" => Some(HOST_${pair[1]})`);
  w("        _ => None");
  w("    }");
  w("}");
  return lines.join("\n") + "\n";
}

export function renderAnchor(p: Parsed, srcHash: string): string {
  const pureSet = new Set(p.pure);
  const lines: string[] = [];
  const w = (s: string): void => {
    lines.push(s);
  };
  w("// @generated by scripts/moonbit/gen_host_route —— 禁手改（git/diff 工具链按 @generated 识别；再生成：仓库根 go run ./scripts/moonbit/gen_host_route）。");
  w("// 源：scripts/moonbit/gen_host_route/host_func_id.snapshot.rs（删区迁出快照）（sha256/" + srcHash + "，行尾归一）");
  w("//");
  w(`// Host 路由硬编码对拍锚：${p.pairs.length} 对逐条断言 Some(id) + ${pureSet.size} PURE 名断言`);
  w("// None（Rust 语义：PURE 短路在 match 之前，match 臂的 Some 值不可达）。");
  w("// 实现文件由同一生成器产出但为独立文件——实现手改/漂移与锚不同步即红。");
  w("");
  w("///|");
  w('test "host route: hardcoded pairs from Rust source" {');
  w("    let pairs : Array[(String, Int)] = [");
  for (const pair of p.pairs) {
    if (pureSet.has(pair[0])) continue;
    w(`        ("${pair[0]}", ${p.constVals.get(pair[1])}),`);
  }
  w("    ]");
  w("    for pair in pairs {");
  w("        assert_eq(host_func_id_by_user_name(pair.0), Some(pair.1))");
  w("    }");
  w("    // PURE 名走 bytecode libc（host id 为 None——短路在 match 之前）");
  w("    for pure_name in bytecode_libc_pure_funcs {");
  w("        assert_true(host_func_id_by_user_name(pure_name) is None)");
  w("    }");
  w("    // 非内置名 None");
  w('    assert_true(host_func_id_by_user_name("main") is None)');
  w('    assert_true(host_func_id_by_user_name("my_func") is None)');
  w("}");
  return lines.join("\n") + "\n";
}

function writeProducts(dirAbs: string, moonbit: string, products: Map<string, string>, check: boolean): void {
  const names = [...products.keys()].sort();
  const items: Array<{ abs: string; rel: string; cur: Buffer | null }> = [];
  for (const name of names) {
    const abs = path.join(dirAbs, name);
    const rel = path.relative(moonbit, abs);
    let cur: Buffer | null = null;
    if (check) {
      try {
        cur = fs.readFileSync(abs);
      } catch (e) {
        fatal(`-check: 读产物失败 ${rel}: ${e instanceof Error ? e.message : String(e)}`);
      }
    }
    try {
      fs.mkdirSync(dirAbs, { recursive: true });
      fs.writeFileSync(abs, products.get(name) ?? "");
    } catch (e) {
      fatal(`写产物失败 ${rel}: ${e instanceof Error ? e.message : String(e)}`);
    }
    items.push({ abs, rel, cur });
  }
  const fmt = spawnSync("moon", ["fmt", ...items.map((i) => i.rel)], { cwd: moonbit, encoding: "utf8" });
  if (fmt.status !== 0) {
    for (const it of items) if (it.cur !== null) fs.writeFileSync(it.abs, it.cur);
    fatal(`moon fmt 失败（moon 须在 PATH）: exit ${fmt.status}\n${(fmt.stdout ?? "") + (fmt.stderr ?? "")}`);
  }
  if (!check) return;
  const drifted: string[] = [];
  for (const it of items) {
    const now = fs.readFileSync(it.abs);
    if (it.cur === null || !toLF(now).equals(toLF(it.cur))) drifted.push(it.rel);
  }
  // 文件参数 fmt 与整包 fmt 形态不同：无论成败都还原原产物（-check 零副作用）
  for (const it of items) if (it.cur !== null) fs.writeFileSync(it.abs, it.cur);
  if (drifted.length > 0) {
    fatal(`-check: 产物漂移 ${drifted.join(", ")}——源已变更未再生成（cd 仓库根 && node scripts/moonbit/gen_host_route/main.mts）`);
  }
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  const root = projectRoot();
  const moonbit = path.join(root, "moonbit");
  let check = false;
  let srcPath = path.join(root, "scripts/moonbit/gen_host_route/host_func_id.snapshot.rs");
  let outDir = path.join(moonbit, "bytecode");
  let baselinesPath = path.join(root, "scripts/moonbit/gen_host_route/baselines.json");
  const args = process.argv.slice(2);
  for (let i = 0; i < args.length; i++) {
    const a = args[i] ?? "";
    const eq = a.indexOf("=");
    const flag = eq >= 0 ? a.slice(0, eq) : a;
    const value = (): string => {
      if (eq >= 0) return a.slice(eq + 1);
      const v = args[++i];
      if (v === undefined) fatal(`${flag} 缺值`);
      return v;
    };
    if (flag === "-check" || flag === "--check") check = true;
    else if (flag === "-src") srcPath = path.resolve(moonbit, value());
    else if (flag === "-out") outDir = path.resolve(moonbit, value());
    else if (flag === "-baselines") baselinesPath = path.resolve(moonbit, value());
    else fatal(`未知参数 ${a}`);
  }

  let parsed: Parsed;
  let srcHash: string;
  try {
    const base = loadBaselines(baselinesPath);
    const src = toLF(fs.readFileSync(srcPath));
    srcHash = crypto.createHash("sha256").update(src).digest("hex").slice(0, 8);
    parsed = parseSource(src.toString("utf8"), base);
  } catch (e) {
    fatal(e instanceof Error ? e.message : String(e));
  }
  const products = new Map<string, string>([
    ["host_func_id_gen.mbt", renderImpl(parsed, srcHash)],
    ["host_route_anchor_wbtest.mbt", renderAnchor(parsed, srcHash)],
  ]);
  writeProducts(outDir, moonbit, products, check);
  if (check) console.log("gen_host_route: check OK（产物与源一致，未漂移）");
}
