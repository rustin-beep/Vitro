// L7 执行层·内存域（S6 开工批）：1MB 载体（Memory）+ 堆状态机（MemoryMap）
// + checked_access 单入口 + freed_logs 有序结构（有序数组 + 二分 + 精确裁剪）
// + 快照批量装载 load_*（vm 片：VMSnapshot restore 的 memory 侧单点）。
// 依赖严格单向：bytecode（L6：布局常量单源 + 动态堆起点纯函数）+ core/deque
// （隔离区 FIFO）+ core/abort（load 的 fail loud 中止）。
// 被 host / vm 消费，不反向依赖。
// 分层登记：scripts/moonbit/pkg_deps rules.json（L7，总计划 §4）。
import {
  "moonbitlang/core/abort",
  "moonbitlang/core/deque",
  "vitro/engine/bytecode",
  "vitro/engine/util",
}

import {
  "vitro/engine/bytecode",
} for "test"
