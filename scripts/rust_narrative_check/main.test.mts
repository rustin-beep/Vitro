// rust_narrative_check 单测 + J9 证红（审阅 v2 批 A7'）。
import { test } from "node:test";
import assert from "node:assert/strict";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import {
  commentStart,
  isGenerated,
  loadRules,
  narrativeLines,
  scanFile,
  scanRepo,
  type Exemption,
  type Rules,
} from "./main.mts";
import { projectRoot } from "../internal/capi.mts";

const SELF_DIR = import.meta.dirname;
const RULES: Rules = loadRules(SELF_DIR);

test("规则表：三规则 R1/R2/R3 齐、正则可编译、tag_markers 含 rust-oracle-freeze", () => {
  assert.deepEqual(
    RULES.rules.map((r) => r.id),
    ["R1", "R2", "R3"],
  );
  for (const r of RULES.rules) new RegExp(r.pattern);
  assert.ok(RULES.tag_markers.includes("rust-oracle-freeze"));
  assert.ok(RULES.window >= 1);
});

test("commentStart：裸代码 -1 / 行首注释 / 尾注释 / 字符串内 // 不算 / 多行字符串行不算", () => {
  assert.equal(commentStart("let x = 1"), -1);
  assert.equal(commentStart("// 注释"), 0);
  assert.equal(commentStart("  /// doc"), 2);
  assert.equal(commentStart("let x = 1 // 尾注"), 10);
  assert.equal(commentStart('let u = "http://native/src/x.rs"'), -1);
  assert.equal(commentStart('let u = "a\\"//b" // real'), 17);
  assert.equal(commentStart("  #| native/src/foo.rs 照搬不修"), -1);
  assert.equal(commentStart("  $| 与 Rust 一致"), -1);
  assert.equal(commentStart("let c = '/' // x"), 12);
});

test("narrativeLines：.mbt 只取注释段，.mbt.md 整行", () => {
  const mbt = narrativeLines("a.mbt", 'let s = "native/src/a.rs"\n// native/src/b.rs\n');
  assert.deepEqual(mbt, ["", "// native/src/b.rs", ""]);
  const md = narrativeLines("README.mbt.md", "照搬 native/src/c.rs\n");
  assert.deepEqual(md, ["照搬 native/src/c.rs", ""]);
});

test("isGenerated：首 N 行含 @generated 即跳过", () => {
  assert.equal(isGenerated("// @generated by x\nfn f() {}", "@generated", 5), true);
  assert.equal(isGenerated("fn f() {}\n// @generated", "@generated", 1), false);
});

test("R1：死路径裸引红；窗口内 tag 过闸；字符串字面量不算", () => {
  const red = scanFile("m/a.mbt", "// 照搬源：native/src/session_api.rs\nfn f() {}\n", RULES);
  assert.equal(red.length, 1);
  assert.equal(red[0]?.rule, "R1");
  assert.equal(red[0]?.line, 1);
  const ok = scanFile(
    "m/a.mbt",
    "// 历史蓝本（tag rust-oracle-freeze 可回溯）：\n// native/src/session_api.rs\n",
    RULES,
  );
  assert.equal(ok.length, 0);
  const crate = scanFile("m/a.mbt", "/// 照搬 Rust `vitro_codegen/src/lib.rs:136`\n", RULES);
  assert.equal(crate.length, 1, "省 crates/ 前缀的 vitro_xxx/src/ 形态也须命中");
  const str = scanFile("m/a.mbt", 'let p = "native/src/x.rs"\n', RULES);
  assert.equal(str.length, 0);
});

test("R2：照搬不修活体红；销案留痕词或 tag 过闸", () => {
  const red = scanFile("m/b.mbt", "/// 坑 17，照搬不修：xxx\n", RULES);
  assert.equal(red.length, 1);
  assert.equal(red[0]?.rule, "R2");
  const ok1 = scanFile("m/b.mbt", "/// 旧形态系 oracle 照搬在案（已修，销案）\n", RULES);
  assert.equal(ok1.length, 0);
  const ok2 = scanFile("m/b.mbt", "/// oracle 同病（tag rust-oracle-freeze）\n", RULES);
  assert.equal(ok2.length, 0);
});

test("R3：对齐声明红；历史限定词过闸；「Rust 侧同构」无「与」形态也命中", () => {
  const red = scanFile("m/c.mbt", "// 确定性顺序（与 Rust 侧 sort 对齐）\n", RULES);
  assert.equal(red.length, 1);
  assert.equal(red[0]?.rule, "R3");
  const red2 = scanFile("m/c.mbt", "/// union 复用本结构——Rust 侧同构\n", RULES);
  assert.equal(red2.length, 1);
  const ok = scanFile("m/c.mbt", "// 历史蓝本同形（与 Rust 一致的旧口径）\n", RULES);
  assert.equal(ok.length, 0);
});

test("窗口：tag 在命中行之后 window 行内同样过闸；超窗不过", () => {
  const w = RULES.window;
  const near = ["// native/src/a.rs", ...Array(w - 1).fill("//"), "// tag rust-oracle-freeze"].join("\n");
  assert.equal(scanFile("m/d.mbt", near, RULES).length, 0);
  const far = ["// native/src/a.rs", ...Array(w).fill("//"), "// tag rust-oracle-freeze"].join("\n");
  assert.equal(scanFile("m/d.mbt", far, RULES).length, 1);
});

test("J9：临时迷你仓三规则各埋一雷必红；例外表精确匹配过闸；陈旧例外判僵尸", () => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "vitro-rustnarr-"));
  fs.mkdirSync(path.join(dir, "moonbit", "pkg"), { recursive: true });
  fs.mkdirSync(path.join(dir, "moonbit", "_build"), { recursive: true });
  fs.writeFileSync(
    path.join(dir, "moonbit", "pkg", "x.mbt"),
    [
      "// 照搬源：native/src/foo.rs",
      "fn a() {}",
      "/// 坑 99（照搬不修）",
      "fn b() {}",
      "// 与 Rust 一致",
      "fn c() {}",
      "",
    ].join("\n"),
  );
  // _build 下同样内容须被 prune
  fs.writeFileSync(path.join(dir, "moonbit", "_build", "y.mbt"), "// native/src/zzz.rs\n");
  // @generated 文件须跳过
  fs.writeFileSync(path.join(dir, "moonbit", "pkg", "g_gen.mbt"), "// @generated\n// native/src/gen.rs\n");

  const r0 = scanRepo(dir, RULES, []);
  assert.equal(r0.skippedGenerated, 1);
  const live0 = r0.hits.filter((h) => !h.exempted);
  assert.deepEqual(
    live0.map((h) => [h.rule, h.line]),
    [
      ["R1", 1],
      ["R2", 3],
      ["R3", 5],
    ],
  );
  assert.equal(r0.zombies.length, 0);

  const ex: Exemption[] = live0.map((h) => ({ file: h.file, rule: h.rule, line_text: h.text, reason: "J9 测试过闸" }));
  const r1 = scanRepo(dir, RULES, ex);
  assert.equal(r1.hits.filter((h) => !h.exempted).length, 0);
  assert.equal(r1.hits.filter((h) => h.exempted).length, 3);
  assert.equal(r1.zombies.length, 0);

  const stale: Exemption[] = [{ file: "moonbit/pkg/x.mbt", rule: "R1", line_text: "// 不存在的行", reason: "陈旧" }];
  const r2 = scanRepo(dir, RULES, stale);
  assert.equal(r2.zombies.length, 1);
  assert.equal(r2.hits.filter((h) => !h.exempted).length, 3);
});

test("真实仓库：清注后闸绿（与 CI 同门径，零活命中零僵尸）", () => {
  const r = spawnSync(process.execPath, [path.join(SELF_DIR, "main.mts"), "-check"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 0, r.stdout + r.stderr);
  assert.match(r.stdout, /rust_narrative_check: PASS——扫描 \d+ 文件（@generated 跳过 \d+）\/ 活命中 0 \//);
});

test("--json 出口：结构字段齐", () => {
  const r = spawnSync(process.execPath, [path.join(SELF_DIR, "main.mts"), "--json"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 0, r.stderr);
  const o = JSON.parse(r.stdout) as { files: number; skipped_generated: number; live: unknown[]; exempted: number; zombies: unknown[] };
  assert.ok(o.files > 0);
  assert.equal(o.live.length, 0);
  assert.equal(o.zombies.length, 0);
});

test("参数面：未知参数 rc=2", () => {
  const r = spawnSync(process.execPath, [path.join(SELF_DIR, "main.mts"), "--bogus"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 2);
});
