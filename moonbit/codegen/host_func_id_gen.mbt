///|
/// Bytecode Libc 已覆盖的纯计算函数（返回 None 走固定索引 Call）。
let bytecode_libc_pure_funcs : Array[String] = [
  "isdigit", "isalpha", "islower", "isupper", "tolower", "toupper", "isspace", "isalnum",
  "isprint", "iscntrl", "isxdigit", "abs", "strlen", "strcmp",
]

///|
fn is_bytecode_libc_pure(name : String) -> Bool {
  bytecode_libc_pure_funcs.contains(name)
}

///|
/// 用户函数名 → host id（Rust `by_user_name` 逐对照搬；PURE 短路在
/// match 之前——PURE 名的 Some 臂不可达，由锚的 None 断言覆盖）。
fn host_func_id_by_user_name(name : String) -> Int? {
  if is_bytecode_libc_pure(name) {
    return None
  }
  match name {
    "print_int" => Some(HOST_OUTPUT)
    "__vitro_output" => Some(HOST_OUTPUT)
    "__vitro_step" => Some(HOST_STEP)
    "malloc" => Some(HOST_MALLOC)
    "free" => Some(HOST_FREE)
    "printf" => Some(HOST_PRINTF_N)
    "scanf" => Some(HOST_SCANF_N)
    "strlen" => Some(HOST_STRLEN)
    "strcpy" => Some(HOST_STRCPY)
    "strcmp" => Some(HOST_STRCMP)
    "getchar" => Some(HOST_GETCHAR)
    "putchar" => Some(HOST_PUTCHAR)
    "rand" => Some(HOST_RAND)
    "srand" => Some(HOST_SRAND)
    "memset" => Some(HOST_MEMSET)
