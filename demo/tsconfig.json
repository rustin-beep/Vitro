{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "noEmitOnError": false,
    "skipLibCheck": true,
    "types": [],
    "strictNullChecks": false
  },
  "include": [
    "app.ts",
    "js/**/*.ts",
    "*.d.ts"
  ]
}