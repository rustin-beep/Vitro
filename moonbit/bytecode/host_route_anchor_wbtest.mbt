//
// Host 路由硬编码对拍锚：110 对逐条断言 Some(id) + 14 PURE 名断言
// None（Rust 语义：PURE 短路在 match 之前，match 臂的 Some 值不可达）。
// 实现文件由同一生成器产出但为独立文件——实现手改/漂移与锚不同步即红。

///|
test "host route: hardcoded pairs from Rust source" {
  let pairs : Array[(String, Int)] = [
    ("print_int", 0),
    ("__vitro_output", 0),
    ("__vitro_step", 1),
    ("malloc", 2),
    ("free", 3),
    ("printf", 15),
    ("scanf", 21),
    ("strcpy", 31),
    ("getchar", 33),
    ("putchar", 34),
    ("rand", 35),
    ("srand", 36),
    ("memset", 37),
    ("exit", 38),
    ("strcat", 39),
    ("atoi", 40),
    ("strncpy", 56),
    ("memcpy", 57),
    ("memmove", 58),
    ("fprintf", 50),
    ("realloc", 51),
    ("qsort", 52),
    ("fopen", 60),
    ("fread", 61),
    ("fwrite", 62),
    ("fclose", 63),
    ("feof", 64),
    ("fgets", 65),
    ("fputs", 66),
    ("sin", 70),
    ("cos", 71),
    ("sqrt", 72),
    ("pow", 73),
    ("atan", 74),
    ("log", 75),
    ("exp", 76),
    ("strdup", 77),
    ("ungetc", 78),
    ("puts", 79),
    ("calloc", 80),
    ("bsearch", 81),
    ("sprintf", 82),
    ("snprintf", 83),
    ("sscanf", 84),
    ("fgetc", 85),
    ("fputc", 86),
    ("fseek", 87),
    ("ftell", 88),
    ("rewind", 89),
    ("strncat", 90),
    ("strncmp", 91),
    ("memcmp", 92),
    ("strchr", 93),
    ("strrchr", 94),
    ("strstr", 95),
    ("memchr", 96),
    ("atof", 97),
    ("atol", 98),
    ("tan", 99),
    ("log10", 100),
    ("fabs", 101),
    ("ceil", 102),
    ("floor", 103),
    ("round", 104),
    ("fmod", 105),
    ("isgraph", 106),
    ("ispunct", 107),
    ("isblank", 108),
    ("asin", 109),
    ("acos", 110),
    ("atan2", 111),
    ("sinh", 112),
    ("cosh", 113),
    ("tanh", 114),
    ("labs", 41),
    ("llabs", 115),
    ("abort", 116),
    ("strtol", 117),
    ("strtod", 118),
    ("strerror", 119),
    ("fflush", 120),
    ("perror", 121),
    ("clearerr", 122),
    ("time", 123),
    ("clock", 124),
    ("__vitro_assert_fail", 125),
    ("remove", 126),
    ("rename", 127),
    ("strpbrk", 128),
    ("strspn", 129),
    ("strcspn", 130),
    ("__vitro_va_start", 140),
    ("__vitro_va_arg", 141),
    ("__vitro_va_end", 142),
    ("__vitro_va_copy", 143),
    ("unreachable", 144),
  ]
  for pair in pairs {
    assert_eq(host_func_id_by_user_name(pair.0), Some(pair.1))
  }
  // PURE 名走 bytecode libc（host id 为 None——短路在 match 之前）
  for pure_name in bytecode_libc_pure_funcs {
    assert_true(host_func_id_by_user_name(pure_name) is None)
  }
  // 非内置名 None
  assert_true(host_func_id_by_user_name("main") is None)
  assert_true(host_func_id_by_user_name("my_func") is None)
}
