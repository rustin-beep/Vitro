#!/usr/bin/env node
// gen_stubs：从 libc 存根头生成 MoonBit 数据表 stubs_gen.mbt（#273 存量 Go 重写批）。
//
// 纪律（沿 gen_diag 先例）：禁手抄（唯一来源 = libc_src/include/*.h）；幂等
//（双次字节一致）；生成流程内置 moon fmt；-check 不留副作用（漂移还原后红）。
// 头文件名单唯一真源 = moonbit/stdlib/stdlib.mbt 的 headers()（文本解析；
// 序决定产物臂序与 sha256 拼接序）；名单 ↔ include 目录双向集合对账。
//
//   node scripts/moonbit/gen_stubs/main.mts [-check]
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { spawnSync } from "node:child_process";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../../internal/capi.mts";

const OUT_REL = "lexer/internal/host/stubs_gen.mbt";

function toLF(b: Buffer): Buffer {
  return Buffer.from(b.toString("latin1").replace(/\r\n/g, "\n"), "latin1");
}

function fatal(msg: string): never {
  process.stderr.write("gen_stubs: " + msg + "\n");
  process.exit(1);
}

export function moonEscape(s: string): string {
  let out = "";
  for (const ch of s) {
    const cp = ch.codePointAt(0) ?? 0;
    if (ch === "\\") out += "\\\\";
    else if (ch === '"') out += '\\"';
    else if (ch === "\n") out += "\\n";
    else if (ch === "\t") out += "\\t";
    else if (ch === "\r") out += "\\r";
    else if (cp < 0x20) throw new Error(`控制字符 U+${cp.toString(16).toUpperCase().padStart(4, "0")} 出现在存根中，需人工裁定转义口径`);
    else out += ch;
  }
  return out;
}

// loadHeaderNamesFrom 解析 headers() 数组字面量（moon fmt 只动空白，引号串稳定）。
export function loadHeaderNamesFrom(textRaw: string): string[] {
  const text = textRaw.replace(/\r\n/g, "\n");
  const sig = "pub fn headers() -> Array[String]";
  const fnAt = text.indexOf(sig);
  if (fnAt < 0) throw new Error("stdlib 真源缺少 pub fn headers() -> Array[String]（形态变更须同步本解析器）");
  const sigAt = text.indexOf("Array[String]", fnAt);
  const body = text.slice(sigAt + "Array[String]".length);
  const open = body.indexOf("[");
  const close = body.indexOf("]");
  if (open < 0 || close < open) throw new Error("stdlib headers() 数组字面量缺失");
  const names = [...body.slice(open, close).matchAll(/"([^"\n]+)"/g)].map((m) => m[1] ?? "");
  if (names.length === 0) throw new Error("stdlib headers() 名单为空");
  for (const n of names) {
    if (!n.endsWith(".h")) throw new Error(`stdlib headers() 含非 .h 条目 ${JSON.stringify(n)}`);
  }
  return names;
}

export function loadHeaderNames(root: string): string[] {
  let raw: Buffer;
  try {
    raw = fs.readFileSync(path.join(root, "moonbit/stdlib/stdlib.mbt"));
  } catch (e) {
    throw new Error(`读取 stdlib 真源失败 moonbit/stdlib/stdlib.mbt: ${e instanceof Error ? e.message : String(e)}`);
  }
  return loadHeaderNamesFrom(raw.toString("utf8"));
}

// 名单 ↔ include 目录双向集合对账（目录多出未登记头 / 登记名无文件均红）。
export function crossCheckDir(root: string, names: string[]): void {
  const dir = path.join(root, "scripts/moonbit/libc_src/include");
  let entries: fs.Dirent[];
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch (e) {
    throw new Error(`扫描存根目录失败 scripts/moonbit/libc_src/include: ${e instanceof Error ? e.message : String(e)}`);
  }
  const dirSet = new Set(entries.filter((e) => !e.isDirectory() && e.name.endsWith(".h")).map((e) => e.name));
  const nameSet = new Set(names);
  for (const n of dirSet) {
    if (!nameSet.has(n)) throw new Error(`目录存在未登记头 ${n}（stdlib headers() 缺条目——加进 moonbit/stdlib/stdlib.mbt）`);
  }
  for (const n of nameSet) {
    if (!dirSet.has(n)) throw new Error(`headers() 登记 ${n} 在目录中不存在（libc_src/include/）`);
  }
}

export interface Built {
  text: string;
  sha256: string;
}

export function buildOutput(root: string, names: string[]): Built {
  const includeDir = path.join(root, "scripts/moonbit/libc_src/include");
  const digestParts: Buffer[] = [];
  let arms = "";
  for (const name of names) {
    let raw: Buffer;
    try {
      raw = fs.readFileSync(path.join(includeDir, name));
    } catch (e) {
      throw new Error(`读取存根失败 ${name}: ${e instanceof Error ? e.message : String(e)}`);
    }
    const normalized = toLF(raw);
    digestParts.push(normalized);
    arms += `    "${name}" => Some("${moonEscape(normalized.toString("utf8"))}")\n`;
  }
  const sum = crypto.createHash("sha256").update(Buffer.concat(digestParts)).digest("hex");
  let out = "";
  out += "// @generated by scripts/moonbit/gen_stubs —— 禁手改（git/diff 工具链按 @generated 识别；源 scripts/moonbit/libc_src/include/*.h（2026-10-05 迁出冻结区）；再生成：仓库根 go run ./scripts/moonbit/gen_stubs）\n";
  out += `// source sha256: ${sum}（14 存根规范化行尾后按固定顺序拼接）\n`;
  out += "\n///|\n";
  out += "/// 标准库存根内容表（14 个；内容唯一来源 = Rust oracle 冻结资产，本文件为生成物）。\n";
  out += "pub fn stub_lookup(name : String) -> String? {\n";
  out += "  match name {\n";
  out += arms;
  out += "    _ => None\n";
  out += "  }\n";
  out += "}\n";
  return { text: out, sha256: sum };
}

function main(check: boolean): void {
  const root = projectRoot();
  if (!fs.existsSync(path.join(root, "moonbit"))) {
    process.stderr.write("gen_stubs: 须在仓库根运行（找不到 moonbit/）\n");
    process.exit(2);
  }
  let names: string[];
  let built: Built;
  try {
    names = loadHeaderNames(root);
    crossCheckDir(root, names);
    built = buildOutput(root, names);
  } catch (e) {
    fatal(e instanceof Error ? e.message : String(e));
  }
  const outFile = path.join(root, "moonbit", OUT_REL);
  const outFileRel = OUT_REL;

  let orig: Buffer | null = null;
  try {
    orig = fs.readFileSync(outFile);
  } catch {
    orig = null;
  }

  fs.writeFileSync(outFile, built.text);
  const fmt = spawnSync("moon", ["fmt", outFileRel], { cwd: path.join(root, "moonbit"), encoding: "utf8" });
  if (fmt.status !== 0) {
    if (orig !== null) fs.writeFileSync(outFile, orig);
    fatal(`moon fmt 失败（moon 须在 PATH）: exit ${fmt.status}\n${(fmt.stdout ?? "") + (fmt.stderr ?? "")}`);
  }

  if (!check) {
    console.log(`gen_stubs: 已生成 ${outFileRel}（sha256 ${built.sha256}）`);
    return;
  }
  const now = fs.readFileSync(outFile);
  const same = orig !== null && toLF(now).equals(toLF(orig));
  // 带文件参数的 moon fmt 与整包 fmt 形态不同：比对成功后也必须还原，
  // 否则 -check 会把产物改成文件 fmt 形态（Go 版既有副作用，本版修正）。
  if (orig !== null) fs.writeFileSync(outFile, orig);
  if (!same) {
    fatal(`-check: 产物漂移 ${outFileRel}——源已变更未再生成（node scripts/moonbit/gen_stubs/main.mts）`);
  }
  console.log(`gen_stubs: check OK（产物与源一致，未漂移；sha256 ${built.sha256}）`);
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  const args = process.argv.slice(2);
  const check = args.includes("-check") || args.includes("--check");
  for (const a of args) {
    if (a !== "-check" && a !== "--check") {
      process.stderr.write(`gen_stubs: 未知参数 ${a}\n`);
      process.exit(2);
    }
  }
  main(check);
}
