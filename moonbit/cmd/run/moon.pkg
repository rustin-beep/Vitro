// 批五号：D 级三联 diff 的 MoonBit 侧 runner——cmd 层（pkg_deps 豁免方向）。
import {
  "vitro/engine/cmd/lib/cli",
  "vitro/engine/fs",
  "vitro/engine/gateway",
  "moonbitlang/core/env",
}

supported_targets = "native"

pkgtype(kind: "executable")

options(
