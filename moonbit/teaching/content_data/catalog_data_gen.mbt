    [
      "循环条件写了 <=（应为 <）", "循环变量的初始值或步长算错",
      "用变量做下标且没有检查范围",
    ],
  ),
  3087: @diag.CatalogEntry::of(
    3087,
    "buffer-overflow",
    "内存访问越界（运行期）",
