  "lesson": {
    "title": "冒泡排序",
    "blocks": [
      { "type": "p", "text": "相邻元素两两比较，较大者向后交换——每一轮把当前最大值「冒泡」到末尾。" },
      { "type": "h2", "text": "核心代码" },
      {
        "type": "code",
        "lang": "c",
        "text": "for (int i = 0; i < n - 1; i++)\n  for (int j = 0; j < n - 1 - i; j++)\n    if (a[j] > a[j+1]) {\n      int t = a[j]; a[j] = a[j+1]; a[j+1] = t;\n    }"
      },
      { "type": "ul", "items": ["外层 i 控制轮数：n-1 轮", "内层 j 相邻比较：随 i 递减（有序尾不再参与）"] },
      {
        "type": "table",
        "rows": [
          ["轮次", "比较次数", "有序尾长"],
          ["1", "3", "1"],
          ["2", "2", "2"],
          ["3", "1", "3"]
        ]
      }
    ]
