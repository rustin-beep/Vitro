///|
/// 全方法清单文本（api help 无参时打印）。
pub fn api_help_list() -> String {
  "api 方法清单（30）——api help <method> 看单方法详情：\n  algorithms.catalog   43 族算法目录（族名/中文名/分组建议/vis 能力位——判据源码即数据源，#36）\n  ast.dump             AST 导出（静态 dump 族——无需会话）\n  breakpoints.set      下发断点集合（行号数组；传 [] 清空断点即恢复执行——命中暂停后无专用 resume 方法，恢复走清空断点或 seek 跳转，#101）\n  capabilities         能力清单（语言/协议面）\n  codegen.dump         编译产物转储（字节码跳转图 + 每指令源码行号——流程图原料；复用 codegen_diff 逐字节对拍锁定的单源 emitter，只读零会话态，#52）\n  compile              编译（覆盖式语义：files 数组=当前完整编译单元集合，非追加）\n  config.get           读会话配置\n  config.set           写会话配置（preset 档位一键：default|algo|tiny——#133，algo 档带 max_checkpoints=200；max_steps/call_depth_limit/deterministic/quarantine_budget/output_budget/input_mode_batch/max_checkpoints〔#87 检查点保留数——seek 重放距离的锚点密度旋钮，1..=1000 内存防线〕同帧可覆盖单项；未知键 fail loud #105；超上界 fail loud（可表示域/内存防线）；低下界钳制回包带 clamped #94）\n  contracts            schema 契约与字段台账（StepPayload 冻结面）\n  diagnostics_probe    诊断探针（补全/悬停位——M15 无实现面 fail loud）\n  error_catalog        错误码目录（E/W/H 码 + 教学文案 + icon id）\n  icons.get            图标资产按 id 下发（缺省=全量；值域=icons/index.tsv）\n  input.feed           交互续跑喂输入（text 追加；eof=true 置 EOF 收尾口，#88；步进会话活跃时走 engine 帧流，#86）\n  memory.dump          1MB 内存映像 base64（--dump-memory 通道）\n  memory.regions       内存区域快照（堆/栈/全局）\n  output.delta         拉增量输出（stream=display/stdout/stderr/note，未知流名整帧拒绝 #258；判分取 stdout；delta=逐字节 Latin-1 折回、cursor 按字节——比对前 Buffer.from(delta,latin1) 还原，#112）\n  payload.get          取步载荷帧（区间式：start..end 步——缺省 0..全部到窗尾；回放/断点消费面）\n  ping                 心跳连通性探针\n  run                  执行已编译单元（batch_input=输入耗尽即 EOF；返回八字段 ok/status/return_value/trap/trap_code/waiting_input/steps_executed/output_truncated——末者输出预算触顶=true，#91；#320 勘正：旧文「七字段」漏 trap_code）\n  seek                 跳至目标步（会话须已 step.begin）\n  semantic_labels      语义标签表（算法/事件中文标注）\n  session.create       创建/重建会话（清空重建同一实例；argv/输入模式回默认）\n  session.destroy      销毁会话（进程存活；回收进程用 shutdown）\n  session.reset        重置编译/运行状态（保留会话级配置：隔离预算/deterministic/argv）\n  shutdown             关停 serve 进程（响应帧携带 shutdown:true）\n  step.begin           开启步进会话（采集步帧；断点须 begin 后下发）\n  step.next            推进 frames 步（缺省 1；须为正整数——零/负/浮点/字符串等非法值报 protocol 错；超过会话 max_steps 预算按预算推进；every=N 稀疏采样=每 N 步 1 帧〔1..100000，与 frames 互斥双给报错，#89〕；返回帧数组——发布按行末对齐一帧缓冲语义，frames 是推进量非发布量）\n  symbols.dump         符号表导出（静态 dump 族）\n  texts.install        语言包装载（payload 顶层四段可选集：suggestions/builtin_notes/trap_messages/error_catalog——批③b 扩诊断卡片段；浏览器宿主懒加载注入通道，#130）\n  typeck.dump          类型检查导出（静态 dump 族）\n"
}

///|
/// 单方法详情文本（api help <method> 时打印；未知方法 None——rc=4 用法错）。
/// 形参名 m 非 method：reserved_keyword 0035（#46 在册——形参避开保留字，
/// 协议层字段名不受影响）。
pub fn api_help_detail(m : String) -> String? {
  match m {
    "algorithms.catalog" =>
      Some(
        "algorithms.catalog——43 族算法目录（族名/中文名/分组建议/vis 能力位——判据源码即数据源，#36）\n  params: 无必填（缺省 {}）\n  例: vitro api algorithms.catalog '{}'",
      )
    "ast.dump" =>
      Some(
        "ast.dump——AST 导出（静态 dump 族——无需会话）\n  params: source:string\n  例: vitro api ast.dump '{\"source\":\"int main(){return 0;}\"}'",
      )
    "breakpoints.set" =>
      Some(
        "breakpoints.set——下发断点集合（行号数组；传 [] 清空断点即恢复执行——命中暂停后无专用 resume 方法，恢复走清空断点或 seek 跳转，#101）\n  params: 无必填（缺省 {}）\n  例: vitro api breakpoints.set '{\"lines\":[5,10]}'",
      )
    "capabilities" =>
      Some(
        "capabilities——能力清单（语言/协议面）\n  params: 无必填（缺省 {}）\n  例: vitro api capabilities '{}'",
      )
    "codegen.dump" =>
      Some(
        "codegen.dump——编译产物转储（字节码跳转图 + 每指令源码行号——流程图原料；复用 codegen_diff 逐字节对拍锁定的单源 emitter，只读零会话态，#52）\n  params: source:string\n  例: vitro api codegen.dump '{\"source\":\"int main(){return 0;}\"}'",
      )
    "compile" =>
      Some(
        "compile——编译（覆盖式语义：files 数组=当前完整编译单元集合，非追加）\n  params: files:[{filename?,source}] | source:string[,filename:string]\n  例: vitro api compile '{\"files\":[{\"filename\":\"main.c\",\"source\":\"int main(){return 0;}\"}]}'",
      )
    "config.get" =>
      Some(
        "config.get——读会话配置\n  params: 无必填（缺省 {}）\n  例: vitro api config.get '{}'",
      )
    "config.set" =>
      Some(
        "config.set——写会话配置（preset 档位一键：default|algo|tiny——#133，algo 档带 max_checkpoints=200；max_steps/call_depth_limit/deterministic/quarantine_budget/output_budget/input_mode_batch/max_checkpoints〔#87 检查点保留数——seek 重放距离的锚点密度旋钮，1..=1000 内存防线〕同帧可覆盖单项；未知键 fail loud #105；超上界 fail loud（可表示域/内存防线）；低下界钳制回包带 clamped #94）\n  params: max_steps:int(1..=2147483647)；max_checkpoints:int(1..=1000)\n  例: vitro api config.set '{\"preset\":\"algo\"}'",
      )
    "contracts" =>
      Some(
        "contracts——schema 契约与字段台账（StepPayload 冻结面）\n  params: 无必填（缺省 {}）\n  例: vitro api contracts '{}'",
      )
    "diagnostics_probe" =>
      Some(
        "diagnostics_probe——诊断探针（补全/悬停位——M15 无实现面 fail loud）\n  params: source:string\n  例: vitro api diagnostics_probe '{\"source\":\"int main(){return 0;}\"}'",
      )
    "error_catalog" =>
      Some(
        "error_catalog——错误码目录（E/W/H 码 + 教学文案 + icon id）\n  params: 无必填（缺省 {}）\n  例: vitro api error_catalog '{}'",
      )
    "icons.get" =>
      Some(
        "icons.get——图标资产按 id 下发（缺省=全量；值域=icons/index.tsv）\n  params: ids:string[]\n  例: vitro api icons.get '{\"ids\":[\"uaf\"]}'",
      )
    "input.feed" =>
      Some(
        "input.feed——交互续跑喂输入（text 追加；eof=true 置 EOF 收尾口，#88；步进会话活跃时走 engine 帧流，#86）\n  params: 无必填（缺省 {}）\n  例: vitro api input.feed '{\"text\":\"42\\n\"}'",
      )
    "memory.dump" =>
      Some(
        "memory.dump——1MB 内存映像 base64（--dump-memory 通道）\n  params: 无必填（缺省 {}）\n  例: vitro api memory.dump '{}'",
      )
    "memory.regions" =>
      Some(
        "memory.regions——内存区域快照（堆/栈/全局）\n  params: 无必填（缺省 {}）\n  例: vitro api memory.regions '{}'",
      )
    "output.delta" =>
      Some(
        "output.delta——拉增量输出（stream=display/stdout/stderr/note，未知流名整帧拒绝 #258；判分取 stdout；delta=逐字节 Latin-1 折回、cursor 按字节——比对前 Buffer.from(delta,latin1) 还原，#112）\n  params: display|stdout|stderr|note\n  例: vitro api output.delta '{\"cursor\":0,\"stream\":\"stdout\"}'",
      )
    "payload.get" =>
      Some(
        "payload.get——取步载荷帧（区间式：start..end 步——缺省 0..全部到窗尾；回放/断点消费面）\n  params: 无必填（缺省 {}）\n  例: vitro api payload.get '{\"start\":0,\"end\":10}'",
      )
    "ping" =>
      Some(
        "ping——心跳连通性探针\n  params: 无必填（缺省 {}）\n  例: vitro api ping '{}'",
      )
    "run" =>
      Some(
        "run——执行已编译单元（batch_input=输入耗尽即 EOF；返回八字段 ok/status/return_value/trap/trap_code/waiting_input/steps_executed/output_truncated——末者输出预算触顶=true，#91；#320 勘正：旧文「七字段」漏 trap_code）\n  params: 无必填（缺省 {}）\n  例: vitro api run '{\"argv\":[\"main.c\"]}'",
      )
    "seek" =>
      Some(
        "seek——跳至目标步（会话须已 step.begin）\n  params: step:int\n  例: vitro api seek '{\"step\":3}'",
      )
    "semantic_labels" =>
      Some(
        "semantic_labels——语义标签表（算法/事件中文标注）\n  params: 无必填（缺省 {}）\n  例: vitro api semantic_labels '{}'",
      )
    "session.create" =>
      Some(
        "session.create——创建/重建会话（清空重建同一实例；argv/输入模式回默认）\n  params: 无必填（缺省 {}）\n  例: vitro api session.create '{}'",
      )
    "session.destroy" =>
      Some(
        "session.destroy——销毁会话（进程存活；回收进程用 shutdown）\n  params: 无必填（缺省 {}）\n  例: vitro api session.destroy '{}'",
      )
    "session.reset" =>
      Some(
        "session.reset——重置编译/运行状态（保留会话级配置：隔离预算/deterministic/argv）\n  params: 无必填（缺省 {}）\n  例: vitro api session.reset '{}'",
      )
    "shutdown" =>
      Some(
        "shutdown——关停 serve 进程（响应帧携带 shutdown:true）\n  params: 无必填（缺省 {}）\n  例: vitro api shutdown '{}'",
      )
    "step.begin" =>
      Some(
        "step.begin——开启步进会话（采集步帧；断点须 begin 后下发）\n  params: 无必填（缺省 {}）\n  例: vitro api step.begin '{}'",
      )
    "step.next" =>
      Some(
        "step.next——推进 frames 步（缺省 1；须为正整数——零/负/浮点/字符串等非法值报 protocol 错；超过会话 max_steps 预算按预算推进；every=N 稀疏采样=每 N 步 1 帧〔1..100000，与 frames 互斥双给报错，#89〕；返回帧数组——发布按行末对齐一帧缓冲语义，frames 是推进量非发布量）\n  params: frames:int>=1 XOR every:int in [1,100000]\n  例: vitro api step.next '{\"frames\":10}'",
      )
    "symbols.dump" =>
      Some(
        "symbols.dump——符号表导出（静态 dump 族）\n  params: source:string\n  例: vitro api symbols.dump '{\"source\":\"int main(){return 0;}\"}'",
      )
    "texts.install" =>
      Some(
        "texts.install——语言包装载（payload 顶层四段可选集：suggestions/builtin_notes/trap_messages/error_catalog——批③b 扩诊断卡片段；浏览器宿主懒加载注入通道，#130）\n  params: payload:string 必填（语言包 texts_json 同 schema 的 JSON 文本；顶层四段可选集：suggestions/builtin_notes/trap_messages/error_catalog——缺省段不动现表，携带段为整表替换且键集须全等现表；最小合法载荷 {\"payload\":\"{}\"} 即装载无变更回显计数）\n  例: vitro api texts.install '{\"payload\":\"{}\"}'",
      )
    "typeck.dump" =>
      Some(
        "typeck.dump——类型检查导出（静态 dump 族）\n  params: source:string\n  例: vitro api typeck.dump '{\"source\":\"int main(){return 0;}\"}'",
      )
    _ => None
  }
}
