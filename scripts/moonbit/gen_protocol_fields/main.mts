#!/usr/bin/env node
// gen_protocol_fields：S7 protocol 字段白名单生成器（#273 存量 Go 重写批）。
//
// 源 = scripts/replay/v01_payload_fields.json（v0.1 冻结表 / 预留位 / v0.2 激活表）；
// 产物 = moonbit/protocol/schema_fields_gen.mbt（生成后 moon fmt 定形）。
// 轨道基线外置 baselines.json（schema 名 + 三表计数；缺/坏/非法即红）；
// 三表互斥查重；-check 漂移还原后红（不留副作用）。
//
//   node scripts/moonbit/gen_protocol_fields/main.mts [-check] [-src P] [-out D] [-baselines P]
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../../internal/capi.mts";
import { emitWithMoonFmt, makeFail, parseFlags } from "../../internal/genio.mts";

export interface Baselines {
  expected_schema: string;
  expected_v01_fields: number;
  expected_reserved: number;
  expected_v02_fields: number;
}

export interface FieldsFile {
  schema: string;
  v01_payload_fields: string[];
  reserved_fields: string[];
  v02_payload_fields: string[];
}

function fatal(msg: string): never {
  return makeFail("gen_protocol_fields: ", 2)(msg);
}

const toLF = (b: Buffer): Buffer => Buffer.from(b.toString("latin1").replace(/\r\n/g, "\n"), "latin1");

export function loadBaselines(p: string): Baselines {
  let raw: Buffer;
  try {
    raw = fs.readFileSync(p);
  } catch (e) {
    throw new Error(`读基线 JSON 失败 ${p}: ${e instanceof Error ? e.message : String(e)}（基线已外置，勿在代码内重新硬编码）`);
  }
  let b: Baselines;
  try {
    b = JSON.parse(toLF(raw).toString("utf8")) as Baselines;
  } catch (e) {
    throw new Error(`基线 JSON 非法 ${p}: ${e instanceof Error ? e.message : String(e)}`);
  }
  if (
    typeof b.expected_schema !== "string" ||
    b.expected_schema === "" ||
    !(b.expected_v01_fields > 0) ||
    !(b.expected_reserved > 0) ||
    !(b.expected_v02_fields >= 0)
  ) {
    throw new Error(`基线 JSON 字段缺失/非法 ${p}（expected_schema/expected_v01_fields/expected_reserved/expected_v02_fields>=0）`);
  }
  return b;
}

export function validateFields(f: FieldsFile, base: Baselines): void {
  if (f.schema !== base.expected_schema) {
    throw new Error(
      `schema ${JSON.stringify(f.schema)} ≠ ${JSON.stringify(base.expected_schema)}——版本轨道变更，须人工评估（v0_2_activation_checklist 全流程；基线在 baselines.json）`
    );
  }
  if (f.v01_payload_fields.length !== base.expected_v01_fields) {
    throw new Error(
      `v01_payload_fields 数 ${f.v01_payload_fields.length} ≠ 基线 ${base.expected_v01_fields}——源已变更：字段表只增不改，请人工核对后更新 baselines.json 的 expected_v01_fields 并登记（v0.2 激活走 checklist）`
    );
  }
  if (f.reserved_fields.length !== base.expected_reserved) {
    throw new Error(
      `reserved_fields 数 ${f.reserved_fields.length} ≠ 基线 ${base.expected_reserved}——源已变更，请人工核对后更新 baselines.json 的 expected_reserved`
    );
  }
  if (f.v02_payload_fields.length !== base.expected_v02_fields) {
    throw new Error(
      `v02_payload_fields 数 ${f.v02_payload_fields.length} ≠ 基线 ${base.expected_v02_fields}——源已变更：激活表只增不改，请人工核对后更新 baselines.json 的 expected_v02_fields 并登记（#90 激活批次）`
    );
  }
  const seen = new Set<string>();
  for (const name of [...f.v01_payload_fields, ...f.reserved_fields, ...f.v02_payload_fields]) {
    if (seen.has(name)) throw new Error(`字段 ${JSON.stringify(name)} 在 v0.1 冻结表/预留位/v0.2 激活表间重复`);
    seen.add(name);
  }
}

export function render(f: FieldsFile, srcHash: string): string {
  const lines: string[] = [];
  const w = (s: string): void => {
    lines.push(s);
  };
  w("// @generated by scripts/moonbit/gen_protocol_fields —— 禁手改（git/diff 工具链按 @generated 识别；再生成：仓库根 go run ./scripts/moonbit/gen_protocol_fields）。");
  w("// 源：scripts/replay/v01_payload_fields.json（sha256/" + srcHash + "，行尾归一）");
  w("// 再生成：cd 仓库根 && go run ./scripts/moonbit/gen_protocol_fields（-check 幂等校验；CI 接线防漂移）");
  w("//");
  w("// StepPayload v0.1 字段白名单（生成期真单源——2026-09-27 用户审阅");
  w("// P2-2 落地：此前手写常量与 JSON 零联动，注入实验实锤假绿）。JSON");
  w("// 侧消费方：Go/Python replay 驱动（S5 断言判据）；本产物消费方：");
  w("// gateway serve 批键集合冻结断言 + schema_wbtest 硬编码第三份锚。");
  w("");
  w("///| StepPayload v0.1 顶层字段白名单（14 字段，顺序 = schema §字段表）。");
  w("///| 单源 = scripts/replay/v01_payload_fields.json（本文件为其生成物）。");
  w("pub fn step_payload_fields_v0_1() -> Array[String] {");
  w("  [");
  let line = "   ";
  f.v01_payload_fields.forEach((name, i) => {
    const item = `"${name}",`;
    if (i % 4 === 0 && i > 0) {
      w(line);
      line = "   ";
    }
    line += " " + item;
  });
  w(line);
  w("  ]");
  w("}");
  w("");
  w("///| v0.2 预留位字段（异常域，激活前不得出现在任何 payload 中）。");
  w("///| 单源 = v01_payload_fields.json 的 reserved_fields（本文件为其生成物）。");
  w("pub fn reserved_fields_v0_2() -> Array[String] {");
  w("  [" + f.reserved_fields.map((s) => `"${s}"`).join(",") + "]");
  w("}");
  w("");
  w("///| v0.2 已激活字段（#90 首批 = code_file；additive-only——v0.1 十四字段");
  w("///| 冻结不动，本表只收激活项）。消费方 = 协议版本对账/gateway 键集冻结断言");
  w("///| 的 v0.2 侧判据（v0.1 判据见 step_payload_fields_v0_1，两者并存不互斥）。");
  w("///| 单源 = v01_payload_fields.json 的 v02_payload_fields（本文件为其生成物）。");
  w("pub fn step_payload_fields_v0_2() -> Array[String] {");
  w("  [" + f.v02_payload_fields.map((s) => `"${s}"`).join(",") + "]");
  w("}");
  return lines.join("\n") + "\n";
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  const root = projectRoot();
  const moonbit = path.join(root, "moonbit");
  let srcPath = path.join(root, "scripts/replay/v01_payload_fields.json");
  let outDir = path.join(moonbit, "protocol");
  let baselinesPath = path.join(root, "scripts/moonbit/gen_protocol_fields/baselines.json");
  const args = parseFlags(
    process.argv.slice(2),
    { bool: ["-check", "--check"], value: ["-src", "-out", "-baselines"] },
    fatal,
  );
  if (args.rest.length > 0) fatal(`未知参数 ${args.rest[0] ?? ""}`);
  const check = args.has("-check", "--check");
  const srcArg = args.value("-src");
  if (srcArg !== undefined) srcPath = path.resolve(moonbit, srcArg);
  const outArg = args.value("-out");
  if (outArg !== undefined) outDir = path.resolve(moonbit, outArg);
  const baseArg = args.value("-baselines");
  if (baseArg !== undefined) baselinesPath = path.resolve(moonbit, baseArg);

  let base: Baselines;
  let f: FieldsFile;
  let gen: string;
  try {
    base = loadBaselines(baselinesPath);
    const src = fs.readFileSync(srcPath);
    const srcLF = toLF(src);
    const srcHash = crypto.createHash("sha256").update(srcLF).digest("hex").slice(0, 8);
    f = JSON.parse(srcLF.toString("utf8")) as FieldsFile;
    validateFields(f, base);
    gen = render(f, srcHash);
  } catch (e) {
    fatal(e instanceof Error ? e.message : String(e));
  }
  const outFile = path.join(outDir, "schema_fields_gen.mbt");
  emitWithMoonFmt({
    root,
    check,
    fail: fatal,
    driftHint: "JSON 单源已变更未再生成（cd 仓库根 && node scripts/moonbit/gen_protocol_fields/main.mts）",
    products: [{ rel: path.relative(moonbit, outFile), content: gen }],
  });
  if (check) console.log("gen_protocol_fields: check OK（产物与 JSON 单源一致，未漂移）");
}
