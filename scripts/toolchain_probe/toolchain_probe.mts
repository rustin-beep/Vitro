#!/usr/bin/env node
// toolchain_probe —— MoonBit 工具链健康探针（Go→.mts 重写，refs #273；原 178 行，E-06 窄增量）。
//
// 用法（仓库根）：node scripts/toolchain_probe/toolchain_probe.mts [--update-baseline]
//
// 背景（架构审阅 v2 A8 最薄弱项 + 用户窄增量裁定）：moon 工具链稳定性此前靠人工
// 盯——故障模式是「静默炸、事后读 CI 日志归因」。本探针把故障显式化（本地开发时
// 显式红），**不是包装 moon**，四项独立检查：
//
//  1. 版本锁定：moon/moonc 版本 vs 基线文件（toolchain_baseline.txt）——工具链
//     静默升级（registry/breaking）当日暴露；--update-baseline 迁移。
//  2. registry 索引预检：模拟 CI 实锤坑（ed4d4c4——全新安装的 moon 解析
//     moonbitlang/x 报 "module was not found in the registry"）：行为式判定
//     （moon update 成功 + 索引目录非空）。
//  3. 已知 ICE 特征识别：F8（moonc v0.10.13 跨文件顶层 pub let 的 link-core ICE）。
//  4. 异常退出码 fail loud：moon 退出码非 0 且不匹配已知特征 → 未知工具链故障。
//
// 纪律：零第三方依赖；规则外置（基线文件）；fail loud；禁静默 default。
//
// 迁移口径（#292 批）：默认模式与 Go 版 stdout/stderr/rc 逐字同形（parity 覆盖）；
// `--update-baseline` 是写盘通道（状态性），不进对拍。
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { pathToFileURL } from "node:url";

const RE_MOON_VER = /moon (\S+) \((\S+) (\S+)\)/g;
const RE_MOONC_VER = /(v\S+)/g;

class ExitErr extends Error {
  readonly code: number;
  constructor(code: number) {
    super("exit");
    this.name = "ExitErr";
    this.code = code;
  }
}

export function fatal(msg: string): never {
  process.stderr.write("toolchain_probe: " + msg + "\n");
  throw new ExitErr(2);
}

const errText = (e: unknown): string => (e instanceof Error ? e.message : String(e));

/** 跑外部命令，返回合并输出（stdout+stderr 顺序近似；Go CombinedOutput 同源）。 */
export function run(name: string, args: readonly string[], cwd?: string): string {
  const r = spawnSync(name, args, { cwd, encoding: "buffer", maxBuffer: 64 * 1024 * 1024 });
  const out = Buffer.concat([r.stdout ?? Buffer.alloc(0), r.stderr ?? Buffer.alloc(0)]);
  if (r.error !== undefined && out.length === 0) fatal(`${name} [${args.join(" ")}] 不可执行（PATH？）: ${r.error.message}`);
  return out.toString("utf8");
}

/** 基线文本 → 参与比较的行（CRLF 归一 + 剔除注释/空行）。 */
export function baselineLines(raw: string): string[] {
  const norm = raw.split("\r\n").join("\n").trim();
  const out: string[] = [];
  for (const l of norm.split("\n")) {
    const t = l.trim();
    if (t === "" || t.startsWith("#")) continue;
    out.push(t);
  }
  return out;
}

export function baselineMatches(baselineRaw: string, actual: string): boolean {
  return baselineLines(baselineRaw).join("\n") === baselineLines(actual).join("\n");
}

/** F8 link-core ICE 特征（core 符号未定义 / link-core / segfault + pub let）。 */
export function isKnownICE(out: string): boolean {
  return (
    out.includes("_ZN4moon") ||
    out.includes("link-core") ||
    (out.includes("segfault") && out.toLowerCase().includes("pub let"))
  );
}

export function runMain(argv: readonly string[]): number {
  try {
    return mainFlow(argv);
  } catch (e) {
    if (e instanceof ExitErr) return e.code;
    throw e;
  }
}

function mainFlow(argv: readonly string[]): number {
  const updateBaseline = argv.length > 0 && argv[0] === "--update-baseline";
  let fail = 0;

  // —— 1. 版本锁定 ——
  const moonVer = run("moon", ["version"]);
  const mooncVer = run("moonc", ["-v"]);
  const m = new RegExp(RE_MOON_VER.source).exec(moonVer);
  const c = new RegExp(RE_MOONC_VER.source).exec(mooncVer);
  if (m === null || c === null) {
    process.stdout.write("[红] 版本解析失败：moon/moonc 输出形态变更（工具链 breaking 的首要信号）\n");
    process.stdout.write(`  moon:  ${moonVer}\n`);
    process.stdout.write(`  moonc: ${mooncVer}\n`);
    return 1;
  }
  const baselinePath = path.join("scripts", "toolchain_baseline.txt");
  const want = `moon ${m[1]} (${m[2]} ${m[3]})\nmoonc ${c[1]}`;
  if (updateBaseline) {
    try {
      fs.writeFileSync(
        baselinePath,
        "# @generated by scripts/toolchain_probe --update-baseline —— 版本基线（日期随迁移更新）\n" + want + "\n",
        "utf8",
      );
    } catch (e) {
      fatal(`写基线失败: ${errText(e)}`);
    }
    process.stdout.write(`toolchain_probe: 基线已更新 → ${baselinePath}\n${want}\n`);
    return 0;
  }
  let got: string;
  try {
    got = fs.readFileSync(baselinePath, "utf8");
  } catch (e) {
    fatal(`基线缺失 ${baselinePath}（首建：node scripts/toolchain_probe/toolchain_probe.mts --update-baseline）: ${errText(e)}`);
  }
  const wantN = "# toolchain_probe 版本基线（--update-baseline 迁移；日期随迁移更新）\n" + want;
  if (!baselineMatches(got, wantN)) {
    process.stdout.write("[红] 工具链版本漂移（A8：静默升级当日显形）\n");
    process.stdout.write(`  基线: ${baselineLines(got).join(" | ")}\n  实测: ${baselineLines(wantN).join(" | ")}\n`);
    process.stdout.write("  处置：核对 changelog 后 --update-baseline 迁移，并跑全门禁\n");
    fail++;
  } else {
    process.stdout.write(`[绿] 版本锁定: moon ${m[1]} / moonc ${c[1]}\n`);
  }

  // —— 2. registry 索引预检（行为式：路径布局随版本漂移，行为不漂）——
  const home = os.homedir();
  const idxDir = path.join(home, ".moon", "registry", "index");
  const up = spawnSync("moon", ["update"], { encoding: "buffer", maxBuffer: 64 * 1024 * 1024 });
  const upOut = Buffer.concat([up.stdout ?? Buffer.alloc(0), up.stderr ?? Buffer.alloc(0)]).toString("utf8");
  let entries: string[] = [];
  try {
    entries = fs.readdirSync(idxDir);
  } catch {
    entries = [];
  }
  if (up.error !== undefined || (up.status ?? -1) !== 0 || entries.length === 0) {
    process.stdout.write("[红] registry 索引异常：moon update 失败或索引目录为空（CI 实锤坑 ed4d4c4 的前置形态）\n");
    if (up.error !== undefined || (up.status ?? -1) !== 0) {
      process.stdout.write(`  moon update: ${up.error?.message ?? `exit status ${up.status}`} | ${upOut}`);
    }
    fail++;
  } else {
    process.stdout.write(`[绿] registry 索引: moon update 行为通过（${entries.length} 顶层条目）\n`);
  }

  // —— 3. 探针编译（ICE 特征识别 + 退出码 fail loud）——
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "toolchain_probe_"));
  try {
    const nl = "\n";
    fs.writeFileSync(path.join(dir, "moon.mod"), 'name = "probe/ice"' + nl + nl + 'version = "0.1.0"' + nl, "utf8");
    fs.mkdirSync(path.join(dir, "src"), { recursive: true });
    fs.writeFileSync(path.join(dir, "src", "moon.pkg"), 'pkgtype(kind: "executable")' + nl, "utf8");
    fs.writeFileSync(path.join(dir, "src", "a.mbt"), "pub let g_probe = 42" + nl, "utf8");
    fs.writeFileSync(path.join(dir, "src", "main.mbt"), "fn main {" + nl + "  println(g_probe)" + nl + "}" + nl, "utf8");
    // moon.pkg 需 import 本包 a？同包多文件直接引用——顶层 pub let 跨文件即 F8 形状
    fs.writeFileSync(path.join(dir, "src", "moon.pkg"), 'pkgtype(kind: "executable")' + nl, "utf8");

    const chk = spawnSync("moon", ["check"], { cwd: dir, encoding: "buffer", maxBuffer: 64 * 1024 * 1024 });
    let combined = Buffer.concat([chk.stdout ?? Buffer.alloc(0), chk.stderr ?? Buffer.alloc(0)]).toString("utf8");
    if (chk.error !== undefined || (chk.status ?? -1) !== 0) {
      if (isKnownICE(combined)) {
        process.stdout.write("[红·已知 ICE] F8 link-core ICE 特征命中（moonc 跨文件顶层 pub let）\n");
        process.stdout.write("  定性：工具链缺陷非引擎缺陷——workaround 常量内联；A8 持续监控项\n");
      } else {
        process.stdout.write("[红·未知] moon check 异常退出（新 breaking 首先在此显形——人工定性）\n");
        if (combined.length > 600) combined = combined.slice(0, 600) + "…";
        const exitTxt = chk.error?.message ?? `exit status ${chk.status}`;
        process.stdout.write(`  exit: ${exitTxt}\n  out: ${combined}`);
      }
      fail++;
    } else {
      process.stdout.write("[绿] 探针编译: F8 形状（跨文件顶层 pub let）在当前工具链下存活\n");
    }
  } finally {
    fs.rmSync(dir, { recursive: true, force: true });
  }

  if (fail > 0) {
    process.stdout.write(`toolchain_probe: FAIL——${fail} 项红（工具链故障显式化，非引擎缺陷）\n`);
    return 1;
  }
  process.stdout.write("toolchain_probe: PASS（版本锁定 + 索引预检 + ICE 特征 + 退出码四项绿）\n");
  return 0;
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  process.exit(runMain(process.argv.slice(2)));
}
