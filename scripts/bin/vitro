#!/bin/sh
# vitro 统一入口 launcher（sh 形态，#49 批一；三后端批 2026-10-15 重设计）。
#
# 三臂（C 方案裁定：单壳三后端，真相源 = cmd/lib/cli 单源）：
#   --backend js     = moonbit/_build/js/release/build/cmd/vitro_js/vitro_js.js
#                      （MoonBit 壳直编 JS，node 直跑——CLI 默认臂；免 wasm
#                       实例化层。性能方向注（P3，2026-10-15 实测修正）：
#                       会话内 5 轮中位 js≈585ms / wasm≈546ms / native≈486ms
#                       ——wasm 臂略快 ~7%（任务书 §4 基线 1.262 vs 1.577 同向
#                       互证）；js 臂当选缺省的依据是零实例化层与更低 node
#                       门槛（无 js-string builtins 依赖），非性能）
#   --backend wasm   = scripts/vitro_cli/main.js 拉 gateway wasm-gc（旧 wasm 臂，
#                      浏览器分发同源产物；保留兼容 + demo 同源验证）
#   --backend native = cmd/vitro exe（防线基线臂——vm_diff/clang_direct 消费面）
# 缺省 = js；node 缺失/版本不足（rc=5 哨兵——#106：3 与步数超限撞号）降级 native（降级必 stderr 明示，
# 禁静默）。行为一致性由 vitro_cli_smoke 三臂对拍把守。
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
JS_ENTRY="$REPO/moonbit/_build/js/release/build/cmd/vitro_js/vitro_js.js"
WASM_SHELL="$REPO/scripts/vitro_cli/main.js"
NATIVE_EXE="$REPO/moonbit/_build/native/release/build/cmd/vitro/vitro.exe"

run_native() {
  reason="$1"
  shift
  # #100（2026-10-15）：缺产物前置 fail loud——旧形态 exec 裸撞 rc=127 +
  # shell 原文（command not found 类），无构建指引（node<25 降级路径高发：
  # js 臂不可用降级 native 而产物从未构建过）
  if [ ! -f "$NATIVE_EXE" ]; then
    echo "[vitro] native exe 缺失：$NATIVE_EXE" >&2
    echo "[vitro] 重建（Windows 下 MOON_CC=clang 必需——moon#2254 构建悬崖）：cd moonbit && MOON_CC=clang moon build --release --target native cmd/vitro" >&2
    exit 127
  fi
  # 新鲜度门禁 v2（2026-10-15 低危修复）：mtime 触发 + **内容指纹复核**。
  # v1 纯 mtime（find -newermt）与 moon 增量（内容指纹）判据不同——git
  # checkout/merge touch 源文件 mtime 但内容未变时假阳性大字告警（实测
  # moon 报 no work to do 而 launcher 告警陈旧）。v2 两级：mtime 晚于 exe
  # 先触发，再比对源指纹（moonbit/ 全部**非测试** .mbt 稳定序拼接的
  # sha256——*_test/_wbtest/README.mbt.md 不参与 exe 构建，含入会把「改
  # 测试不改源」误判陈旧）——内容未变静默放行（假阳性根除），内容真变
  # 才告警。exe 重建后（mtime 新于指纹文件）自动重记基准。cmd 版
  # （vitro.cmd）无此门禁（仅产物存在检查），指纹逻辑单源在本 sh 版。
  FP_FILE="$REPO/moonbit/_build/.vitro_native_src.fp"
  fp_of_sources() {
    find "$REPO/moonbit" -type d \( -name '_build' -o -name '.mooncakes' \) -prune -o -type f -name '*.mbt' ! -name '*_test.mbt' ! -name '*_wbtest.mbt' ! -name 'README.mbt.md' -print0 2>/dev/null \
      | sort -z | xargs -0 cat 2>/dev/null | sha256sum | cut -c1-16
  }
  exe_mtime=$(cd "$(dirname "$NATIVE_EXE")" && ls -l --time-style=+%s "$(basename "$NATIVE_EXE")" 2>/dev/null | awk '{print $6}')
  if [ -n "$exe_mtime" ]; then
    # 陈旧检测面 = moonbit/ 全部非测试 .mbt（#57-2：原七目录枚举漏 gateway/
    # time_travel/teaching/protocol/session/memory/diag/ast/util 九包——
    # #35 排障时改 serve_step/engine 零告警连环假阴性；剪枝 _build 与
    # .mooncakes，新包零维护自动入面）
    newer_src=$(find "$REPO/moonbit" -type d \( -name '_build' -o -name '.mooncakes' \) -prune -o -type f -name '*.mbt' ! -name '*_test.mbt' ! -name '*_wbtest.mbt' ! -name 'README.mbt.md' -newermt "@$exe_mtime" -print 2>/dev/null | head -1)
    if [ -n "$newer_src" ]; then
      fp_mtime=""
      if [ -f "$FP_FILE" ]; then
        fp_mtime=$(cd "$(dirname "$FP_FILE")" && ls -l --time-style=+%s "$(basename "$FP_FILE")" 2>/dev/null | awk '{print $6}')
      fi
      if [ -z "$fp_mtime" ] || [ "$fp_mtime" -lt "$exe_mtime" ]; then
        # 指纹缺失或 exe 已重建（晚于上次记录）——重记基准后静默
        fp_of_sources > "$FP_FILE"
      else
        cur_fp=$(fp_of_sources)
        old_fp=$(cat "$FP_FILE" 2>/dev/null)
        if [ "$cur_fp" != "$old_fp" ]; then
          echo "[vitro] ⚠ native exe 陈旧（源内容已变：${newer_src##*/} 等）——结论可能来自旧代码；重建：cd moonbit && MOON_CC=clang moon build --release --target native cmd/vitro" >&2
        fi
        # 内容未变（mtime 假阳性）——静默放行
      fi
    fi
  fi
  echo "[vitro] backend=native（$reason）" >&2
  exec "$NATIVE_EXE" "$@"
}

run_js() {
  reason="$1"
  shift
  echo "[vitro] backend=js（$reason）" >&2
  exec node "$JS_ENTRY" "$@"
}

run_wasm() {
  echo "[vitro] backend=wasm（node 拉 gateway wasm-gc）" >&2
  "$NODE_BIN" "$WASM_SHELL" "$@"
  rc=$?
  if [ $rc -eq 5 ]; then
    run_native "node 版本不足（壳 rc=5 哨兵）" "$@"
  fi
  exit $rc
}

# --backend 覆盖（首参位；剥掉后透传）
if [ "$1" = "--backend" ] && [ -n "$2" ]; then
  if [ "$2" = "native" ]; then
    shift 2
    run_native "--backend 显式指定" "$@"
  elif [ "$2" = "js" ]; then
    shift 2
    run_js "--backend 显式指定" "$@"
  elif [ "$2" = "wasm" ]; then
    shift 2
    # 落到下方 wasm 流程（需 node 检测）
    NODE_BIN="$(command -v node 2>/dev/null)"
    if [ -z "$NODE_BIN" ]; then
      run_native "node 不在 PATH" "$@"
    fi
    run_wasm "$@"
  fi
fi

# #70（2026-10-11）：--backend 尾置 fail loud——此前静默忽略（仅认 $1/$2
# 位），尾置透传给子命令被当普通参数吞掉，曾致「native 复测」实跑 wasm
# （#64 定责轮的方法错误根源）。rc=4 对齐协议用法错。
for a in "$@"; do
  if [ "$a" = "--backend" ]; then
    echo "[vitro] 用法错: --backend 须紧随 vitro（如 vitro --backend native run …）——尾置会被子命令吞掉" >&2
    exit 4
  fi
done

# 缺省臂 = js（node 前置检测；缺失/异常降级 native——降级明示）
NODE_BIN="$(command -v node 2>/dev/null)"
if [ -z "$NODE_BIN" ]; then
  run_native "node 不在 PATH（js 臂不可用）" "$@"
fi
if [ ! -f "$JS_ENTRY" ]; then
  run_native "js 入口产物不存在（$JS_ENTRY——构建：cd moonbit && moon build --release --target js cmd/vitro_js）" "$@"
fi
run_js "缺省臂" "$@"
