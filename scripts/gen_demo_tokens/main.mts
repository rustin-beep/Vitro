#!/usr/bin/env node
// gen_demo_tokens：demo 主题 token 单源发射器（Go→.mts 重写，refs #273；原 P0 契约批 2026-10-21 / #222）。
//
// 真源：demo/tokens.json（W3C DTCG 子集——每个 token = {$value, $type}；
// 顶层 base / themeOrder+themes[colorScheme,tokens] / sizes 三组）。
// 产物：demo/src/tokens.css（入库，@generated 头，禁手改）。
//
// 为什么是「入库 + -check」形态（vitro-generator-contract §两种产物形态）：
// 产物被 app.css `@import` 直接消费、且需要 git 里的单源可审阅——发射形态
// 会让「主题色板改了什么」在 review 里消失，故选入库 + 字节比对。
//
// 契约（与 Go 版逐条对应）：
//   - flag 包（-check / -selftest / -src / -out），禁手工扫 argv；
//   - 输出确定性：base → themeOrder 逐主题（JSON 数组定序，不依赖 map 序）→
//     sizes 按数值序；块内 token 按变量名排序（同名不重复 ⇒ 语义无关）；
//   - 行尾归一化后再比对（CRLF 假红）；
//   - -check 无副作用：内存生成比对，不写盘、不改产物；
//   - 完备性断言（fail loud）：主题集 = themeOrder 集、colorScheme ∈ {light,dark}、
//     token 名一律 --vr- 前缀、$value 非空、products 首项 = 产物路径、
//     generatedBy 必须是本工具（防真源被别的工具接管而闸空转）；
//   - 未知字段一律拒绝（Go DisallowUnknownFields 口径）——JSON 里写错的键
//     不允许静默忽略。
//
// 用法（仓库根）：
//   node scripts/gen_demo_tokens/main.mts            # 生成
//   node scripts/gen_demo_tokens/main.mts -check     # 比对（CI 形态）
//   node scripts/gen_demo_tokens/main.mts -selftest  # J9 内存注入证红
import fs from "node:fs";
import path from "node:path";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../internal/capi.mts";

export const GEN_PATH = "scripts/gen_demo_tokens";
export const HEADER = `/* @generated by ${GEN_PATH} —— 禁手改（真源：demo/tokens.json） */`;
export const SCHEMA_URI = "https://design-tokens.github.io/community-group/format/";

export interface Token {
  $value: string;
  $type: string;
}

export interface TokenGroup {
  tokens: Record<string, Token>;
}

export interface Theme {
  colorScheme: string;
  tokens: Record<string, Token>;
}

export interface TokensDoc {
  $schema: string;
  $description: string;
  generatedBy: string;
  products: string[];
  base: TokenGroup;
  themeOrder: string[];
  themes: Record<string, Theme>;
  sizes: Record<string, TokenGroup>;
}

function die(msg: string): never {
  process.stderr.write(`${GEN_PATH}: ${msg}\n`);
  process.exit(1);
}

/** 允许的键（逐层，对齐 Go 的 DisallowUnknownFields）。 */
const KEYS_DOC = ["$schema", "$description", "generatedBy", "products", "base", "themeOrder", "themes", "sizes"];
const KEYS_GROUP = ["tokens"];
const KEYS_THEME = ["colorScheme", "tokens"];
const KEYS_TOKEN = ["$value", "$type"];

/** 未知键校验：Go 的 DisallowUnknownFields 在解析期逐个 struct 层拒绝。 */
export function assertKnownKeys(obj: unknown, allowed: string[], where: string): void {
  if (obj === null || typeof obj !== "object" || Array.isArray(obj)) {
    die(`解析失败: ${where} 必须是对象`);
  }
  for (const k of Object.keys(obj as Record<string, unknown>)) {
    if (!allowed.includes(k)) die(`解析失败: ${where} 含未知字段 ${JSON.stringify(k)}（DisallowUnknownFields 口径）`);
  }
}

function isRecord(v: unknown): v is Record<string, unknown> {
  return v !== null && typeof v === "object" && !Array.isArray(v);
}

function asStr(v: unknown, where: string): string {
  if (typeof v !== "string") die(`解析失败: ${where} 必须是字符串`);
  return v;
}

/** 收 token 组（校验 $value/$type 都是字符串）。 */
function parseGroup(raw: unknown, where: string): TokenGroup {
  assertKnownKeys(raw, KEYS_GROUP, where);
  const toks = (raw as { tokens?: unknown }).tokens;
  if (!isRecord(toks)) die(`解析失败: ${where}.tokens 必须是对象`);
  const out: Record<string, Token> = {};
  for (const [name, v] of Object.entries(toks)) {
    assertKnownKeys(v, KEYS_TOKEN, `${where}.tokens.${name}`);
    out[name] = {
      $value: asStr((v as Record<string, unknown>)["$value"], `${where}.tokens.${name}.$value`),
      $type: asStr((v as Record<string, unknown>)["$type"], `${where}.tokens.${name}.$type`),
    };
  }
  return { tokens: out };
}

/** load：解析 + 完备性断言（任何一条不成立即红——产物宁可不出，不留半套 token）。 */
export function load(p: string): TokensDoc {
  let raw: string;
  try {
    raw = fs.readFileSync(p, "utf8");
  } catch (e) {
    die(`读真源失败 ${p}: ${e instanceof Error ? e.message : String(e)}`);
  }
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw.replace(/\r\n/g, "\n"));
  } catch (e) {
    die(`解析 ${p} 失败: ${e instanceof Error ? e.message : String(e)}`);
  }
  assertKnownKeys(parsed, KEYS_DOC, "顶层");
  const top = parsed as Record<string, unknown>;

  const base = parseGroup(top["base"], "base");
  const sizesRaw = top["sizes"];
  if (!isRecord(sizesRaw)) die("解析失败: sizes 必须是对象");
  const sizes: Record<string, TokenGroup> = {};
  for (const [k, g] of Object.entries(sizesRaw)) sizes[k] = parseGroup(g, `sizes.${k}`);

  const themesRaw = top["themes"];
  if (!isRecord(themesRaw)) die("解析失败: themes 必须是对象");
  const themes: Record<string, Theme> = {};
  for (const [k, v] of Object.entries(themesRaw)) {
    assertKnownKeys(v, KEYS_THEME, `themes.${k}`);
    themes[k] = {
      colorScheme: asStr((v as Record<string, unknown>)["colorScheme"], `themes.${k}.colorScheme`),
      tokens: parseGroup({ tokens: (v as Record<string, unknown>)["tokens"] }, `themes.${k}`).tokens,
    };
  }

  const themeOrderRaw = top["themeOrder"];
  if (!Array.isArray(themeOrderRaw)) die("解析失败: themeOrder 必须是数组");
  const doc: TokensDoc = {
    $schema: asStr(top["$schema"], "$schema"),
    $description: asStr(top["$description"], "$description"),
    generatedBy: asStr(top["generatedBy"], "generatedBy"),
    products: (top["products"] as unknown[] | undefined)?.map((x, i) => asStr(x, `products[${i}]`)) ?? [],
    base,
    themeOrder: themeOrderRaw.map((x, i) => asStr(x, `themeOrder[${i}]`)),
    themes,
    sizes,
  };
  validate(doc);
  return doc;
}

/** 完备性断言（与 Go 版 load 内的检查一一对应）。 */
export function validate(doc: TokensDoc): void {
  if (doc.$schema !== SCHEMA_URI) die(`$schema 必须是 "${SCHEMA_URI}"（当前 "${doc.$schema}"）`);
  if (doc.generatedBy !== GEN_PATH) {
    die(`generatedBy 必须是 "${GEN_PATH}"（当前 "${doc.generatedBy}"）——真源被别的工具接管时本闸必须红`);
  }
  if (doc.products.length === 0 || doc.products[0] !== "demo/src/tokens.css") {
    die(`products 首项必须是 demo/src/tokens.css（当前 [${doc.products.join(" ")}]）`);
  }
  if (Object.keys(doc.base.tokens).length === 0) die("base.tokens 为空");
  if (doc.themeOrder.length === 0) die("themeOrder 为空");
  const seen = new Set<string>();
  for (const k of doc.themeOrder) {
    if (seen.has(k)) die(`themeOrder 重复：${k}`);
    seen.add(k);
    if (doc.themes[k] === undefined) die(`themeOrder 列了 "${k}" 但 themes 里没有`);
  }
  if (seen.size !== Object.keys(doc.themes).length) {
    die(`themes 里有 ${Object.keys(doc.themes).length} 个主题，themeOrder 只列了 ${seen.size} 个（漏列即输出不确定）`);
  }
  const checkTokens = (where: string, toks: Record<string, Token>): void => {
    if (Object.keys(toks).length === 0) die(`${where} 没有 token`);
    for (const [name, t] of Object.entries(toks)) {
      if (!name.startsWith("--vr-")) die(`${where} 的 token 名 "${name}" 不是 --vr- 前缀（消费面只认 CSS 变量）`);
      if (t.$value.trim() === "") die(`${where} 的 ${name} 没有 $value`);
      if (t.$type.trim() === "") die(`${where} 的 ${name} 没有 $type（DTCG 子集要求显式类型）`);
    }
  };
  checkTokens("base", doc.base.tokens);
  for (const k of doc.themeOrder) {
    const th = doc.themes[k]!;
    if (th.colorScheme !== "light" && th.colorScheme !== "dark") {
      die(`主题 ${k} 的 colorScheme 必须是 light/dark（当前 "${th.colorScheme}"）`);
    }
    checkTokens("themes." + k, th.tokens);
  }
  if (Object.keys(doc.sizes).length === 0) die("sizes 为空");
  for (const [k, g] of Object.entries(doc.sizes)) {
    if (!/^-?\d+$/.test(k)) die(`sizes 的档位键必须是整数（当前 "${k}"）`);
    checkTokens(`sizes.${k}`, g.tokens);
  }
}

/** 字节序名字排序（Go sort.Strings 口径）。 */
export function sortedNames(toks: Record<string, Token>): string[] {
  return Object.keys(toks).sort((a, b) => Buffer.compare(Buffer.from(a, "utf8"), Buffer.from(b, "utf8")));
}

/** 档位按数值升序（Go sort.Slice + Atoi）。 */
export function sortedSizes(m: Record<string, TokenGroup>): string[] {
  return Object.keys(m).sort((a, b) => Number.parseInt(a, 10) - Number.parseInt(b, 10));
}

function writeBlock(b: string[], sel: string, scheme: string, toks: Record<string, Token>): void {
  b.push(`${sel} {\n`);
  if (scheme !== "") b.push(`  color-scheme: ${scheme};\n`);
  for (const n of sortedNames(toks)) b.push(`  ${n}: ${toks[n]!.$value};\n`);
  b.push("}\n");
}

/** render：确定性输出（同输入必同字节）。块间空一行，文件以单换行结尾。 */
export function render(doc: TokensDoc): string {
  const b: string[] = [];
  b.push(HEADER + "\n");
  b.push("/* 语义：base = 字体/尺寸/动效基座；themes = 五主题色板（color-scheme 随主题）；sizes = 字号档 */\n\n");
  writeBlock(b, ":root", "", doc.base.tokens);
  b.push("\n");
  for (const k of doc.themeOrder) {
    const th = doc.themes[k]!;
    // Go 的 %q 对 ASCII 主题名 = JSON.stringify（双引号 + 转义）
    writeBlock(b, `:root[data-theme=${JSON.stringify(k)}]`, th.colorScheme, th.tokens);
    b.push("\n");
  }
  const sizes = sortedSizes(doc.sizes);
  sizes.forEach((k, i) => {
    writeBlock(b, `:root[data-size=${JSON.stringify(k)}]`, "", doc.sizes[k]!.tokens);
    if (i < sizes.length - 1) b.push("\n");
  });
  return b.join("");
}

/** diffHint：第一处差异的行号与两侧内容（-check 红时给人看的定位信息）。 */
export function diffHint(want: string, got: string): string {
  const w = want.split("\n");
  const g = got.split("\n");
  for (let i = 0; i < w.length && i < g.length; i++) {
    if (w[i] !== g[i]) {
      return `第 ${i + 1} 行起不一致：\n  期望: ${w[i]}\n  实际: ${g[i]}`;
    }
  }
  if (w.length !== g.length) return `行数不一致：期望 ${w.length} 行，实际 ${g.length} 行`;
  return "内容一致（不应走到这里）";
}

/**
 * verify 是 -check 的唯一判定点。-selftest 直接调用它（审查 P2-4：旧 selftest
 * 只检查 diffHint 里有没有注入串，把 `got != want` 改成恒假仍能绿——自证面
 * 与判定面脱节）。统一后 selftest 证明「判定函数对篡改输入必红」。
 */
export function verify(out: string, want: string, got: string): Error | null {
  const norm = got.replace(/\r\n/g, "\n");
  if (norm === want) return null;
  return new Error(`${GEN_PATH}: 产物漂移 ${out} ← 真源 demo/tokens.json\n${diffHint(want, norm)}`);
}

export function check(doc: TokensDoc, out: string): void {
  const want = render(doc);
  let raw: string;
  try {
    raw = fs.readFileSync(out, "utf8");
  } catch (e) {
    die(`-check 读产物失败 ${out}: ${e instanceof Error ? e.message : String(e)}（先跑一次生成）`);
  }
  const err = verify(out, want, raw);
  if (err !== null) {
    process.stderr.write(err.message + "\n");
    process.stderr.write(`修复：node ${GEN_PATH}/main.mts\n`);
    process.exit(1);
  }
  process.stdout.write(`${GEN_PATH}: -check 通过（${out} ≡ demo/tokens.json）\n`);
}

/**
 * selftest：J9 埋雷义务的内存形态——同集必须绿、篡改必须红且定位可见。
 * 直接走 verify（不是复述 diffHint），判定面空转即自证红。
 */
export function selftest(doc: TokensDoc, out: string): void {
  const want = render(doc);
  const same = verify(out, want, want);
  if (same !== null) die(`-selftest 同集应绿，实际红：${same.message}`);
  const tampered = want.replace("--vr-fs:", "--vr-fs-TAMPERED:");
  if (tampered === want) die("-selftest 注入失败：真源里没有 --vr-fs，注入面失效");
  const err = verify(out, want, tampered);
  if (err === null) die("-selftest 判定空转：篡改后 verify 仍绿（-check 比对面失效）");
  if (!err.message.includes("TAMPERED")) die(`-selftest 注入未体现在 diffHint（定位面失能）：${err.message}`);
  process.stdout.write(`${GEN_PATH}: -selftest 通过（同集绿 + 篡改 --vr-fs → verify 判红且定位可见）\n`);
}

export function main(argv: string[]): number {
  let checkMode = false;
  let selftestMode = false;
  let src = "demo/tokens.json";
  let out = "demo/src/tokens.css";
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i] ?? "";
    const eq = a.indexOf("=");
    const flag = eq >= 0 ? a.slice(0, eq) : a;
    const val = (): string => {
      const v = eq >= 0 ? a.slice(eq + 1) : argv[++i];
      if (v === undefined) {
        process.stderr.write(`${GEN_PATH}: ${flag} 缺值\n`);
        process.exit(2);
      }
      return v;
    };
    if (flag === "-check" || flag === "--check") {
      if (eq >= 0) {
        process.stderr.write(`${GEN_PATH}: 布尔 flag ${flag} 不接受值\n`);
        return 2;
      }
      checkMode = true;
    } else if (flag === "-selftest" || flag === "--selftest") {
      if (eq >= 0) {
        process.stderr.write(`${GEN_PATH}: 布尔 flag ${flag} 不接受值\n`);
        return 2;
      }
      selftestMode = true;
    } else if (flag === "-src" || flag === "--src") src = val();
    else if (flag === "-out" || flag === "--out") out = val();
    else {
      // 用法错 = exit 2（Go flag 包同口径），与判定红的 1 分流
      process.stderr.write(`${GEN_PATH}: 未知参数 ${JSON.stringify(a)}\n`);
      return 2;
    }
  }
  const root = projectRoot();
  const absSrc = path.isAbsolute(src) ? src : path.join(root, src);
  const absOut = path.isAbsolute(out) ? out : path.join(root, out);
  const doc = load(absSrc);
  if (selftestMode) {
    selftest(doc, out);
    return 0;
  }
  if (checkMode) {
    check(doc, out);
    return 0;
  }
  try {
    fs.writeFileSync(absOut, render(doc));
  } catch (e) {
    die(`写产物失败 ${out}: ${e instanceof Error ? e.message : String(e)}`);
  }
  process.stdout.write(
    `${GEN_PATH}: 已生成 ${out}（${doc.themeOrder.length} 主题 / ${Object.keys(doc.sizes).length} 字号档）\n`,
  );
  return 0;
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  process.exit(main(process.argv.slice(2)));
}
