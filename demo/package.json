{
  "name": "vitro-demo",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Vitro 引擎浏览器单页 demo（TS 源 + tsc 原地发射；发射产物不入库，与 wasm.wasm 对称）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./tsconfig.pilot.json",
    "lint": "oxlint src/",
    "dev": "tsc -p tsconfig.json --watch",
    "pilot:dev": "vite",
    "pilot:build": "vite build",
    "pilot:check": "svelte-check --tsconfig ./tsconfig.pilot.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^25.9.9",
    "oxlint": "1.88.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "^5.9.3",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14"
  }
}
