#!/usr/bin/env node
// gen_style：风格包（StylePack）MoonBit 单源发射器（2026-11-14 批 A，refs #470 v0.1.1 前置）。
//
// 真源：moonbit/style/tokens.json（W3C DTCG 子集，与 demo 主题同源同值）。
// 产物：moonbit/style/style_gen.mbt（入库，@generated 头，禁手改）。
//
// 与 scripts/gen_demo_tokens 的分工：同一份真源、两个消费面——CSS 产物归
// gen_demo_tokens（demo 主题变量），MoonBit 数据面归本工具（引擎侧 StylePack：
// MCP 参考后端内嵌 CSS、后续宿主读同一份）。真源解析复用 `load()`，保证两个
// 生成器的完备性断言（未知字段 / 前缀 / 主题集 / 档位键）不会分叉。
//
// 契约（照 gen_demo_tokens）：
//   - flag 包（-check / -selftest / -src / -mbt-out），禁手工扫 argv；
//   - 输出确定性：base → themeOrder 逐主题 → sizes 数值序，块内按名字字节序；
//   - digest 绑定：产物头部写 sha256(tokens.json 字节)，-check 同时验产物与 digest；
//   - 行尾归一化后再比对（CRLF 假红）；
//   - -check 无副作用：内存生成比对，不写盘、不改产物。
//
// 用法（仓库根）：
//   node scripts/gen_style/main.mts            # 生成
//   node scripts/gen_style/main.mts -check     # 比对（CI 形态）
//   node scripts/gen_style/main.mts -selftest  # J9 篡改证红
//
// 批 E（2026-11-14）：第二产物 = style_css_golden_wbtest.mbt——`css_text()`
// ↔ `demo/src/tokens.css` 全等闸（refs #470）。golden 由 gen_demo_tokens.render
// 去掉头部两行注释+空行后的正文生成；两条独立发射路径
// （MoonBit write_block / Node writeBlock）对同一真源必须逐字节一致。
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../internal/capi.mts";
import {
  load,
  sortedNames,
  sortedSizes,
  diffHint,
  render as renderCss,
  type Token,
  type TokensDoc,
} from "../gen_demo_tokens/main.mts";

export const GEN_PATH = "scripts/gen_style";
export const HEADER = `// @generated by ${GEN_PATH} —— 禁手改（真源 = moonbit/style/tokens.json）。`;
export const GOLDEN_PATH = "moonbit/style/style_css_golden_wbtest.mbt";

function die(msg: string): never {
  process.stderr.write(`${GEN_PATH}: ${msg}\n`);
  process.exit(1);
}

/** MoonBit 字符串字面量（与 JSON 转义不同：控制字符用 \u{..}）。 */
export function mbtStr(s: string): string {
  let out = '"';
  for (const ch of s) {
    const c = ch.codePointAt(0) ?? 0;
    if (ch === '"') out += '\\"';
    else if (ch === "\\") out += "\\\\";
    else if (ch === "\n") out += "\\n";
    else if (ch === "\r") out += "\\r";
    else if (ch === "\t") out += "\\t";
    else if (c < 0x20) out += "\\u{" + c.toString(16) + "}";
    else out += ch;
  }
  return out + '"';
}

/** fmt 折行阈值（moon fmt 0.1.20261104 实测：单行 ≤80 字符保持，>80 折成
 * `(\n  a, b,\n)`；升级 fmt 若改阈值，本常量与产物需同步重标）。 */
export const FMT_WIDTH = 80;

/** 一条元组（自动套 fmt 稳定形态；按 UTF-16 宽度计，当前 token 值全 ASCII）。 */
export function tupleLine(name: string, value: string, indent: string): string {
  const one = `${indent}(${mbtStr(name)}, ${mbtStr(value)}),`;
  if (one.length <= FMT_WIDTH) return one;
  return `${indent}(\n${indent}  ${mbtStr(name)}, ${mbtStr(value)},\n${indent}),`;
}

/** 槽表逐行（缩进由调用方给），名字字节序。 */
function slotLines(toks: Record<string, Token>, indent: string): string[] {
  return sortedNames(toks).map((n) => tupleLine(n, toks[n]!.$value, indent));
}

/** render：确定性输出（同输入必同字节，文件以单换行结尾）。 */
export function render(doc: TokensDoc, digest: string): string {
  const b: string[] = [];
  b.push(HEADER + "\n");
  b.push("// 风格包资产 MoonBit 单源（ViewDoc 内置统一风格数据面）：五主题 × 语义槽 + 基座 + 字号档。\n");
  b.push("// CSS 侧同源产物 = demo/src/tokens.css（scripts/gen_demo_tokens 发射，两产物逐值等价）。\n");
  b.push(`// digest sha256:${digest}\n\n`);

  b.push("///|\n");
  b.push("/// 风格包（五套动画皮肤之一）：主题 id + color-scheme + 语义槽表（按名排序）。\n");
  b.push("pub(all) struct StylePack {\n");
  b.push("  id : String\n");
  b.push("  scheme : String\n");
  b.push("  slots : Array[(String, String)]\n");
  b.push("}\n\n");

  b.push("///|\n");
  b.push("/// 基座 token（字体 / 字号 / 圆角 / 时长 / 缓动；按名排序）。\n");
  b.push("let style_base_table : Array[(String, String)] = [\n");
  for (const line of slotLines(doc.base.tokens, "  ")) b.push(line + "\n");
  b.push("]\n\n");

  b.push("///|\n");
  b.push("/// 五套风格包（themeOrder 定序）。\n");
  b.push("let style_pack_table : Array[StylePack] = [\n");
  for (const k of doc.themeOrder) {
    const th = doc.themes[k]!;
    b.push("  {\n");
    b.push(`    id: ${mbtStr(k)},\n`);
    b.push(`    scheme: ${mbtStr(th.colorScheme)},\n`);
    b.push("    slots: [\n");
    for (const line of slotLines(th.tokens, "      ")) b.push(line + "\n");
    b.push("    ],\n");
    b.push("  },\n");
  }
  b.push("]\n\n");

  const sizes = sortedSizes(doc.sizes);
  b.push("///|\n");
  b.push("/// 字号档（数值升序）。\n");
  b.push("let style_size_table : Array[(String, Array[(String, String)])] = [\n");
  for (const k of sizes) {
    const toks = doc.sizes[k]!.tokens;
    const inner = sortedNames(toks)
      .map((n) => `(${mbtStr(n)}, ${mbtStr(toks[n]!.$value)})`)
      .join(", ");
    const one = `  (${mbtStr(k)}, [${inner}]),`;
    if (one.length <= FMT_WIDTH) {
      b.push(one + "\n");
    } else {
      b.push(`  (${mbtStr(k)}, [\n`);
      for (const line of slotLines(toks, "    ")) b.push(line + "\n");
      b.push("  ]),\n");
    }
  }
  b.push("]\n\n");

  b.push("///|\n");
  b.push("/// 全量风格包（themeOrder 定序；调用方只读）。\n");
  b.push("pub fn style_packs() -> Array[StylePack] {\n  style_pack_table\n}\n\n");

  b.push("///|\n");
  b.push("/// 基座 token（按名排序）。\n");
  b.push("pub fn style_base() -> Array[(String, String)] {\n  style_base_table\n}\n\n");

  b.push("///|\n");
  b.push("/// 字号档（数值升序）。\n");
  b.push("pub fn style_sizes() -> Array[(String, Array[(String, String)])] {\n  style_size_table\n}\n\n");

  b.push("///|\n");
  b.push("/// 真源 digest（tokens.json 字节的 sha256；与 CSS 产物同源凭证）。\n");
  b.push(`pub fn style_digest() -> String {\n  "sha256:${digest}"\n}\n`);
  return b.join("");
}

/** 真源字节的 sha256（hex）。 */
export function digestOf(absSrc: string): string {
  return crypto.createHash("sha256").update(fs.readFileSync(absSrc)).digest("hex");
}

/** tokens.css 正文（去头部两行注释+空行）——css_text() 的期望值。
 *  头部形状由 gen_demo_tokens.render 固定（HEADER + 语义注释 + 空行），
 *  两侧同时改才合法（-check 会先在 tokens.css 侧红，见 gen_demo_tokens 闸）。 */
export function cssBody(doc: TokensDoc): string {
  const full = renderCss(doc).replace(/\r\n/g, "\n");
  return full.split("\n").slice(3).join("\n");
}

/** 第二产物：css_text() ↔ tokens.css 全等闸（generated test 文件）。 */
export function renderGolden(doc: TokensDoc, digest: string): string {
  const b: string[] = [];
  b.push(HEADER + "\n");
  b.push("// css_text() ↔ demo/src/tokens.css 全等闸（批 E，refs #470）：\n");
  b.push("// golden = gen_demo_tokens.render 去掉头部两行注释+空行后的正文。\n");
  b.push(`// digest sha256:${digest}\n\n`);
  b.push("///|\n");
  b.push("/// tokens.css 正文 golden（@generated；禁手改）。\n");
  b.push(`let css_text_golden : String = ${mbtStr(cssBody(doc))}\n\n`);
  b.push("///|\n");
  b.push("test \"css_text_equals_tokens_css_body\" {\n");
  b.push("  assert_eq(\n");
  b.push("    css_text(),\n");
  b.push("    css_text_golden,\n");
  b.push("    msg=\"css_text 与 tokens.css 正文漂移（重跑 gen_style；两发射器同源必等价）\",\n");
  b.push("  )\n");
  b.push("}\n");
  return b.join("");
}

/** verify 是 -check 的唯一判定点；-selftest 直接调用它证红。 */
export function verify(out: string, want: string, got: string): Error | null {
  const norm = got.replace(/\r\n/g, "\n");
  if (norm === want) return null;
  return new Error(`${GEN_PATH}: 产物漂移 ${out} ← 真源 moonbit/style/tokens.json\n${diffHint(want, norm)}`);
}

export function check(
  doc: TokensDoc,
  digest: string,
  out: string,
  goldenOut: string,
): void {
  // 同 gen_demo_tokens：spawn 从任意 cwd 调用时产物仍按项目根解析。
  const checkOne = (rel: string, want: string): void => {
    const absOut = path.isAbsolute(rel) ? rel : path.join(projectRoot(), rel);
    let raw: string;
    try {
      raw = fs.readFileSync(absOut, "utf8");
    } catch (e) {
      die(`-check 读产物失败 ${rel}: ${e instanceof Error ? e.message : String(e)}（先跑一次生成）`);
    }
    const err = verify(rel, want, raw);
    if (err) die(err.message);
    if (!raw.includes(`digest sha256:${digest}`)) {
      die(`-check digest 不符：真源已变但产物未重生成（${rel}）`);
    }
    process.stdout.write(`${GEN_PATH}: -check 通过（${rel} ≡ moonbit/style/tokens.json）\n`);
  };
  checkOne(out, render(doc, digest));
  checkOne(goldenOut, renderGolden(doc, digest));
}

/** J9：篡改产物必红（证明判定面与自证面同一）。 */
export function selftest(
  doc: TokensDoc,
  digest: string,
  out: string,
  goldenOut: string,
): void {
  const want = render(doc, digest);
  if (verify(out, want, want) !== null) die("-selftest 同集应绿却判红");
  const tampered = want.replace('("--vr-fs", "14px")', '("--vr-fs", "99px")');
  if (tampered === want) die("-selftest 注入点失效（--vr-fs 值变了？）");
  const err = verify(out, want, tampered);
  if (err === null) die("-selftest 篡改应红却判绿");
  // 第二产物（tokens.css golden）同款 J9：注入 CSS 值篡改必红
  const gwant = renderGolden(doc, digest);
  const gtampered = gwant.replace("--vr-fs: 14px;", "--vr-fs: 99px;");
  if (gtampered === gwant) die("-selftest golden 注入点失效（--vr-fs: 14px 不在了？）");
  if (verify(goldenOut, gwant, gtampered) === null) {
    die("-selftest golden 篡改应红却判绿");
  }
  process.stdout.write(
    `${GEN_PATH}: -selftest 通过（同集绿 + 篡改 --vr-fs → 两产物 verify 均判红且定位可见）\n`,
  );
}

export function main(argv: string[]): number {
  let checkMode = false;
  let selftestMode = false;
  let src = "moonbit/style/tokens.json";
  let out = "moonbit/style/style_gen.mbt";
  let goldenOut = GOLDEN_PATH;
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i] ?? "";
    const eq = a.indexOf("=");
    const flag = eq >= 0 ? a.slice(0, eq) : a;
    const val = (): string => {
      const v = eq >= 0 ? a.slice(eq + 1) : argv[++i];
      if (v === undefined) {
        process.stderr.write(`${GEN_PATH}: ${flag} 缺值\n`);
        process.exit(2);
      }
      return v;
    };
    if (flag === "-check" || flag === "--check") {
      if (eq >= 0) {
        process.stderr.write(`${GEN_PATH}: 布尔 flag ${flag} 不接受值\n`);
        return 2;
      }
      checkMode = true;
    } else if (flag === "-selftest" || flag === "--selftest") {
      if (eq >= 0) {
        process.stderr.write(`${GEN_PATH}: 布尔 flag ${flag} 不接受值\n`);
        return 2;
      }
      selftestMode = true;
    } else if (flag === "-src" || flag === "--src") src = val();
    else if (flag === "-mbt-out" || flag === "--mbt-out") out = val();
    else if (flag === "-golden-out" || flag === "--golden-out") goldenOut = val();
    else {
      process.stderr.write(`${GEN_PATH}: 未知参数 ${JSON.stringify(a)}\n`);
      return 2;
    }
  }
  const root = projectRoot();
  const absSrc = path.isAbsolute(src) ? src : path.join(root, src);
  const absOut = path.isAbsolute(out) ? out : path.join(root, out);
  const absGolden = path.isAbsolute(goldenOut)
    ? goldenOut
    : path.join(root, goldenOut);
  const doc = load(absSrc);
  const digest = digestOf(absSrc);
  if (selftestMode) {
    selftest(doc, digest, out, goldenOut);
    return 0;
  }
  if (checkMode) {
    check(doc, digest, out, goldenOut);
    return 0;
  }
  try {
    fs.writeFileSync(absOut, render(doc, digest));
    fs.writeFileSync(absGolden, renderGolden(doc, digest));
  } catch (e) {
    die(`写产物失败 ${out}: ${e instanceof Error ? e.message : String(e)}`);
  }
  process.stdout.write(
    `${GEN_PATH}: 已生成 ${out} + ${goldenOut}（${doc.themeOrder.length} 主题 / ${Object.keys(doc.sizes).length} 字号档）\n`,
  );
  return 0;
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  process.exit(main(process.argv.slice(2)));
}
