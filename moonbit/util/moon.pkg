// L0 零依赖·纯机械助手（G-1，2026-09-26）：utf8_len / str_cmp /
// i64_to_i32_bits / le_u32_at / le_u64_at / json_escape(_into) /
// json_parse——只许零语义
// 机械件（无业务判定、无状态、无副作用），任何层都可依赖而不引入语义耦合。
// 收口动因：消「@utf8.encode(s).length() 散拼」（静默产空串事故同族）与
// 「String 比较非字典序」（陷阱 #29）两族跨包重复；json_escape 六份收一
// （issue #55，2026-10-09——ast/diag/gateway/cmd 族本地转义副本全撤）。
// json_parse 自 gateway 上提（升序裁定履行，main.js 退役批 2026-10-16
// ——第二个消费者 cmd/vitro_wasm 的 invoke_parsed 组合）。
// 分层登记：scripts/moonbit/pkg_deps rules.json（L0，总计划 §4）。
import {
  "moonbitlang/core/encoding/utf8",
}

// quickcheck 属性批（QC 批，2026-11-04）：moon prove 盲区（String/浮点/
// 组合语义）的采样级互补防线——仅测试构建可见，不进包依赖面（pkg_deps
// L0 边表与 surface 边表均不受影响）。core 自带，moon.mod 零新增依赖。
import {
  "moonbitlang/core/quickcheck",
  "moonbitlang/core/quickcheck/splitmix",
  "moonbitlang/core/quickcheck/shrink",
  "moonbitlang/core/debug",
} for "test"
