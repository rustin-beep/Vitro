// rust_narrative_check 单测 + J9 证红（审阅 v2 批 A7'；PR #431 审阅处置扩面 R1b/R4/文件头 tag/@generated 扫入）。
import { test } from "node:test";
import assert from "node:assert/strict";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import {
  commentStart,
  fileHeadHasTag,
  isGenerated,
  loadRules,
  narrativeLines,
  scanFile,
  scanRepo,
  type Exemption,
  type Rules,
} from "./main.mts";
import { projectRoot } from "../internal/capi.mts";

const SELF_DIR = import.meta.dirname;
const RULES: Rules = loadRules(SELF_DIR);
const HEAD = "// 蓝本注记：tag rust-oracle-freeze 档案态。\n";

test("规则表：五规则齐、正则可编译、精确 tag 三件（泛词「冻结区」已退出）", () => {
  assert.deepEqual(
    RULES.rules.map((r) => r.id),
    ["R1", "R1b", "R2", "R3", "R4"],
  );
  for (const r of RULES.rules) new RegExp(r.pattern);
  assert.deepEqual(RULES.tag_markers, ["rust-oracle-freeze", "frozen-oracle-snapshot", "917251e"]);
  assert.ok(RULES.window >= 1 && RULES.file_head_lines >= 1);
  assert.equal(RULES.rules.find((r) => r.id === "R1b")?.file_head_tag_exempt, true);
  assert.equal(RULES.rules.find((r) => r.id === "R4")?.file_head_tag_exempt, true);
  assert.equal(RULES.rules.find((r) => r.id === "R1")?.file_head_tag_exempt, false);
});

test("commentStart：裸代码 -1 / 行首注释 / 尾注释 / 字符串内 // 不算 / 多行字符串行不算", () => {
  assert.equal(commentStart("let x = 1"), -1);
  assert.equal(commentStart("// 注释"), 0);
  assert.equal(commentStart("  /// doc"), 2);
  assert.equal(commentStart("let x = 1 // 尾注"), 10);
  assert.equal(commentStart('let u = "http://native/src/x.rs"'), -1);
  assert.equal(commentStart('let u = "a\\"//b" // real'), 17);
  assert.equal(commentStart("  #| native/src/foo.rs 照搬不修"), -1);
  assert.equal(commentStart("  $| 与 Rust 一致"), -1);
  assert.equal(commentStart("let c = '/' // x"), 12);
});

test("narrativeLines：.mbt 只取注释段，.mbt.md 整行", () => {
  const mbt = narrativeLines("a.mbt", 'let s = "native/src/a.rs"\n// native/src/b.rs\n');
  assert.deepEqual(mbt, ["", "// native/src/b.rs", ""]);
  const md = narrativeLines("README.mbt.md", "照搬 native/src/c.rs\n");
  assert.deepEqual(md, ["照搬 native/src/c.rs", ""]);
});

test("isGenerated / fileHeadHasTag：首 N 行判定", () => {
  assert.equal(isGenerated("// @generated by x\nfn f() {}", "@generated", 5), true);
  assert.equal(isGenerated("fn f() {}\n// @generated", "@generated", 1), false);
  assert.equal(fileHeadHasTag(narrativeLines("a.mbt", HEAD + "fn f() {}"), RULES), true);
  const deep = Array(RULES.file_head_lines).fill("//").join("\n") + "\n// tag rust-oracle-freeze";
  assert.equal(fileHeadHasTag(narrativeLines("a.mbt", deep), RULES), false, "超出 file_head_lines 不算头");
});

test("R1：死路径裸引红；窗口内 tag 过闸；文件头 tag 不豁免 R1（硬死路径须就地补锚）；字符串不算", () => {
  const red = scanFile("m/a.mbt", "// 照搬源：native/src/session_api.rs\nfn f() {}\n", RULES);
  assert.deepEqual(
    red.map((h) => h.rule),
    ["R1", "R1b"],
    "同一行同时命中 R1（native/ 前缀）与 R1b（.rs 文件名）",
  );
  const ok = scanFile("m/a.mbt", "// 历史蓝本（tag rust-oracle-freeze 可回溯）：\n// native/src/session_api.rs\n", RULES);
  assert.equal(ok.length, 0);
  const headOnly = scanFile("m/a.mbt", HEAD + Array(10).fill("//").join("\n") + "\n// 照搬源：native/src/x.rs\n", RULES);
  assert.deepEqual(headOnly.map((h) => h.rule), ["R1"], "文件头 tag 只豁免 R1b，R1 仍红");
  const crate = scanFile("m/a.mbt", "/// 照搬 Rust `vitro_codegen/src/lib.rs:136`\n", RULES);
  assert.deepEqual(crate.map((h) => h.rule).sort(), ["R1", "R1b", "R4"]);
  assert.equal(scanFile("m/a.mbt", 'let p = "native/src/x.rs"\n', RULES).length, 0);
});

test("R1b：裸 .rs 行号引用红；文件头 tag 整文件过闸；真文件 snapshot.rs 不算", () => {
  const body = Array(10).fill("//").join("\n") + "\n/// 语义照搬 `host/memory.rs:229-232` 明文\n";
  const red = scanFile("m/b.mbt", body, RULES);
  assert.deepEqual(red.map((h) => h.rule), ["R1b"]);
  assert.equal(scanFile("m/b.mbt", HEAD + body, RULES).length, 0, "文件头一次声明即整文件过闸");
  assert.equal(scanFile("m/b.mbt", "// 源 host_func_id.snapshot.rs 快照件\n", RULES).length, 0);
  assert.equal(scanFile("m/b.mbt", "// Rust `expr/assign.rs:11`\n", RULES).length, 1, "无 native/ 前缀也须命中");
});

test("R2：照搬不修活体红；销案留痕词或 tag 过闸；文件头 tag 不豁免 R2", () => {
  const red = scanFile("m/c.mbt", "/// 坑 17，照搬不修：xxx\n", RULES);
  assert.deepEqual(red.map((h) => h.rule), ["R2"]);
  assert.equal(scanFile("m/c.mbt", "/// 旧形态系 oracle 照搬在案（已修，销案）\n", RULES).length, 0);
  assert.equal(scanFile("m/c.mbt", "/// oracle 同病（tag rust-oracle-freeze）\n", RULES).length, 0);
  const headOnly = scanFile("m/c.mbt", HEAD + Array(10).fill("//").join("\n") + "\n/// 照搬不修\n", RULES);
  assert.deepEqual(headOnly.map((h) => h.rule), ["R2"]);
});

test("R3：紧邻与非紧邻形态均红；历史/旧/蓝本/语言/迁移期 限定词过闸；「冻结区」不再是 tag", () => {
  assert.deepEqual(scanFile("m/d.mbt", "// 确定性顺序（与 Rust 侧 sort 对齐）\n", RULES).map((h) => h.rule), ["R3"]);
  assert.deepEqual(scanFile("m/d.mbt", "/// union 复用本结构——Rust 侧同构\n", RULES).map((h) => h.rule), ["R3"]);
  assert.deepEqual(scanFile("m/d.mbt", "// 与 Rust serde 形态同构\n", RULES).map((h) => h.rule), ["R3"], "审阅 P2-1 探针：非紧邻 12 字内");
  assert.deepEqual(scanFile("m/d.mbt", "// Rust kind() 同构\n", RULES).map((h) => h.rule), ["R3"]);
  assert.equal(scanFile("m/d.mbt", "// 历史蓝本同形（与 Rust 一致的旧口径）\n", RULES).length, 0);
  assert.equal(scanFile("m/d.mbt", "/// 饱和语义，与 Rust 语言 `as i32` 转换一致\n", RULES).length, 0, "对 Rust 语言语义的活引用");
  assert.equal(scanFile("m/d.mbt", "// 迁移期与 Rust oracle 逐字节对拍锁定\n", RULES).length, 0);
  assert.equal(scanFile("m/d.mbt", "// 冻结区禁改（与档案无关）\n// 与 Rust 完全一致\n", RULES).length, 1, "审阅 P3-1 探针：泛词「冻结区」不得过闸");
});

test("R4：「照搬 Rust X」符号级来源红；文件头 tag 整文件过闸", () => {
  const body = Array(10).fill("//").join("\n") + "\n/// 二元运算符（19 个，照搬 Rust BinaryOp）。\n";
  assert.deepEqual(scanFile("m/e.mbt", body, RULES).map((h) => h.rule), ["R4"]);
  assert.equal(scanFile("m/e.mbt", HEAD + body, RULES).length, 0);
});

test("窗口：tag 在命中行之后 window 行内同样过闸；超窗不过", () => {
  const w = RULES.window;
  const pad = Array(20).fill("//").join("\n") + "\n"; // 推出文件头范围
  const near = pad + ["// native/src/a.rs", ...Array(w - 1).fill("//"), "// tag rust-oracle-freeze"].join("\n");
  assert.equal(scanFile("m/f.mbt", near, RULES).length, 0);
  const far = pad + ["// native/src/a.rs", ...Array(w).fill("//"), "// tag rust-oracle-freeze"].join("\n");
  assert.deepEqual(scanFile("m/f.mbt", far, RULES).map((h) => h.rule).sort(), ["R1", "R1b"]);
});

test("J9：临时迷你仓五规则各埋一雷必红；@generated 文件照扫并标记；例外精确匹配过闸；陈旧例外判僵尸", () => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "vitro-rustnarr-"));
  fs.mkdirSync(path.join(dir, "moonbit", "pkg"), { recursive: true });
  fs.mkdirSync(path.join(dir, "moonbit", "_build"), { recursive: true });
  const pad = Array(16).fill("// pad").join("\n") + "\n";
  fs.writeFileSync(
    path.join(dir, "moonbit", "pkg", "x.mbt"),
    pad +
      [
        "// 照搬源：native/src/foo.rs", // R1 + R1b
        "fn a() {}",
        "/// 坑 99（照搬不修）", // R2
        "fn b() {}",
        "// 与 Rust 一致", // R3
        "fn c() {}",
        "/// 照搬 Rust Foo", // R4
        "fn d() {}",
        "",
      ].join("\n"),
  );
  fs.writeFileSync(path.join(dir, "moonbit", "_build", "y.mbt"), "// native/src/zzz.rs\n");
  fs.writeFileSync(path.join(dir, "moonbit", "pkg", "g_gen.mbt"), "// @generated\n" + pad + "// 与 Rust 逐字一致\n");

  const r0 = scanRepo(dir, RULES, []);
  assert.equal(r0.generatedScanned, 1);
  const live0 = r0.hits.filter((h) => !h.exempted);
  assert.deepEqual(
    live0.map((h) => [h.rule, h.file.endsWith("g_gen.mbt") ? "gen" : h.line - 16, h.generated]),
    [
      ["R3", "gen", true], // 文件按名排序：g_gen.mbt 先于 x.mbt
      ["R1", 1, false],
      ["R1b", 1, false],
      ["R2", 3, false],
      ["R3", 5, false],
      ["R4", 7, false],
    ],
  );
  assert.equal(r0.zombies.length, 0);

  const ex: Exemption[] = live0.map((h) => ({ file: h.file, rule: h.rule, line_text: h.text, reason: "J9 测试过闸" }));
  const r1 = scanRepo(dir, RULES, ex);
  assert.equal(r1.hits.filter((h) => !h.exempted).length, 0);
  assert.equal(r1.hits.filter((h) => h.exempted).length, 6);
  assert.equal(r1.zombies.length, 0);

  const stale: Exemption[] = [{ file: "moonbit/pkg/x.mbt", rule: "R1", line_text: "// 不存在的行", reason: "陈旧" }];
  const r2 = scanRepo(dir, RULES, stale);
  assert.equal(r2.zombies.length, 1);
  assert.equal(r2.hits.filter((h) => !h.exempted).length, 6);

  // 文件头一次声明：R1b/R4 整文件过闸，R1/R2/R3 仍红
  fs.writeFileSync(path.join(dir, "moonbit", "pkg", "x.mbt"), HEAD + fs.readFileSync(path.join(dir, "moonbit", "pkg", "x.mbt"), "utf8"));
  const r3 = scanRepo(dir, RULES, []);
  assert.deepEqual(
    r3.hits.filter((h) => !h.exempted && !h.generated).map((h) => h.rule),
    ["R1", "R2", "R3"],
  );
});

test("真实仓库：清注后闸绿（与 CI 同门径，零活命中零僵尸，@generated 全扫入）", () => {
  const r = spawnSync(process.execPath, [path.join(SELF_DIR, "main.mts"), "-check"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 0, r.stdout + r.stderr);
  assert.match(r.stdout, /rust_narrative_check: PASS——扫描 \d+ 文件（@generated 扫入 \d+）\/ 活命中 0 \//);
});

test("--json 出口：只出 JSON、结构字段齐", () => {
  const r = spawnSync(process.execPath, [path.join(SELF_DIR, "main.mts"), "--json"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 0, r.stderr);
  const o = JSON.parse(r.stdout) as { files: number; generated_scanned: number; live: unknown[]; exempted: number; zombies: unknown[] };
  assert.ok(o.files > 0 && o.generated_scanned > 0);
  assert.equal(o.live.length, 0);
  assert.equal(o.zombies.length, 0);
});

test("参数面：未知参数 rc=2", () => {
  const r = spawnSync(process.execPath, [path.join(SELF_DIR, "main.mts"), "--bogus"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 2);
});
