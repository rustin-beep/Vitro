#!/bin/sh
# vitro 统一入口 launcher（sh 形态，#49 批一）——默认 wasm 壳，node 缺失或
# 版本不足（壳 exit 3 哨兵）降级 native exe；`--backend native|wasm` 显式
# 选边（排查用）。降级必 stderr 明示（禁静默——两臂行为偶有微差时排查
# 不精神分裂）。
REPO="$(cd "$(dirname "$0")/../.." && pwd)"
WASM_SHELL="$REPO/scripts/vitro_cli/main.js"
NATIVE_EXE="$REPO/moonbit/_build/native/release/build/cmd/vitro/vitro.exe"

run_native() {
  reason="$1"
  shift
  # 新鲜度门禁（2026-10-06 审阅 P2-3——vm_diff/clang_direct 同款）：
  # native exe 不随源码自动重建，陈旧制品会对着旧代码下结论。检测
  # cmd/ 与 host/ 源 mtime 晚于 exe 时 stderr 大字警告（不阻断——构建
  # 需 MOON_CC=clang 且分钟级，降级场景常在探针中途）
  if [ -f "$NATIVE_EXE" ]; then
    exe_mtime=$(cd "$(dirname "$NATIVE_EXE")" && ls -l --time-style=+%s "$(basename "$NATIVE_EXE")" 2>/dev/null | awk '{print $6}')
    if [ -n "$exe_mtime" ]; then
      # 陈旧检测面 = moonbit/ 全部 .mbt（#57-2：原七目录枚举漏 gateway/
      # time_travel/teaching/protocol/session/memory/diag/ast/util 九包——
      # #35 排障时改 serve_step/engine 零告警连环假阴性；剪枝 _build 与
      # .mooncakes，新包零维护自动入面）
      newer_src=$(find "$REPO/moonbit" -type d \( -name '_build' -o -name '.mooncakes' \) -prune -o -type f -name '*.mbt' -newermt "@$exe_mtime" -print 2>/dev/null | head -1)
      if [ -n "$newer_src" ]; then
        echo "[vitro] ⚠ native exe 陈旧（源已改：${newer_src##*/} 等）——结论可能来自旧代码；重建：cd moonbit && MOON_CC=clang moon build --release --target native cmd/vitro" >&2
      fi
    fi
  fi
  echo "[vitro] backend=native（$reason）" >&2
  exec "$NATIVE_EXE" "$@"
}

# --backend 覆盖（首参位；剥掉后透传）
if [ "$1" = "--backend" ] && [ -n "$2" ]; then
  if [ "$2" = "native" ]; then
    shift 2
    run_native "--backend 显式指定" "$@"
  elif [ "$2" = "wasm" ]; then
    shift 2
  fi
fi

if [ ! -f "$WASM_SHELL" ]; then
  run_native "wasm 壳不存在（scripts/vitro_cli/main.js）" "$@"
fi

NODE_BIN="$(command -v node 2>/dev/null)"
if [ -z "$NODE_BIN" ]; then
  run_native "node 不在 PATH" "$@"
fi

"$NODE_BIN" "$WASM_SHELL" "$@"
rc=$?
if [ $rc -eq 3 ]; then
  run_native "node 版本不足（壳 rc=3）" "$@"
fi
exit $rc
