// gen_protocol_fields.test.mts —— 基线校验 / 三表互斥 / 渲染形态 + 真实 -check。
import { test } from "node:test";
import assert from "node:assert/strict";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { spawnSync } from "node:child_process";
import { loadBaselines, render, validateFields } from "./main.mts";
import type { Baselines, FieldsFile } from "./main.mts";
import { projectRoot } from "../../internal/capi.mts";

const BASE: Baselines = {
  expected_schema: "v0.1",
  expected_v01_fields: 3,
  expected_reserved: 2,
  expected_v02_fields: 1,
};

function fields(over: Partial<FieldsFile> = {}): FieldsFile {
  return {
    schema: "v0.1",
    v01_payload_fields: ["a", "b", "c"],
    reserved_fields: ["r1", "r2"],
    v02_payload_fields: ["v2"],
    ...over,
  };
}

test("loadBaselines：合法通过；缺字段/坏 JSON 抛错", () => {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "vitro-gpf-"));
  const p = path.join(dir, "b.json");
  fs.writeFileSync(p, JSON.stringify(BASE));
  assert.deepEqual(loadBaselines(p), BASE);
  fs.writeFileSync(p, "{}");
  assert.throws(() => loadBaselines(p), /字段缺失\/非法/);
  fs.writeFileSync(p, "{bad");
  assert.throws(() => loadBaselines(p), /基线 JSON 非法/);
});

test("validateFields：schema/计数/三表互斥 逐项 fail loud", () => {
  assert.doesNotThrow(() => validateFields(fields(), BASE));
  assert.throws(() => validateFields(fields({ schema: "v0.2" }), BASE), /版本轨道变更/);
  assert.throws(() => validateFields(fields({ v01_payload_fields: ["a"] }), BASE), /v01_payload_fields 数/);
  assert.throws(() => validateFields(fields({ reserved_fields: [] }), BASE), /reserved_fields 数/);
  assert.throws(() => validateFields(fields({ v02_payload_fields: [] }), BASE), /v02_payload_fields 数/);
  assert.throws(
    () => validateFields(fields({ reserved_fields: ["a", "r2"] }), BASE),
    /在 v0\.1 冻结表\/预留位\/v0\.2 激活表间重复/
  );
});

test("render：v0.1 每行 4 项缩进；预留位/激活表单行；源 hash 落款", () => {
  const f = fields({ v01_payload_fields: ["a", "b", "c", "d", "e"] });
  const out = render(f, "deadbeef");
  assert.match(out, /sha256\/deadbeef/);
  assert.match(out, /\n    "a", "b", "c", "d",\n    "e",\n/);
  assert.match(out, /pub fn reserved_fields_v0_2\(\) -> Array\[String\] \{\n  \["r1","r2"\]\n\}/);
  assert.match(out, /pub fn step_payload_fields_v0_2\(\) -> Array\[String\] \{\n  \["v2"\]\n\}/);
  assert.match(out, /@generated by scripts\/moonbit\/gen_protocol_fields/);
});

test("真实仓库：-check 通过（与 CI 同门径）", () => {
  const r = spawnSync(process.execPath, [path.join(import.meta.dirname, "main.mts"), "-check"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 0, r.stderr);
  assert.match(r.stdout, /gen_protocol_fields: check OK/);
});
