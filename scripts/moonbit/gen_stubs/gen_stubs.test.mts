// gen_stubs.test.mts —— headers() 解析 / 双向对账 / 转义 / 产物确定性 + 真实 -check。
import { test } from "node:test";
import assert from "node:assert/strict";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import crypto from "node:crypto";
import { spawnSync } from "node:child_process";
import { buildOutput, crossCheckDir, loadHeaderNamesFrom, moonEscape } from "./main.mts";
import { projectRoot } from "../../internal/capi.mts";

function fixture(names: string[], files: Record<string, string>): string {
  const root = fs.mkdtempSync(path.join(os.tmpdir(), "vitro-stubs-"));
  fs.mkdirSync(path.join(root, "moonbit/stdlib"), { recursive: true });
  fs.mkdirSync(path.join(root, "scripts/moonbit/libc_src/include"), { recursive: true });
  const stdlib = ["pub fn headers() -> Array[String] {", "  [" + names.map((n) => `"${n}"`).join(", ") + "]", "}"].join("\n");
  fs.writeFileSync(path.join(root, "moonbit/stdlib/stdlib.mbt"), stdlib);
  for (const [n, body] of Object.entries(files)) {
    fs.writeFileSync(path.join(root, "scripts/moonbit/libc_src/include", n), body);
  }
  return root;
}

test("headers() 解析：锚定签名后的数组体；缺失/空/非 .h 抛错", () => {
  assert.deepEqual(loadHeaderNamesFrom('pub fn headers() -> Array[String] {\n  ["a.h", "b.h"]\n}'), ["a.h", "b.h"]);
  assert.throws(() => loadHeaderNamesFrom("pub fn other() -> Unit"), /缺少 pub fn headers/);
  assert.throws(() => loadHeaderNamesFrom("pub fn headers() -> Array[String] {\n []\n}"), /名单为空/);
  assert.throws(() => loadHeaderNamesFrom('pub fn headers() -> Array[String] {\n ["x.c"]\n}'), /非 \.h/);
});

test("moonEscape：反斜杠/引号/换行/制表转义；控制字符抛错", () => {
  assert.equal(moonEscape('a\\b"c\nd\te\r'), 'a\\\\b\\"c\\nd\\te\\r');
  assert.equal(moonEscape("中文 em—dash"), "中文 em—dash");
  assert.throws(() => moonEscape("\u0001"), /控制字符/);
});

test("crossCheckDir：名单与目录双向集合对账", () => {
  const root = fixture(["a.h"], { "a.h": "// a\n" });
  assert.doesNotThrow(() => crossCheckDir(root, ["a.h"]));
  assert.throws(() => crossCheckDir(root, ["a.h", "b.h"]), /登记 b\.h 在目录中不存在/);
  fs.writeFileSync(path.join(root, "scripts/moonbit/libc_src/include/c.h"), "// c\n");
  assert.throws(() => crossCheckDir(root, ["a.h"]), /目录存在未登记头 c\.h/);
});

test("buildOutput：sha256 覆盖归一源内容；臂序 = 名单序；确定性", () => {
  const root = fixture(["b.h", "a.h"], { "a.h": "// a\r\n", "b.h": "// b\n" });
  const built = buildOutput(root, ["b.h", "a.h"]);
  const expected = crypto
    .createHash("sha256")
    .update(Buffer.concat([Buffer.from("// b\n"), Buffer.from("// a\n")]))
    .digest("hex");
  assert.equal(built.sha256, expected);
  assert.ok(built.text.indexOf('"b.h"') < built.text.indexOf('"a.h"'));
  assert.match(built.text, /@generated by scripts\/moonbit\/gen_stubs/);
  assert.equal(buildOutput(root, ["b.h", "a.h"]).text, built.text);
});

test("真实仓库：-check 通过（含 moon fmt 幂等）", () => {
  const r = spawnSync(process.execPath, [path.join(import.meta.dirname, "main.mts"), "-check"], {
    cwd: projectRoot(),
    encoding: "utf8",
  });
  assert.equal(r.status, 0, r.stderr);
  assert.match(r.stdout, /gen_stubs: check OK/);
});
