#!/usr/bin/env node
// gen_libc_data：Bytecode Libc 产物 → MoonBit 数据字面量生成器（#273 存量 Go 重写批）。
//
// 源 = scripts/moonbit/libc_data/bytecode_libc_data.json（#39 唯一真源）；
// 产物 = moonbit/vm/libc_data_gen.mbt（禁手改，头部源 sha256 落款）。
// 过渡对账臂：冻结区旧份存在期间行尾归一 sha 必须一致（删区后自动豁免）。
// 流程内置 moon fmt；-check 用「临时产物同流程 fmt 后比对」，并对 fmt 的
// 无关文件副作用做快照/还原（零工作区副作用）。
//
//   node scripts/moonbit/gen_libc_data/main.mts [-check]
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { spawnSync } from "node:child_process";
import { pathToFileURL } from "node:url";
import { projectRoot } from "../../internal/capi.mts";

interface Instr {
  op: string;
  operand: number;
  loc: { line: number; column: number; file_id: number };
}
interface FuncMeta {
  ip: number;
  arg_count: number;
  param_count: number;
  local_count: number;
  param_sizes: number[];
  is_variadic: boolean;
}
export interface Artifact {
  code: Instr[];
  code_len: number;
  func_table: Record<string, FuncMeta>;
  func_index: Record<string, number>;
  globals_init_32: Array<[number, number]>;
  globals_init_64: Array<[number, number]>;
  f64_constants: number[];
  i64_constants: number[];
  string_data: unknown[];
}

const norm = (b: Buffer | string): string =>
  (typeof b === "string" ? b : b.toString("utf8")).replace(/\r\n/g, "\n");

function fatal(msg: string): never {
  process.stderr.write("gen_libc_data: " + msg + "\n");
  process.exit(1);
}

function safeInt(v: number, what: string): number {
  if (!Number.isSafeInteger(v)) {
    throw new Error(`${what} 超出 JS 安全整数（${v}）——须先接无损 JSON 解析器再生成`);
  }
  return v;
}

// goFormatFloat 对齐 Go fmt %v（strconv.FormatFloat 'g', -1）：最短往返数字；
// shortest 形态的指数阈值固定为 6（Go ftoa.go：eprec=6），即 exp < -4 或
// exp >= 6 用指数形态（指数两位补零、正号显式）。
export function goFormatFloat(n: number): string {
  if (Object.is(n, -0)) return "-0";
  if (n === 0) return "0";
  const sign = n < 0 ? "-" : "";
  const [mant, expStr] = n.toExponential().slice(sign.length).split("e");
  const digits = (mant ?? "").replace(".", "");
  const exp = Number.parseInt(expStr ?? "0", 10);
  let body: string;
  if (exp < -4 || exp >= 6) {
    const m = digits.length > 1 ? `${digits[0]}.${digits.slice(1)}` : `${digits[0]}`;
    body = `${m}e${exp >= 0 ? "+" : "-"}${String(Math.abs(exp)).padStart(2, "0")}`;
  } else if (exp >= 0) {
    body =
      digits.length <= exp + 1
        ? digits + "0".repeat(exp + 1 - digits.length)
        : `${digits.slice(0, exp + 1)}.${digits.slice(exp + 1)}`;
  } else {
    body = "0." + "0".repeat(-exp - 1) + digits;
  }
  return sign + body;
}

// parseOpNumbers：只扫 OpCode::code 的 match 体（窗口约束），重名臂 fail loud，
// 少于 100 臂视为窗口判定可疑。
export function parseOpNumbers(text: string): Map<string, number> {
  const lines = text.split("\n");
  const start = lines.findIndex((l) => l.includes("pub fn OpCode::code"));
  if (start < 0) throw new Error("opcode.mbt 中未找到 pub fn OpCode::code");
  const ops = new Map<string, number>();
  for (let i = start; i < lines.length; i++) {
    const raw = lines[i] ?? "";
    if (i > start && raw === "}") break;
    const m = /^(\S+)\s*=>\s*(\d+)$/.exec(raw.trim());
    if (!m) continue;
    const name = m[1] ?? "";
    const n = Number.parseInt(m[2] ?? "", 10);
    const prev = ops.get(name);
    if (prev !== undefined) throw new Error(`code() 体内重名臂 ${name}（${prev} 与 ${n}）`);
    ops.set(name, n);
  }
  if (ops.size < 100) throw new Error(`code() 体内仅抽到 ${ops.size} 臂（<100，窗口判定可疑）`);
  return ops;
}

export function renderArtifact(art: Artifact, srcSha: string, ops: Map<string, number>): string {
  const b: string[] = [];
  const w = (s: string): void => {
    b.push(s);
  };
  w("// @generated by scripts/moonbit/gen_libc_data —— 禁手改（git/diff 工具链按 @generated 识别；源 sha256 落款见下）。");
  w("// 源：scripts/moonbit/libc_data/bytecode_libc_data.json（#39 迁出冻结区；Rust 旧份 include_str! 过渡对账至删区）");
  w(`// source_sha256=${srcSha}`);
  w("// 生成命令：go run ./scripts/moonbit/gen_libc_data（流程内置 moon fmt）");
  w("");

  w("///| 扁平指令流（每指令 5 元：opcode/operand/line/column/file_id——");
  w("///| 运行时 libc_setup.mbt 组装为 Instruction）。");
  w("let libc_code_flat : Array[Int] = [");
  art.code.forEach((instr, i) => {
    if (i % 10 === 0) w(`  // ${i}`);
    const op = ops.get(instr.op);
    if (op === undefined) throw new Error(`未知 opcode ${JSON.stringify(instr.op)}（opcode.mbt 无此名）`);
    w(`  ${op}, ${safeInt(instr.operand, "operand")}, ${safeInt(instr.loc.line, "line")}, ${safeInt(instr.loc.column, "column")}, ${safeInt(instr.loc.file_id, "file_id")},`);
  });
  w("]");
  w("");

  w("///| 函数表（name → meta；固定索引在 LIBC_FUNC_INDEX 中）。");
  const names = Object.keys(art.func_index).sort((a, c) => (art.func_index[a] ?? 0) - (art.func_index[c] ?? 0));
  w("let libc_func_names : Array[String] = [");
  for (const n of names) w(`  ${JSON.stringify(n)},`);
  w("]");
  w("");
  w("let libc_func_index : Array[Int] = [");
  for (const n of names) w(`  ${safeInt(art.func_index[n] ?? 0, `func_index[${n}]`)},`);
  w("]");
  w("");

  w("///| 每函数 meta 扁平（ip/arg_count/param_count/local_count/variadic + param_sizes 至 local_count 槽）。");
  w("let libc_func_meta : Array[Int] = [");
  for (const n of names) {
    const m = art.func_table[n];
    if (!m) throw new Error(`func_index 含 ${n} 但 func_table 缺失`);
    const v = m.is_variadic ? 1 : 0;
    w(
      `  ${safeInt(m.ip, "ip")}, ${safeInt(m.arg_count, "arg_count")}, ${safeInt(m.param_count, "param_count")}, ${safeInt(m.local_count, "local_count")}, ${v}, ${m.param_sizes.length}, // ${n}`
    );
    for (const ps of m.param_sizes) w(`  ${safeInt(ps, "param_size")},`);
  }
  w("]");
  w("");

  w("let libc_globals_32 : Array[(UInt, Int)] = [");
  for (const g of art.globals_init_32) w(`  (${safeInt(g[0], "global32 addr")}U, ${safeInt(g[1], "global32 value")}),`);
  w("]");
  w("");
  w("let libc_globals_64 : Array[(UInt, UInt64)] = [");
  for (const g of art.globals_init_64) w(`  (${safeInt(g[0], "global64 addr")}U, ${safeInt(g[1], "global64 value")}UL),`);
  w("]");
  w("");
  w("let libc_f64_constants : Array[Double] = [");
  for (const c of art.f64_constants) w(`  ${goFormatFloat(c)},`);
  w("]");
  w("");
  w("let libc_i64_constants : Array[Int64] = [");
  for (const c of art.i64_constants) w(`  ${safeInt(c, "i64 constant")}L,`);
  w("]");
  w("");
  w(`const LIBC_CODE_LEN : Int = ${safeInt(art.code_len, "code_len")}`);
  return b.join("\n") + "\n";
}

// moon fmt 作用于整模块：check 路径 fmt 前快照全部 .mbt（排除 keep），fmt 后
// 还原被重排的无关文件——保证 -check 零工作区副作用。
function snapshotMbts(moonbit: string, keep: string[]): Map<string, Buffer> {
  const keepAbs = new Set(keep.map((k) => path.join(moonbit, k)));
  const snap = new Map<string, Buffer>();
  const walk = (dir: string, rel: string): void => {
    let entries: fs.Dirent[];
    try {
      entries = fs.readdirSync(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const e of entries) {
      const p = path.join(dir, e.name);
      const r = path.join(rel, e.name);
      if (e.isDirectory()) {
        if (e.name === "_build" || e.name === "target") continue;
        walk(p, r);
        continue;
      }
      if (!e.name.endsWith(".mbt") || keepAbs.has(p)) continue;
      try {
        snap.set(p, fs.readFileSync(p));
      } catch {
        // 读失败跳过（与 WalkDir 出错一致）
      }
    }
  };
  walk(moonbit, "");
  return snap;
}

function restoreMbts(snap: Map<string, Buffer>): void {
  for (const [p, content] of snap) {
    let cur: Buffer | null = null;
    try {
      cur = fs.readFileSync(p);
    } catch {
      cur = null;
    }
    if (cur === null || !cur.equals(content)) fs.writeFileSync(p, content);
  }
}

function runMoonFmt(moonbit: string, keep: string[]): void {
  const snap = keep.length > 0 ? snapshotMbts(moonbit, keep) : null;
  const args = keep.length > 0 ? ["fmt", ...keep] : ["fmt"];
  const r = spawnSync("moon", args, { cwd: moonbit, encoding: "utf8" });
  if (r.status !== 0) throw new Error(`moon fmt: exit ${r.status}: ${(r.stdout ?? "") + (r.stderr ?? "")}`);
  if (snap) restoreMbts(snap);
}

const invokedDirectly =
  process.argv[1] !== undefined && pathToFileURL(path.resolve(process.argv[1])).href === import.meta.url;
if (invokedDirectly) {
  const check = process.argv.slice(2).includes("-check") || process.argv.slice(2).includes("--check");
  for (const a of process.argv.slice(2)) {
    if (a !== "-check" && a !== "--check") {
      process.stderr.write(`gen_libc_data: 未知参数 ${a}\n`);
      process.exit(2);
    }
  }
  const root = projectRoot();
  const moonbit = path.join(root, "moonbit");
  const srcPath = path.join(root, "scripts/moonbit/libc_data/bytecode_libc_data.json");
  const outPath = path.join(moonbit, "vm/libc_data_gen.mbt");
  const tmpRel = "vm/libc_data_gen_check_tmp.mbt";
  const tmpPath = path.join(moonbit, tmpRel);

  let raw: Buffer;
  try {
    raw = fs.readFileSync(srcPath);
  } catch (e) {
    fatal(`读源 ${srcPath}: ${e instanceof Error ? e.message : String(e)}`);
  }
  const srcNorm = norm(raw);
  const srcSha = crypto.createHash("sha256").update(Buffer.from(srcNorm, "latin1")).digest("hex");

  // 过渡对账臂（#39）：旧份存在期间行尾归一 sha 必须一致；删区后自动豁免。
  const legacyPath = path.join(root, "native/crates/vitro_vm/src/bytecode_libc_data.json");
  if (fs.existsSync(legacyPath)) {
    const legacySha = crypto.createHash("sha256").update(Buffer.from(norm(fs.readFileSync(legacyPath)), "latin1")).digest("hex");
    if (legacySha !== srcSha) {
      process.stderr.write(`gen_libc_data: 过渡对账红——新旧源 sha256 不一致（迁移期双向漂移）:\n  新源 ${srcPath} ${srcSha}\n  旧源 ${legacyPath} ${legacySha}\n  处置：以真源侧为准同步另一份（旧份更新属防线维护），或确认变更意图后重跑\n`);
      process.exit(1);
    }
    console.log(`gen_libc_data: 过渡对账 OK（旧源 ${legacyPath} sha 一致，删区后自动豁免）`);
  } else {
    console.log("gen_libc_data: 旧源已删区（工序④），过渡对账臂豁免");
  }

  const art = JSON.parse(srcNorm) as Artifact;
  if (art.string_data.length > 0) {
    fatal(`string_data 非空（${art.string_data.length} 条）——MoonBit LibcArtifact 尚无该字段，先扩装载面再生成`);
  }

  let ops: Map<string, number>;
  let out: string;
  try {
    ops = parseOpNumbers(fs.readFileSync(path.join(moonbit, "opcode/opcode.mbt"), "utf8"));
    out = renderArtifact(art, srcSha, ops);
  } catch (e) {
    fatal(e instanceof Error ? e.message : String(e));
  }

  if (check) {
    let origCur: Buffer | null = null;
    try {
      origCur = fs.readFileSync(outPath);
    } catch {
      origCur = null;
    }
    try {
      fs.writeFileSync(tmpPath, out);
      runMoonFmt(moonbit, ["vm/libc_data_gen.mbt", tmpRel]);
      const cur = fs.readFileSync(outPath);
      const tmp = fs.readFileSync(tmpPath);
      fs.rmSync(tmpPath, { force: true });
      const drifted = origCur === null || norm(cur) !== norm(tmp);
      // 文件参数 fmt 与整包 fmt 形态不同：无论成败都还原 fmt 前原产物
      //（-check 零副作用；cur 已被 fmt 改写，不能拿它当还原基准）
      if (origCur !== null) fs.writeFileSync(outPath, origCur);
      if (drifted) {
        process.stderr.write("gen_libc_data: 产物漂移（源变或产物被篡改）——重跑生成\n");
        process.exit(1);
      }
      console.log("gen_libc_data: check OK（产物与源一致）");
    } catch (e) {
      fs.rmSync(tmpPath, { force: true });
      fatal(e instanceof Error ? e.message : String(e));
    }
    process.exitCode = 0;
  } else {
    try {
      fs.writeFileSync(outPath, out);
      runMoonFmt(moonbit, []);
    } catch (e) {
      fatal(e instanceof Error ? e.message : String(e));
    }
    console.log(`gen_libc_data: 写 ${path.relative(root, outPath)}（${art.code.length} 指令 / ${namesCount(art)} 函数）`);
  }
}

function namesCount(art: Artifact): number {
  return Object.keys(art.func_index).length;
}
